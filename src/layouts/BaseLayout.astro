---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { site, whatsappLink } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  rankMathSEO?: string;
}

const {
  title = 'Croilab — Ingeniería de conversiones digitales',
  description = 'Diseñamos sistemas digitales donde estrategia, tecnología y adquisición trabajan juntos para transformar tráfico en clientes.',
  lang = 'es',
  rankMathSEO,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const waLink = whatsappLink();

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  slogan: site.slogan,
  url: site.url,
  description: site.description,
  logo: `${site.url}/images/favicon-192x192.png`,
  email: site.email,
  contactPoint: {
    '@type': 'ContactPoint',
    email: site.email,
    contactType: 'sales',
    availableLanguage: 'es',
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {
      rankMathSEO ? (
        <Fragment set:html={rankMathSEO} />
      ) : (
        <>
          <meta name="description" content={description} />
          <link rel="canonical" href={canonicalURL.href} />
          <meta name="robots" content="index, follow" />

          <meta property="og:type" content="website" />
          <meta property="og:locale" content="es_ES" />
          <meta property="og:site_name" content="Croilab" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonicalURL.href} />
          <meta name="twitter:card" content="summary" />

          <title>{title}</title>
        </>
      )
    }
    <link rel="icon" type="image/png" href="/images/favicon-192x192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Barra fija de scroll: Agendar + WhatsApp -->
    <div id="scroll-bar" class="fixed bottom-0 left-0 right-0 z-50 translate-y-full transition-transform duration-500 md:hidden">
      <div class="bg-[#090909]/95 backdrop-blur-xl border-t border-white/10 px-4 py-3 flex items-center gap-3">
        <a
          href="/contacto"
          class="flex-1 flex items-center justify-center gap-2 rounded-xl bg-white px-4 py-3 text-[13px] font-semibold text-[#090909] transition hover:bg-white/90"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Agendar llamada
        </a>
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 flex items-center justify-center gap-2 rounded-xl bg-[#25D366] px-4 py-3 text-[13px] font-semibold text-white transition hover:bg-[#20ba5a]"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.85 9.85 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43-.14-.01-.31-.01-.48-.01-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>

    <!-- Barra fija de scroll: Agendar + WhatsApp (desktop) -->
    <div id="scroll-bar-desktop" class="fixed bottom-0 left-0 right-0 z-50 translate-y-full transition-transform duration-500 hidden md:block">
      <div class="mx-auto max-w-[1400px] px-6 lg:px-10 pb-6 pointer-events-none">
        <div class="mx-auto w-fit bg-[#090909]/95 backdrop-blur-xl rounded-2xl border border-white/10 px-2 py-2 flex items-center gap-2 shadow-[0_10px_40px_rgba(0,0,0,0.3)] pointer-events-auto">
          <a
            href="/contacto"
            class="flex items-center gap-2.5 rounded-xl bg-white px-5 py-3 text-[13px] font-semibold text-[#090909] transition hover:bg-white/90"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Agendar llamada
          </a>
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2.5 rounded-xl bg-[#25D366] px-5 py-3 text-[13px] font-semibold text-white transition hover:bg-[#20ba5a]"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.85 9.85 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43-.14-.01-.31-.01-.48-.01-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"/></svg>
            WhatsApp
          </a>
        </div>
      </div>
    </div>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)} />

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // TITLE REVEAL ANIMATIONS (Premium Blur + Slide up)
      gsap.utils.toArray('.title-reveal').forEach((el: any) => {
        gsap.fromTo(el, 
          { y: 80, opacity: 0, filter: 'blur(12px)' }, 
          { 
            y: 0, 
            opacity: 1, 
            filter: 'blur(0px)', 
            duration: 1.6, 
            ease: 'expo.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 85%'
            }
          }
        );
      });

      // STANDARD REVEAL ANIMATIONS (using ScrollTrigger to toggle class for CSS transitions)
      gsap.utils.toArray('.reveal-up').forEach((el: any) => {
        ScrollTrigger.create({
          trigger: el,
          start: 'top 85%',
          toggleClass: 'in-view',
          once: true,
        });
      });

      // PARALLAX ANIMATIONS
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        gsap.utils.toArray('[data-speed]').forEach((el: any) => {
          const speed = parseFloat(el.getAttribute('data-speed') || '0.2');
          
          // Set will-change for performance
          el.style.willChange = 'transform';
          
          gsap.fromTo(el, 
            { y: 150 * speed }, 
            {
              y: -150 * speed,
              ease: 'none',
              scrollTrigger: {
                trigger: el,
                start: 'top bottom',
                end: 'bottom top',
                scrub: true
              }
            }
          );
        });
      }
      // SCROLL BAR TOGGLE
      const scrollBar = document.getElementById('scroll-bar');
      const scrollBarDesktop = document.getElementById('scroll-bar-desktop');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 600) {
          scrollBar?.classList.remove('translate-y-full');
          scrollBarDesktop?.classList.remove('translate-y-full');
        } else {
          scrollBar?.classList.add('translate-y-full');
          scrollBarDesktop?.classList.add('translate-y-full');
        }
      });

      // MAGNETIC MICRO-INTERACTIONS
      const magnetics = document.querySelectorAll('.magnetic');
      magnetics.forEach((elem: any) => {
        elem.addEventListener('mousemove', (e: MouseEvent) => {
          const { left, top, width, height } = elem.getBoundingClientRect();
          const x = (e.clientX - left - width / 2) * 0.3;
          const y = (e.clientY - top - height / 2) * 0.3;
          
          gsap.to(elem, {
            x: x,
            y: y,
            duration: 0.5,
            ease: 'power3.out'
          });
        });

        elem.addEventListener('mouseleave', () => {
          gsap.to(elem, {
            x: 0,
            y: 0,
            duration: 0.8,
            ease: 'elastic.out(1, 0.3)'
          });
        });
      });

      // SPOTLIGHT MICRO-INTERACTION (cursor-tracking glow on cards)
      if (!reduceMotion) {
        const spotlightCards = document.querySelectorAll<HTMLElement>('[data-spotlight]');
        spotlightCards.forEach((card) => {
          const glow = card.querySelector<HTMLElement>('.spotlight-glow');
          if (!glow) return;
          const { left, top, width, height } = card.getBoundingClientRect();
          const cx = left + width / 2;
          const cy = top + height / 2;
          card.addEventListener('mousemove', (e: MouseEvent) => {
            const rx = e.clientX - left;
            const ry = e.clientY - top;
            glow.style.background = `radial-gradient(420px circle at ${rx}px ${ry}px, rgba(59,130,246,0.16), transparent 70%)`;
            gsap.to(glow, { opacity: 1, duration: 0.3, ease: 'power2.out' });
            gsap.to(glow, { x: e.clientX - cx, y: e.clientY - cy, duration: 0.6, ease: 'power3.out' });
          });
          card.addEventListener('mouseleave', () => {
            gsap.to(glow, { opacity: 0, duration: 0.4, ease: 'power2.out' });
            gsap.to(glow, { x: 0, y: 0, duration: 0.4, ease: 'power2.out' });
          });
        });
      }

      // 3D TILT MICRO-INTERACTION
      if (!reduceMotion) {
        const tiltCards = document.querySelectorAll<HTMLElement>('[data-tilt]');
        tiltCards.forEach((card) => {
          const strength = parseFloat(card.getAttribute('data-tilt') || '8');
          card.addEventListener('mousemove', (e: MouseEvent) => {
            const rect = card.getBoundingClientRect();
            const px = (e.clientX - rect.left) / rect.width;
            const py = (e.clientY - rect.top) / rect.height;
            const rx = (0.5 - py) * strength;
            const ry = (px - 0.5) * strength;
            gsap.to(card, {
              rotateX: rx,
              rotateY: ry,
              transformPerspective: 800,
              duration: 0.4,
              ease: 'power2.out'
            });
          });
          card.addEventListener('mouseleave', () => {
            gsap.to(card, { rotateX: 0, rotateY: 0, duration: 0.6, ease: 'elastic.out(1,0.4)' });
          });
        });
      }
    </script>

    <CookieConsent />
  </body>
</html>
