---
import { differentiators } from '../data/differentiators';
import Container from './ui/Container.astro';
---

<section class="relative overflow-hidden border-t border-black/10 bg-black text-white">
  <div class="grid-bg-invert absolute inset-0" aria-hidden="true"></div>
  <Container class="relative z-10 py-24 lg:py-36">
    <!-- CABECERA -->
    <div class="reveal-up flex flex-wrap items-end justify-between gap-10">
      <div class="max-w-[780px]">
        <div class="mb-8 flex items-center gap-4">
          <span class="h-px w-9 bg-accent"></span>
          <span class="text-[11px] font-medium uppercase tracking-[.24em] text-white/40"
            >Diferenciales</span
          >
          <span class="h-px w-24 bg-white/10"></span>
        </div>
        <h2 class="text-[clamp(3rem,6.8vw,6.5rem)] font-semibold leading-[.9] tracking-[-.065em]">
          <span class="block text-white/15">Por qué Croilab</span>
          <span class="block text-accent">marca la diferencia</span>
        </h2>
      </div>

      <!-- BADGE ROTATORIO -->
      <div class="hidden items-center gap-6 md:flex" data-parallax="0.15">
        <div class="relative flex h-28 w-28 items-center justify-center">
          <span
            class="absolute inset-0 rounded-full border border-dashed border-white/20 animate-spinSlow"
          ></span>
          <span class="text-center text-[10px] uppercase leading-4 tracking-[.2em] text-white/40"
            >lab<br />system<br />04</span
          >
        </div>
      </div>
    </div>

    <!-- LISTA EDITORIAL -->
    <ul class="mt-20 lg:mt-28">
      {
        differentiators.map((d, i) => (
          <li class="reveal-up border-t border-white/10 last:border-b" style={`--i:${i}`}>
            <div class="group relative grid items-center gap-x-10 gap-y-5 py-10 transition-colors duration-300 lg:grid-cols-[80px_1fr_360px_64px] lg:py-14">
              <span
                aria-hidden="true"
                class="pointer-events-none absolute -right-6 top-1/2 hidden -translate-y-1/2 select-none text-[clamp(120px,16vw,260px)] font-semibold leading-none tracking-tighter text-white/[.045] transition-colors duration-500 lg:block"
              >
                {d.num}
              </span>

              <span class="text-xs font-medium tracking-[.2em] text-white/35 transition-colors duration-300 group-hover:text-accent">
                {d.num}
              </span>

              <h3 class="relative z-10 text-[clamp(2.2rem,4.6vw,4rem)] font-semibold leading-none tracking-[-.04em] text-white transition-all duration-300 group-hover:translate-x-2 group-hover:text-accent">
                {d.title}
              </h3>

              <p class="text-sm leading-6 text-white/45 transition-colors duration-300 group-hover:text-white/70 lg:text-right">
                {d.description}
              </p>

              <span class="hidden h-12 w-12 items-center justify-center justify-self-end rounded-full border border-white/15 text-lg text-white transition-all duration-300 group-hover:rotate-45 group-hover:border-accent group-hover:bg-accent lg:flex">
                ↗
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
