---
import { getWpProjects } from '../lib/wp';
import { clients as fallbackClients } from '../data/clients';
import Container from './ui/Container.astro';

let dynamicClients: { image: string; alt: string }[] = [];
try {
  // Obtenemos hasta 50 proyectos para sacar sus logos
  const { items } = await getWpProjects({ per_page: '50' });
  
  // Filtramos solo los que tengan un logo configurado
  const projectsWithLogos = items.filter(
    (p) => p.croilab_proyecto?.logo_url
  );

  // Mapeamos al formato que espera el marquee
  dynamicClients = projectsWithLogos.map((p) => ({
    image: p.croilab_proyecto!.logo_url as string,
    alt: p.title?.rendered || 'Cliente',
  }));
} catch (e) {
  console.error("Error fetching projects for marquee:", e);
}

// Usamos los dinámicos si hay, de lo contrario caemos en los hardcodeados
const clientsToRender = dynamicClients.length > 0 ? dynamicClients : fallbackClients;
---

<section class="border-t border-black/10 bg-white py-14" aria-label="Clientes">
  <Container>
    <p
      class="reveal-up mb-10 text-center text-[11px] font-medium uppercase tracking-[.24em] text-muted"
    >
      Confían en nosotros
    </p>
  </Container>
  <div class="marquee marquee-mask">
    <div class="marquee-track">
      {
        clientsToRender.map((client) => (
          <img 
            src={client.image} 
            alt={client.alt} 
            class="mr-24 h-10 w-auto object-contain brightness-0 opacity-50 transition hover:opacity-100" 
            loading="lazy" 
          />
        ))
      }
      {
        clientsToRender.map((client) => (
          <img 
            src={client.image} 
            alt={client.alt} 
            class="mr-24 h-10 w-auto object-contain brightness-0 opacity-50 transition hover:opacity-100" 
            loading="lazy" 
            aria-hidden="true" 
          />
        ))
      }
    </div>
  </div>
</section>
