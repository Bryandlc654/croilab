---
import { clients } from '../data/clients';
import Container from './ui/Container.astro';
---

<section class="border-t border-white/10 bg-[#090909] py-14" aria-label="Clientes">
  <Container>
    <p
      class="reveal-up mb-10 text-center text-[11px] font-medium uppercase tracking-[.24em] text-muted"
    >
      Confían en nosotros
    </p>
  </Container>
  <div class="marquee marquee-mask">
    <div class="marquee-track">
      {
        clients.map((client) => (
          <img 
            src={client.image} 
            alt={client.alt} 
            class="mr-24 h-10 w-auto object-contain brightness-0 invert opacity-50 transition hover:opacity-100" 
            loading="lazy" 
          />
        ))
      }
      {
        clients.map((client) => (
          <img 
            src={client.image} 
            alt={client.alt} 
            class="mr-24 h-10 w-auto object-contain brightness-0 invert opacity-50 transition hover:opacity-100" 
            loading="lazy" 
            aria-hidden="true" 
          />
        ))
      }
    </div>
  </div>
</section>
