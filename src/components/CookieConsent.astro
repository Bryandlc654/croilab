---
// Configuración de la política de privacidad (enlazada desde el banner)
const privacyUrl = '/privacidad';
---

<div
  id="cookie-consent"
  class="fixed inset-x-0 bottom-0 z-[85] hidden p-4 sm:p-6"
  data-cookie-consent
  role="region"
  aria-label="Aviso de cookies"
>
  <div class="mx-auto max-w-3xl overflow-hidden rounded-3xl border border-black/10 bg-white/95 backdrop-blur-xl shadow-[0_40px_100px_rgba(0,0,0,0.25)]">
    <!-- Fila principal -->
    <div class="flex flex-col gap-4 p-6 sm:flex-row sm:items-start sm:justify-between sm:p-7">
      <div class="flex items-start gap-4">
        <div class="hidden h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-black text-white sm:flex">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>
        </div>
        <div>
          <h3 class="text-lg font-bold tracking-tight text-black">Usamos cookies</h3>
          <p class="mt-1.5 max-w-xl text-sm leading-relaxed text-black/60">
            Utilizamos cookies propias y de terceros para mejorar tu experiencia, analizar el tráfico
            y personalizar el contenido. Puedes elegir cuáles aceptas.
          </p>
          <button
            type="button"
            data-cookie-config
            class="mt-3 text-sm font-bold text-blue-600 underline-offset-4 hover:underline"
          >
            Personalizar preferencias
          </button>
        </div>
      </div>

      <div class="flex shrink-0 flex-col gap-2.5 sm:items-end">
        <button
          type="button"
          data-cookie-accept
          class="magnetic w-full rounded-full bg-black px-6 py-3 text-[13px] font-bold text-white transition hover:scale-[1.03] hover:shadow-lg sm:w-auto"
        >
          Aceptar todas
        </button>
        <button
          type="button"
          data-cookie-essential
          class="w-full rounded-full border border-black/10 bg-white px-6 py-3 text-[13px] font-bold text-black/70 transition hover:border-black/20 hover:text-black sm:w-auto"
        >
          Solo necesarias
        </button>
      </div>
    </div>

    <!-- Panel de personalización -->
    <div data-cookie-config-panel class="hidden border-t border-black/5 bg-[#f8f9fa] px-6 py-5 sm:px-7">
      <div class="flex flex-col gap-3">
        <label class="flex cursor-pointer items-start justify-between gap-4 rounded-2xl border border-black/10 bg-white p-4 opacity-70">
          <span class="flex flex-col">
            <span class="text-sm font-bold text-black">Necesarias</span>
            <span class="text-xs leading-relaxed text-black/50">Imprescindibles para el funcionamiento del sitio.</span>
          </span>
          <span class="rounded-full bg-black/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-black/50">Siempre activas</span>
        </label>

        <label class="flex cursor-pointer items-start justify-between gap-4 rounded-2xl border border-black/10 bg-white p-4">
          <span class="flex flex-col">
            <span class="text-sm font-bold text-black">Analíticas</span>
            <span class="text-xs leading-relaxed text-black/50">Nos ayudan a entender cómo se usa el sitio y mejorarlo.</span>
          </span>
          <input type="checkbox" data-cookie-analytics class="h-5 w-5 accent-blue-600" />
        </label>

        <label class="flex cursor-pointer items-start justify-between gap-4 rounded-2xl border border-black/10 bg-white p-4">
          <span class="flex flex-col">
            <span class="text-sm font-bold text-black">Marketing</span>
            <span class="text-xs leading-relaxed text-black/50">Permiten mostrar contenido y anuncios más relevantes.</span>
          </span>
          <input type="checkbox" data-cookie-marketing class="h-5 w-5 accent-blue-600" />
        </label>
      </div>

      <div class="mt-4 flex flex-col-reverse items-center gap-2.5 sm:flex-row sm:justify-end">
        <a href={privacyUrl} class="text-sm font-medium text-black/50 underline-offset-4 hover:underline">
          Ver política de privacidad
        </a>
        <button
          type="button"
          data-cookie-save
          class="w-full rounded-full bg-black px-6 py-3 text-[13px] font-bold text-white transition hover:scale-[1.03] hover:shadow-lg sm:w-auto"
        >
          Guardar preferencias
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const KEY = 'croilab_cookie_consent';
    const banner = document.getElementById('cookie-consent');
    if (!banner) return;

    const btnAccept = banner.querySelector('[data-cookie-accept]');
    const btnEssential = banner.querySelector('[data-cookie-essential]');
    const btnConfig = banner.querySelector('[data-cookie-config]');
    const panel = banner.querySelector('[data-cookie-config-panel]');
    const btnSave = banner.querySelector('[data-cookie-save]');
    const analytics = banner.querySelector('[data-cookie-analytics]');
    const marketing = banner.querySelector('[data-cookie-marketing]');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function readStored() {
      const m = document.cookie.match('(?:^|;)\\s*' + KEY + '=([^;]*)');
      return m ? decodeURIComponent(m[1]) : null;
    }

    function writeStore(choice) {
      const value = encodeURIComponent(JSON.stringify(choice));
      const expires = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toUTCString();
      document.cookie = `${KEY}=${value}; expires=${expires}; path=/; SameSite=Lax`;
      try {
        localStorage.setItem(KEY, value);
      } catch (e) {}
    }

    function dispatch(choice) {
      window.dispatchEvent(new CustomEvent('cookiestatus-changed', { detail: choice }));
      __applyConsent(choice);
    }

    function __applyConsent(choice) {
      // Punto de conexión para servicios de terceros (p. ej. Google Analytics/GTM).
      // Para añadir un tag: comprueba aquí choice.analytics / choice.marketing antes de cargarlo.
    }

    function hide() {
      banner.classList.add('hidden');
      banner.style.display = 'none';
    }

    function show() {
      if (reduceMotion) {
        banner.style.display = 'block';
      } else {
        banner.classList.remove('hidden');
        banner.classList.add('animate-cookie-in');
        banner.style.display = 'block';
      }
    }

    function save(choice) {
      writeStore(choice);
      hide();
    }

    const stored = readStored();
    if (stored) {
      try {
        __applyConsent(JSON.parse(stored));
      } catch (e) {}
      // No mostramos el banner si ya se decidió.
    } else {
      show();
    }

    btnAccept?.addEventListener('click', () => {
      const choice = { essential: true, analytics: true, marketing: true, updatedAt: Date.now() };
      save(choice);
      dispatch(choice);
    });

    btnEssential?.addEventListener('click', () => {
      const choice = { essential: true, analytics: false, marketing: false, updatedAt: Date.now() };
      save(choice);
      dispatch(choice);
    });

    btnConfig?.addEventListener('click', () => {
      panel.classList.toggle('hidden');
    });

    btnSave?.addEventListener('click', () => {
      const choice = {
        essential: true,
        analytics: analytics.checked,
        marketing: marketing.checked,
        updatedAt: Date.now(),
      };
      save(choice);
      dispatch(choice);
    });
  })();
</script>

<style>
  @keyframes cookie-in {
    from { transform: translateY(100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  .animate-cookie-in {
    animation: cookie-in 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
</style>
