      <img alt="Team member" class="w-full h-full object-cover grayscale opacity-90 transition-all duration-500 hover:grayscale-0 hover:scale-110 hover:opacity-100" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBekG4WfUyQ5wreUF95AyTtmjA4PmV1YNgZWHSPpzZiRBb-x5KZoBNVoL7EmPBmP6sb78VRmYOE7GHdDZcJjtNyV1qHfbhlteKOZRUZTBZMW4GgkmRocPlIq3rfBkYTPvlnV2VagZhGwX4KRZBmZt_eL6lC7ZdD5iE_YrhrKg3PxYe0Mtdkr27WTEtyJyCk6Rk8pqIEOlUuwvua9X1p1Paby5uOzJUTfa2uESpXWSGtT08fsy_5XX-d"/>
    </div>
    
  </div>
</section>

<style>
  .floating-card {
    width: 140px;
    height: 140px;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.5s ease;
  }
  
  @media (min-width: 768px) {
    .floating-card {
      width: 160px;
      height: 160px;
    }
  }
  
  @media (min-width: 1024px) {
    .floating-card {
      width: 200px;
      height: 200px;
    }
  }

  /* Animación continua de flotación */
  @keyframes subtle-float {
    0%, 100% { transform: translateY(0) rotate(var(--r)); }
    50% { transform: translateY(-10px) rotate(var(--r)); }
  }

  /* Positioning for the specific arc layout */
  .pos-tl { top: -20px; left: 8%; --r: -8deg; transform: rotate(var(--r)); animation: subtle-float 6s ease-in-out infinite; }
  .pos-tr { top: -20px; right: 8%; --r: 8deg; transform: rotate(var(--r)); animation: subtle-float 7s ease-in-out infinite; animation-delay: 1s; }
  .pos-ml { top: 35%; left: 0%; --r: -12deg; transform: rotate(var(--r)); animation: subtle-float 6.5s ease-in-out infinite; animation-delay: 2s; }
  .pos-mr { top: 35%; right: 0%; --r: 12deg; transform: rotate(var(--r)); animation: subtle-float 8s ease-in-out infinite; animation-delay: 0.5s; }
  .pos-bl { bottom: 0%; left: 12%; --r: -15deg; transform: rotate(var(--r)); animation: subtle-float 7.5s ease-in-out infinite; animation-delay: 1.5s; }
  .pos-br { bottom: 0%; right: 12%; --r: 15deg; transform: rotate(var(--r)); animation: subtle-float 6s ease-in-out infinite; animation-delay: 2.5s; }

  /* Hover overrides CSS animation transform temporarily */
  .floating-card:hover {
    animation-play-state: paused;
    z-index: 30;
  }
</style>
