---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items?: Crumb[];
}

const { items = [] } = Astro.props;
---

<nav
  aria-label="Migas de pan"
  class="text-[11px] font-medium uppercase tracking-[.2em] text-black/40"
>
  <ol class="flex flex-wrap items-center gap-2">
    <li>
      <a href="/" class="transition hover:text-ink">Inicio</a>
    </li>
    {
      items.map((item) => (
        <>
          <li aria-hidden="true" class="text-black/25">
            /
          </li>
          <li>
            {item.href ? (
              <a href={item.href} class="transition hover:text-ink">
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="text-ink">
                {item.label}
              </span>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>
