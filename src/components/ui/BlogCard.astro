---
interface Props {
  title: string;
  excerpt?: string;
  category?: string;
  date?: string;
  readingTime?: string;
  href?: string;
}

const { title, excerpt, category, date, readingTime, href = '#' } = Astro.props;
---

<article
  class="group flex flex-col overflow-hidden rounded-2xl border border-black/10 bg-[#111111] transition duration-300 hover:border-black/25 hover:shadow-[0_20px_50px_rgba(0,0,0,.08)]"
>
  <a
    href={href}
    class="relative flex aspect-[16/10] items-end justify-between bg-gradient-to-br from-black/[.03] to-accent/[.06] p-5"
  >
    {
      date && (
        <span class="rounded-full bg-white/80 px-3 py-1 text-[10px] font-medium uppercase tracking-[.14em] text-black/50 backdrop-blur">
          {date}
        </span>
      )
    }
  </a>

  <div class="flex flex-1 flex-col p-6">
    {
      category && (
        <span class="text-[10px] font-medium uppercase tracking-[.2em] text-accent">
          {category}
        </span>
      )
    }
    <a
      href={href}
      class="mt-2 text-lg font-semibold leading-snug tracking-tight text-black transition group-hover:text-accent"
    >
      {title}
    </a>
    {excerpt && <p class="mt-3 text-sm leading-6 text-muted">{excerpt}</p>}
    <div class="mt-auto flex items-center justify-between pt-5">
      {
        readingTime && (
          <span class="text-[10px] uppercase tracking-[.14em] text-black/35">{readingTime}</span>
        )
      }
      <span
        class="flex h-9 w-9 items-center justify-center rounded-full border border-black/10 text-sm text-black transition duration-300 group-hover:border-accent group-hover:bg-accent group-hover:text-black"
      >
        →
      </span>
    </div>
  </div>
</article>
