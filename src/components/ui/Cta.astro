---
import { whatsappLink } from '../../data/site';
import Container from './Container.astro';
import Button from './Button.astro';

const waLink = whatsappLink();

const words = ['Diagnóstico', 'Estrategia', 'Diseño', 'Meta Ads', 'SEO', 'Crecimiento'];
---

<section class="relative overflow-hidden border-t border-white/10 bg-[#050505] py-32 lg:py-48">
  <!-- Iluminaciones de fondo atractivas (Sin azul, usando blancos puros y grises plateados) -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-white/[0.03] rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-white/[0.02] rounded-full blur-[100px] pointer-events-none"></div>
  <div class="grid-bg-invert absolute inset-0 opacity-10 pointer-events-none"></div>

  <Container class="relative z-10">
    <div class="reveal-up text-center mb-16">
      <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full border border-white/10 bg-white/5 backdrop-blur-md">
        <div class="w-2 h-2 rounded-full bg-white shadow-[0_0_10px_white] animate-pulse"></div>
        <span class="text-[10px] font-semibold uppercase tracking-[.2em] text-white/70">Contacto</span>
      </div>
    </div>

    <!-- Contenedor Glassmorphism Principal -->
    <div class="reveal-up mx-auto max-w-5xl rounded-[3rem] border border-white/10 bg-white/[0.02] backdrop-blur-2xl p-10 lg:p-20 text-center shadow-[0_0_100px_rgba(255,255,255,0.02)] relative overflow-hidden">
      
      <!-- Reflejo interior del glassmorphism -->
      <div class="absolute -top-40 -right-40 w-[400px] h-[400px] bg-white/10 rounded-full blur-[80px]"></div>

      <h2 class="relative z-10 mx-auto max-w-4xl text-[clamp(2.5rem,6vw,6.5rem)] font-bold leading-[1.05] tracking-tight text-white mb-8">
        ¿Listo para dominar <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-white/70 to-white/30 italic font-serif font-normal">tu mercado?</span>
      </h2>

      <p class="relative z-10 mx-auto max-w-xl text-[16px] leading-relaxed text-white/50 mb-12">
        Agenda un diagnóstico gratuito. Analizaremos tu ecosistema digital actual y te mostraremos exactamente dónde estás perdiendo conversiones (y cómo recuperarlas).
      </p>

      <div class="relative z-10 flex flex-col items-center gap-6">
        <a
          href="/contacto"
          class="group relative inline-flex items-center gap-6 rounded-full bg-white px-8 py-5 text-[15px] font-bold text-black transition-all duration-500 hover:scale-105 hover:shadow-[0_0_40px_rgba(255,255,255,0.3)] overflow-hidden"
        >
          <!-- Efecto hover brillo -->
          <div class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-black/10 to-transparent group-hover:animate-[shine_1.5s_ease-in-out]"></div>
          
          Solicitar diagnóstico gratuito
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-black/10 transition-transform duration-500 group-hover:rotate-45">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </div>
        </a>
        
        <Button
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          variant="ghost"
          class="!text-white/40 hover:!text-white/80 text-[13px] tracking-wide"
        >
          O hablemos directo por WhatsApp →
        </Button>
      </div>
    </div>
  </Container>

  <!-- Marquee inferior más elegante -->
  <div class="marquee marquee-mask mt-32 border-y border-white/5 py-4 lg:mt-40 bg-white/[0.01]">
    <div class="marquee-track">
      {
        words.map((word) => (
          <span
            class="mr-16 flex items-center whitespace-nowrap text-[clamp(1.5rem,3vw,3rem)] font-light tracking-widest text-white/20 uppercase"
          >
            {word}<span class="ml-16 text-white/10 text-xl">✦</span>
          </span>
        ))
      }
      {
        words.map((word) => (
          <span
            aria-hidden="true"
            class="mr-16 flex items-center whitespace-nowrap text-[clamp(1.5rem,3vw,3rem)] font-light tracking-widest text-white/20 uppercase"
          >
            {word}<span class="ml-16 text-white/10 text-xl">✦</span>
          </span>
        ))
      }
    </div>
  </div>
</section>
