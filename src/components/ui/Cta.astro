---
import { whatsappLink } from '../../data/site';
import Container from './Container.astro';
import Button from './Button.astro';

const waLink = whatsappLink();

const words = ['Estrategia', 'Diseño', 'Meta Ads', 'SEO', 'Crecimiento', 'Conversiones'];
---

<section class="relative overflow-hidden border-t border-black/10 bg-white py-32 lg:py-48">
  <!-- Iluminaciones de fondo atractivas (Sin azul, usando blancos puros y grises plateados) -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-white/[0.03] rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-white/[0.02] rounded-full blur-[100px] pointer-events-none"></div>
  <div class="grid-bg absolute inset-0 opacity-10 pointer-events-none"></div>

  <Container class="relative z-10">
    <!-- Contenedor Principal Light Mode -->
    <div class="reveal-up mx-auto max-w-7xl rounded-[2.5rem] lg:rounded-[3rem] border border-black/10 bg-[#fbfbfb] p-8 lg:p-16 shadow-2xl shadow-black/5 relative overflow-hidden">
      
      <!-- Abstract Gradients -->
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[100px] translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-purple-500/10 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/3 pointer-events-none"></div>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center relative z-10">
        
        <!-- Lado Izquierdo: Textos -->
        <div class="text-left">
          <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full border border-black/10 bg-white shadow-sm mb-8">
            <div class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></div>
            <span class="text-[10px] font-bold uppercase tracking-[.2em] text-black/70">Disponibilidad Limitada</span>
          </div>

          <h2 class="text-[clamp(2.5rem,5vw,5.5rem)] font-bold leading-[0.95] tracking-tight text-black mb-6">
            ¿Listo para dominar <br />
            <span class="font-serif italic font-light text-black/40">tu mercado?</span>
          </h2>

          <p class="text-[16px] lg:text-[18px] leading-relaxed text-black/60 mb-10 max-w-[450px]">
            Cuéntanos dónde estás hoy y hacia dónde quieres llegar. Analizaremos tu ecosistema digital y te mostraremos exactamente dónde estás perdiendo conversiones.
          </p>

          <div class="flex flex-col sm:flex-row items-center gap-4">
            <a
              href="/contacto"
              class="magnetic group relative flex h-14 items-center justify-center gap-4 rounded-full bg-black px-8 text-[14px] font-bold text-white transition-all hover:scale-105 hover:shadow-xl hover:shadow-black/20 overflow-hidden w-full sm:w-auto"
            >
              <div class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/20 to-transparent group-hover:animate-[shine_1.5s_ease-in-out]"></div>
              Quiero trabajar así
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-white/20 transition-transform group-hover:rotate-45">↗</span>
            </a>
            <Button
              href={waLink}
              target="_blank"
              rel="noopener noreferrer"
              variant="ghost"
              class="!text-black/50 hover:!text-black w-full sm:w-auto"
            >
              WhatsApp directo
            </Button>
          </div>
        </div>

        <!-- Lado Derecho: UI Mockup -->
        <div class="relative hidden lg:block" style="perspective: 1000px;">
          <div class="relative w-full max-w-[420px] ml-auto transition-transform duration-700 ease-out hover:rotate-0" style="transform: rotateY(-10deg) rotateX(5deg);">
            
            <!-- Calendar Card Mockup -->
            <div class="w-full bg-white rounded-2xl border border-black/10 shadow-[0_30px_60px_rgba(0,0,0,0.08)] p-6 relative z-20">
              <div class="flex items-center justify-between border-b border-black/5 pb-4 mb-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-black/5 flex items-center justify-center border border-black/5">
                    <svg class="w-5 h-5 text-black/70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-black">Llamada de Alineación</h4>
                    <p class="text-[11px] text-black/50">Google Meet • 30 min</p>
                  </div>
                </div>
              </div>
              
              <!-- Mini Calendar Grid -->
              <div class="grid grid-cols-7 gap-1 text-center mb-4">
                {['L','M','X','J','V','S','D'].map(day => (
                  <span class="text-[9px] font-bold text-black/40 mb-1">{day}</span>
                ))}
                <!-- Empty days -->
                <div class="p-1"></div><div class="p-1"></div><div class="p-1"></div>
                <!-- Days -->
                {Array.from({length: 12}).map((_, i) => (
                  <div class={`text-[11px] font-medium p-1.5 rounded-md cursor-pointer transition-colors ${i === 8 ? 'bg-black text-white shadow-md' : 'text-black/70 hover:bg-black/5'}`}>
                    {12 + i}
                  </div>
                ))}
              </div>

              <!-- Time Slots -->
              <div class="flex gap-2">
                <div class="flex-1 text-center py-2 rounded-md border border-black/10 text-[11px] font-bold text-black hover:border-black transition-colors cursor-pointer">10:00 AM</div>
                <div class="flex-1 text-center py-2 rounded-md bg-black text-white text-[11px] font-bold shadow-md cursor-pointer">02:30 PM</div>
                <div class="flex-1 text-center py-2 rounded-md border border-black/10 text-[11px] font-bold text-black hover:border-black transition-colors cursor-pointer">04:00 PM</div>
              </div>
            </div>

            <!-- Floating Element: Profile -->
            <div class="absolute -right-8 top-12 w-48 bg-white/90 backdrop-blur-md border border-black/10 rounded-xl p-3 shadow-xl z-30 animate-float">
              <div class="flex items-center gap-3">
                <div class="relative">
                  <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-blue-100 to-purple-100 flex items-center justify-center text-blue-600 font-bold text-sm">C</div>
                  <div class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-green-500 border-2 border-white rounded-full"></div>
                </div>
                <div>
                  <p class="text-[11px] font-bold text-black leading-tight">Equipo Croilab</p>
                  <p class="text-[9px] text-black/50">Estratega asignado</p>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </Container>

  <!-- Elemento Fijo Animado: Portal Pulsante desde el Footer -->
  <div class="relative w-full h-40 lg:h-56 mt-20 flex justify-center items-end overflow-hidden">
    
    <!-- Contenedor del Portal (mitad superior visible) -->
    <div class="relative w-[600px] h-[300px] flex justify-center items-end">
      
      <!-- Anillos concéntricos animados (siempre en movimiento) -->
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full border border-blue-500/10 animate-[ping_4s_ease-out_infinite]"></div>
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[450px] h-[450px] rounded-full border border-purple-500/20 animate-[ping_4s_ease-out_infinite_1s]"></div>
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[300px] h-[300px] rounded-full border border-cyan-500/30 animate-[ping_4s_ease-out_infinite_2s]"></div>
      
      <!-- Núcleo Central (Fijo, visible) -->
      <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[180px] h-[180px] bg-gradient-to-t from-[#090909] to-[#1a1a1a] rounded-full shadow-[0_0_50px_rgba(0,0,0,0.2)] border-t border-white/10 z-10 flex flex-col items-center justify-start pt-8 cursor-pointer transition-transform duration-500 hover:scale-105 hover:-translate-y-2" onclick="window.scrollTo({top:0, behavior:'smooth'})" title="Volver al inicio">
        
        <svg class="w-6 h-6 text-white/80 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
        
        <span class="text-[9px] uppercase tracking-[.3em] font-bold text-white/50 mt-4">
          Top
        </span>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .animate-float {
    animation: float 5s ease-in-out infinite;
  }
</style>
