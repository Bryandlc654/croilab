---
interface Props {
  href?: string;
  variant?: 'primary' | 'dark' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit';
  target?: string;
  rel?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  target,
  rel,
  class: className,
} = Astro.props;

const variants: Record<string, string> = {
  primary:
    'bg-accent text-white shadow-[0_10px_30px_rgba(8,120,249,.18)] hover:-translate-y-1 hover:shadow-[0_15px_40px_rgba(8,120,249,.25)]',
  dark: 'bg-black text-white hover:bg-accent',
  outline: 'border border-black/15 text-ink hover:border-accent hover:text-accent',
  ghost: 'text-muted hover:text-ink',
};

const sizes: Record<string, string> = {
  sm: 'px-4 py-2.5 text-xs',
  md: 'px-6 py-3.5 text-[13px]',
  lg: 'px-8 py-4 text-sm',
};

const classes = [
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold transition duration-300',
  variants[variant],
  sizes[size],
  className,
].join(' ');
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
    </button>
  )
}
