---
import { testimonials } from '../data/testimonials';
import Container from './ui/Container.astro';
import SectionTitle from './ui/SectionTitle.astro';

const initials = (name: string) =>
  name
    .split(' ')
    .map((n) => n[0])
    .join('')
    .slice(0, 2);
---

<section class="relative overflow-hidden border-t border-black/10 bg-white">
  <div class="grid-bg absolute inset-0 opacity-15" aria-hidden="true"></div>
  <div class="blue-light -top-40 left-[-10%] opacity-60" data-parallax="0.2" aria-hidden="true"></div>

  <Container class="relative z-10 py-24 lg:py-32">
    <SectionTitle
      kicker="Testimonios"
      align="center"
      description="Lo que dicen quienes ya convirtieron con nosotros."
    >
      Resultados que <span class="text-accent">hablan</span>
    </SectionTitle>

    <!-- QUOTE ROTATIVO -->
    <div
      class="reveal-up relative mx-auto mt-16 min-h-[440px] max-w-5xl sm:min-h-[400px] lg:min-h-[380px]"
    >
      {
        testimonials.map((t, i) => (
          <figure
            class="quote-block absolute inset-0 flex flex-col items-center justify-center px-4 text-center"
            style={`--i:${i}`}
          >
            <span
              aria-hidden="true"
              class="select-none text-7xl font-semibold leading-none text-accent lg:text-8xl"
              >"</span
            >
            <blockquote
              class="mt-4 max-w-3xl text-[clamp(1.5rem,3.2vw,2.9rem)] font-semibold leading-snug tracking-[-.03em] text-black"
            >
              {t.quote}
            </blockquote>
            <figcaption class="mt-8 flex items-center gap-3">
              <span
                class="flex h-10 w-10 items-center justify-center rounded-full bg-accent text-xs font-semibold text-white"
              >
                {initials(t.author)}
              </span>
              <span class="text-left">
                <span class="block text-sm font-semibold text-black">{t.author}</span>
                <span class="block text-xs text-muted">{t.role}</span>
              </span>
            </figcaption>
            <div class="mt-8 h-1 w-28 overflow-hidden rounded-full bg-black/10">
              <span class="quote-bar block h-full w-full origin-left rounded-full bg-accent"></span>
            </div>
          </figure>
        ))
      }
    </div>
  </Container>
</section>
