---
import { testimonials } from '../data/testimonials';
import Container from './ui/Container.astro';
import SectionTitle from './ui/SectionTitle.astro';
---

<section class="border-t border-black/10 bg-[#f8fafc]">
  <Container class="py-24 lg:py-32">
    <SectionTitle
      kicker="Testimonios"
      align="center"
      description="Lo que dicen quienes ya convirtieron con nosotros."
    >
      Resultados que <span class="text-accent">hablan</span>
    </SectionTitle>
    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {
        testimonials.map((t, i) => (
          <figure
            class="reveal-up flex flex-col rounded-2xl border border-black/10 bg-white p-8"
            style={`--i:${i}`}
          >
            <span aria-hidden="true" class="text-5xl font-semibold leading-none text-accent">
              "
            </span>
            <blockquote class="mt-4 flex-1 text-[15px] leading-7 text-black/70">
              {t.quote}
            </blockquote>
            <figcaption class="mt-8 border-t border-black/10 pt-5">
              <div class="text-sm font-semibold text-ink">{t.author}</div>
              <div class="mt-0.5 text-xs text-muted">{t.role}</div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Container>
</section>
