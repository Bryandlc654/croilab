---
import { projects } from '../data/projects';
import Button from './ui/Button.astro';
import Container from './ui/Container.astro';
import ProjectCard from './ui/ProjectCard.astro';
import SectionTitle from './ui/SectionTitle.astro';
---

<section id="proyectos" class="border-t border-black/10 bg-white">
  <Container class="py-24 lg:py-32">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <SectionTitle
        kicker="Proyectos"
        description="Casos reales con resultados medibles: diseño, adquisición y optimización trabajando juntos."
      >
        Trabajos que <span class="text-accent">convierten</span>
      </SectionTitle>
      <Button href="/proyectos" variant="outline" class="mb-2">Ver todos los proyectos →</Button>
    </div>
    <div class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map((project, i) => <ProjectCard {...project} index={i + 1} />)}
    </div>
  </Container>
</section>
