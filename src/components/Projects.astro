---
import Container from './ui/Container.astro';
import SectionTitle from './ui/SectionTitle.astro';

const wpEndpoint = 'https://darkblue-flamingo-706734.hostingersite.com/wp-json/wp/v2/proyecto';
let wpProjects = [];

try {
  const res = await fetch(wpEndpoint);
  wpProjects = await res.json();
} catch (e) {
  console.error("Error fetching projects from WP:", e);
}

// Convertimos el JSON de WP al formato que nuestra UI necesita
let projects = wpProjects.map(wpProj => {
  let rawText = wpProj.content?.rendered || "";
  let cleanDesc = rawText.replace(/(<([^>]+)>)/gi, "").trim();
  if (cleanDesc.length > 150) {
    cleanDesc = cleanDesc.slice(0, 150) + "...";
  }

  return {
    title: wpProj.title?.rendered || "Proyecto",
    description: cleanDesc,
    category: "Proyecto",
    image: wpProj.imagen_url || "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=2426&auto=format&fit=crop",
    link: wpProj.enlace_proyecto || "#"
  };
});

// Aseguramos tener exactamente 15 proyectos para la grid de 5x3
if (projects.length > 0) {
  while (projects.length < 15) {
    projects.push(...projects);
  }
} else {
  // Fallback si no hay proyectos
  projects = Array(15).fill({
    title: "Proyecto",
    description: "Descripción...",
    category: "Proyecto",
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=2426&auto=format&fit=crop",
    link: "#"
  });
}
projects = projects.slice(0, 15);
---

<section id="proyectos" class="projects-section relative bg-white border-t border-black/10 overflow-hidden w-full min-h-[190vh] lg:min-h-[180vh] flex flex-col items-center justify-start">
  
  <!-- Iluminaciones de fondo (más fuertes para que resalten sobre el blanco) -->
  <div class="absolute -top-40 -left-20 w-[500px] h-[500px] bg-blue-500/30 rounded-full blur-[100px] pointer-events-none mix-blend-multiply" aria-hidden="true"></div>
  <div class="absolute top-40 right-[-10%] w-[600px] h-[600px] bg-cyan-500/20 rounded-full blur-[120px] pointer-events-none mix-blend-multiply" aria-hidden="true"></div>
  <div class="absolute bottom-40 left-[20%] w-[400px] h-[400px] bg-blue-400/20 rounded-full blur-[90px] pointer-events-none mix-blend-multiply" aria-hidden="true"></div>

  <!-- Título de la sección (separador del hero) -->
  <div class="absolute top-20 lg:top-32 w-full flex flex-col items-center z-10">
    <div class="reveal-up mb-6 flex items-center gap-4">
      <span class="h-px w-9 bg-blue-400/50"></span>
      <span class="text-[11px] font-medium uppercase tracking-[.24em] text-blue-400/80">Portafolio</span>
      <span class="h-px w-9 bg-blue-400/50"></span>
    </div>
    <h2 class="title-reveal text-center text-[clamp(2.5rem,5vw,4.5rem)] font-semibold leading-[1.05] tracking-[-.04em] text-black">
      Resultados <span class="font-serif italic font-normal text-black drop-shadow-[0_0_10px_rgba(100,200,255,0.3)]">tangibles</span>.
    </h2>
  </div>

  <!-- Envoltura de la grid que animaremos con transform: scale -->
  <!-- Reducimos el mt final para que la cuadrícula quede cerca del título -->
  <div class="projects-grid-wrapper relative mt-48 lg:mt-64 w-[130vw] h-[150vh] lg:w-[85vw] lg:h-[145vh] flex items-center justify-center z-20">
    
    <div class="projects-grid grid grid-cols-5 grid-rows-3 gap-2 md:gap-4 w-full h-full p-2 md:p-4">
      {projects.map((project, i) => (
        <a 
          href={project.link} 
          target="_blank" 
          rel="noopener noreferrer" 
          class={`project-grid-item relative overflow-hidden rounded-xl md:rounded-2xl group block ${i === 7 ? 'is-center z-20' : 'z-0'}`}
        >
          <!-- Imagen de fondo -->
          <img 
            src={project.image} 
            alt={project.title} 
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" 
          />
          
          <!-- El overlay general ha sido removido para que las imágenes estén al 100% de brillo -->
          
          <!-- Contenido (Visible en la grid final o al hacer hover) -->
          <div class="project-content absolute inset-0 p-3 md:p-6 flex flex-col justify-end opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-gradient-to-t from-black/90 via-black/40 to-transparent">
            <span class="text-[9px] md:text-xs font-semibold uppercase tracking-widest text-white/70 mb-1 md:mb-2">{project.category}</span>
            <h3 class="text-sm md:text-2xl font-bold text-white leading-tight">{project.title}</h3>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  /* Optimizaciones de rendimiento para la animación */
  .projects-grid-wrapper {
    will-change: transform;
    backface-visibility: hidden;
  }
  .project-grid-item {
    will-change: opacity, transform;
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initProjectsGrid() {
    const section = document.querySelector('.projects-section');
    const gridWrapper = document.querySelector('.projects-grid-wrapper');
    const items = gsap.utils.toArray('.project-grid-item');
    
    if (!gridWrapper || !section || items.length < 15) return;

    const centerItem = items[7] as HTMLElement;

    // Calculamos qué escala necesitamos aplicar al wrapper para lograr que la central cubra casi toda la pantalla
    const calculateScale = () => {
      gsap.set(gridWrapper, { scale: 1 });
      const itemRect = centerItem.getBoundingClientRect();
      const windowWidth = window.innerWidth;
      
      // Separación left y right de los bordes (40px en móvil, 80px en desktop)
      const margin = windowWidth < 768 ? 40 : 80;
      const scaleX = (windowWidth - margin) / itemRect.width;
      
      return scaleX;
    };

    let initialScale = calculateScale();

    // Configuramos el wrapper inicialmente desplazado hacia abajo para que la imagen al 100%
    // no toque el hero (separación visual).
    // GSAP aplica el translate ANTES del scale, por lo que dividimos entre initialScale para que 
    // el offset visual real compense el menor mt- y siga separando la imagen del hero.
    const visualYOffset = window.innerWidth < 768 ? 1200 : 2200; 
    const initialYOffset = visualYOffset / initialScale;

    // Estado inicial: escalado al máximo y desplazado hacia abajo
    gsap.set(gridWrapper, {
      scale: initialScale,
      y: initialYOffset,
      transformOrigin: "center center"
    });

    // Ocultamos todas las demás tarjetas inicialmente
    items.forEach((item, index) => {
      if (index !== 7) {
        gsap.set(item, { opacity: 0 });
      }
    });

    // Ocultamos el contenido de la tarjeta central
    const centerContent = centerItem.querySelector('.project-content');
    if (centerContent) {
      gsap.set(centerContent, { opacity: 0 });
    }

    // Timeline en pausa, la controlaremos manualmente con onUpdate
    const tl = gsap.timeline({ paused: true });

    // Calculamos el radio del rombo
    // Usamos un valor fijo en espacio local (sin escalar) para que rodeen a la imagen central
    const rhombusRadius = window.innerWidth < 768 ? 150 : 350;

    // Obtenemos la posición local de la imagen 8 (centro)
    const centerLeft = centerItem.offsetLeft;
    const centerTop = centerItem.offsetTop;

    // Configurar estado inicial: todos los 14 items en forma de rombo perfecto
    const sideItems = [];
    items.forEach((item, index) => {
      if (index === 7) return; // Saltamos el centro

      let rhombusIndex = index > 7 ? index - 1 : index; // 0 a 13
      const angle = (rhombusIndex / 14) * Math.PI * 2;
      
      const cosA = Math.cos(angle);
      const sinA = Math.sin(angle);
      const denominator = Math.abs(cosA) + Math.abs(sinA);
      
      // Coordenadas del rombo respecto al centro
      const rx = (rhombusRadius * cosA) / denominator;
      const ry = (rhombusRadius * sinA) / denominator;

      // Distancia necesaria para mover este item al centro exacto
      const toCenterX = centerLeft - item.offsetLeft;
      const toCenterY = centerTop - item.offsetTop;

      // Posicionamos el item en el centro + la coordenada del rombo
      gsap.set(item, { 
        opacity: 0, 
        x: toCenterX + rx, 
        y: toCenterY + ry,
        scale: 0.5 // Nacen pequeñitos
      });

      sideItems.push(item);
    });

    // 1. La imagen 8 (el centro) se va reduciendo progresivamente y el wrapper
    // sube (y: 0) a su posición original
    tl.to(gridWrapper, {
      scale: 1,
      y: 0,
      duration: 1.0,
      ease: "power2.inOut" 
    }, 0);

    // 2. Al llegar al 70% del scroll, aparece el rombo por detrás
    tl.to(sideItems, {
      opacity: 0.3, // Muy transparentes para que casi se fundan con el fondo negro y la imagen 8 brille sola
      scale: 0.6, // Se quedan pequeños mientras forman el rombo
      duration: 0.10, // Aparecen rápidamente entre el 70% y el 80%
      ease: "power1.inOut"
    }, 0.70);

    // 3. Al llegar al 85% del scroll, las tarjetas vuelan desde el rombo hacia la cuadrícula
    tl.to(sideItems, {
      x: 0,
      y: 0,
      scale: 1, // Recuperan su tamaño normal en la cuadrícula
      opacity: 1, // Recuperan su brillo máximo para resaltar todas por igual en la cuadrícula
      duration: 0.15, // Terminan de acomodarse en el 100%
      ease: "back.out(1.2)"
    }, 0.85);

    ScrollTrigger.create({
      trigger: ".projects-section",
      start: "top top", 
      // Al usar pin y +=250%, forzamos al usuario a scrollear 2.5 veces la altura de la pantalla
      // Esto hace que la animación "demore más" y sea súper fluida y controlable.
      end: "+=250%", 
      animation: tl,
      scrub: 1,
      pin: true
    });

    // Recalcular la escala si el usuario redimensiona la ventana
    window.addEventListener('resize', () => {
      ScrollTrigger.refresh();
    });
  }

  initProjectsGrid();
</script>
