---
import Button from './ui/Button.astro';
import Container from './ui/Container.astro';
import SectionTitle from './ui/SectionTitle.astro';

const wpEndpoint = 'https://darkblue-flamingo-706734.hostingersite.com/wp-json/wp/v2/proyecto';
let wpProjects = [];

try {
  const res = await fetch(wpEndpoint);
  wpProjects = await res.json();
} catch (e) {
  console.error("Error fetching projects from WP:", e);
}

// Convertimos el JSON de WP al formato que nuestra UI necesita
const projects = wpProjects.map(wpProj => {
  let rawText = wpProj.content?.rendered || "";
  let cleanDesc = rawText.replace(/(<([^>]+)>)/gi, "").trim();
  if (cleanDesc.length > 150) {
    cleanDesc = cleanDesc.slice(0, 150) + "...";
  }

  return {
    title: wpProj.title?.rendered || "Proyecto",
    description: cleanDesc,
    category: "Proyecto",
    image: wpProj.imagen_url || "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=2426&auto=format&fit=crop",
    link: wpProj.enlace_proyecto || "#"
  };
});
---

<section id="proyectos" class="relative border-t border-white/10 bg-[#050505] py-24 lg:py-40">
  <!-- Sutil textura de fondo -->
  <div class="grid-bg-invert absolute inset-0 opacity-10"></div>

  <Container class="relative z-10 mb-20">
    <div class="reveal-up flex flex-wrap items-end justify-between gap-8">
      <SectionTitle
        kicker="Proyectos"
        description="Experiencias digitales diseñadas para captar, retener y convertir."
      >
        Trabajos que <span class="text-white/80">convierten</span>
      </SectionTitle>
    </div>
  </Container>

  <div class="relative w-full max-w-[1200px] mx-auto px-6 pb-32 flex flex-col gap-12 lg:gap-24" id="cards-container">
    {projects.map((project, i) => {
      const num = String(i + 1).padStart(2, '0');
      // Ajuste de 'top' para que al hacer sticky quede un pequeño margen entre cada carta
      const topOffset = 120 + (i * 20);
      
      return (
        <article 
          class="project-card sticky overflow-hidden rounded-[2.5rem] border border-white/10 bg-[#0d0d0d] shadow-2xl flex flex-col lg:flex-row h-[80vh] lg:h-[600px] w-full"
          style={`top: ${topOffset}px; z-index: ${i + 1};`}
        >
          <!-- Contenido (Izquierda) -->
          <div class="relative z-10 flex flex-1 flex-col justify-between p-10 lg:p-16 lg:w-5/12">
            
            <div class="flex items-center justify-between w-full">
              <span class="text-[11px] font-medium uppercase tracking-[.25em] text-white/60">
                {project.category}
              </span>
              <span class="text-6xl font-bold text-white/[0.04] select-none">{num}</span>
            </div>

            <div class="mt-12 lg:mt-0">
              <h3 class="text-[clamp(2.5rem,4vw,4rem)] font-bold leading-[1.05] tracking-tight text-white mb-6">
                {project.title}
              </h3>
              <p class="text-[15px] leading-relaxed text-white/50 max-w-sm">
                {project.description}
              </p>
            </div>

            <div class="mt-12">
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-4 rounded-full bg-white/5 border border-white/10 px-6 py-4 text-[13px] font-semibold text-white transition-all duration-300 hover:bg-white hover:text-black"
              >
                Visitar el proyecto
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/10 transition-all duration-300 group-hover:bg-black group-hover:text-white">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </a>
            </div>
          </div>

          <!-- Imagen (Derecha) -->
          <div class="relative flex-1 lg:w-7/12 min-h-[300px] lg:min-h-full overflow-hidden">
            <!-- Gradiente para suavizar la transición entre el texto y la imagen -->
            <div class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-[#0d0d0d] to-transparent z-10 hidden lg:block"></div>
            
            <!-- Efecto de viñeta -->
            <div class="absolute inset-0 bg-black/20 z-10 pointer-events-none"></div>

            <img 
              src={project.image} 
              alt={project.title} 
              class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-[3s] ease-out hover:scale-105"
            />
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .project-card {
    transform-origin: top center;
    will-change: transform, filter;
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Seleccionamos todas las tarjetas para animarlas
  const cards = gsap.utils.toArray('.project-card');

  cards.forEach((card, index) => {
    // Animamos la tarjeta actual cuando la *siguiente* empiece a sobreponerse
    if (index < cards.length - 1) {
      const nextCard = cards[index + 1];
      
      gsap.to(card, {
        scale: 0.92,             // Se encoje un 8% hacia atrás
        filter: 'brightness(0.3)', // Se oscurece
        ease: 'none',
        scrollTrigger: {
          trigger: nextCard,
          start: 'top bottom',    // Cuando la SIGUIENTE carta entra por debajo
          end: 'top top+=120',    // Termina cuando la SIGUIENTE carta llega a su tope
          scrub: true,            // Vincula la animación al scroll suavemente
        }
      });
    }
  });
</script>
