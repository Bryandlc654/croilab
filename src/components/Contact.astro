---
import { site, whatsappLink } from '../data/site';
import Container from './ui/Container.astro';

const waLink = whatsappLink();
---

<section id="contacto" class="border-t border-black/10 bg-black">
  <Container class="py-24 lg:py-32">
    <div class="grid gap-16 lg:grid-cols-2">
      <div class="reveal-up">
        <div class="mb-8 flex items-center gap-4">
          <span class="h-px w-9 bg-accent"></span>
          <span class="text-[11px] font-medium uppercase tracking-[.24em] text-white/50">
            Contacto
          </span>
        </div>
        <h2
          class="text-[clamp(2.6rem,4.6vw,4.2rem)] font-semibold leading-[.95] tracking-[-.05em] text-white"
        >
          Hablemos de tu <span class="text-accent">próximo</span> crecimiento
        </h2>
        <p class="mt-8 max-w-md text-[15px] leading-7 text-white/50">
          Cuéntanos dónde está tu negocio hoy y hacia dónde quieres llevarlo. Respondemos en menos
          de 24 horas.
        </p>
      </div>

      <div class="flex flex-col gap-4">
        <a
          href={`mailto:${site.email}`}
          class="group flex items-center justify-between gap-6 rounded-2xl border border-white/10 p-6 transition duration-300 hover:border-accent"
        >
          <div>
            <div class="text-[10px] uppercase tracking-[.2em] text-white/40">Email</div>
            <div class="mt-2 text-base font-semibold text-white">{site.email}</div>
          </div>
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/15 text-white transition duration-300 group-hover:border-accent group-hover:bg-accent"
          >
            →
          </span>
        </a>

        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center justify-between gap-6 rounded-2xl border border-white/10 p-6 transition duration-300 hover:border-accent"
        >
          <div>
            <div class="text-[10px] uppercase tracking-[.2em] text-white/40">WhatsApp</div>
            <div class="mt-2 text-base font-semibold text-white">Respuesta inmediata</div>
          </div>
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/15 text-white transition duration-300 group-hover:border-accent group-hover:bg-accent"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
              <path
                d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.85 9.85 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.23 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43-.14-.01-.31-.01-.48-.01-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"
              ></path>
            </svg>
          </span>
        </a>

        <p class="mt-2 text-xs leading-5 text-white/35">
          Agenda una llamada o escríbenos por WhatsApp: sin compromiso.
        </p>
      </div>
    </div>
  </Container>
</section>
