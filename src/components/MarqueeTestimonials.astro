---
import Container from './ui/Container.astro';

export interface Testimonial {
  quote: string;
  name: string;
  role: string;
  rating: number;
}

export interface Props {
  testimonials: Testimonial[];
  kicker?: string;
  titleTop?: string;
  titleBottom?: string;
}

const { 
  testimonials, 
  kicker = "Testimonios de Clientes", 
  titleTop = "Resultados que", 
  titleBottom = "hablan por sí solos." 
} = Astro.props;

// Duplicate for marquee loop effect
const track1 = [...testimonials, ...testimonials];
const track2 = [...testimonials].reverse();
const track2Looped = [...track2, ...track2];
---

<section class="relative bg-white py-32 overflow-hidden border-y border-black/5">
  
  <!-- Efectos de Fondo y Luz -->
  <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.03)_1px,transparent_1px)] bg-[size:64px_64px] pointer-events-none"></div>
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-blue-500/10 rounded-full blur-[150px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-cyan-400/10 rounded-full blur-[150px] pointer-events-none"></div>

  <Container class="relative z-10 text-center mb-20">
    <div class="reveal-up inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-50 border border-blue-100 mb-6">
      <span class="text-[11px] font-bold uppercase tracking-widest text-blue-600">{kicker}</span>
    </div>
    <h2 class="gsap-title text-[clamp(2.5rem,5vw,4.5rem)] font-bold tracking-tight text-black leading-tight">
      {titleTop} <br/>
      <span class="italic font-serif font-light text-blue-600">{titleBottom}</span>
    </h2>
  </Container>

  <!-- Marquee Area -->
  <div class="relative w-full overflow-hidden flex flex-col gap-6 lg:gap-8 pb-10 perspective-1000">
    
    <!-- Track 1 (Left to Right) -->
    <div class="marquee-track flex w-max">
      <div class="flex gap-6 lg:gap-8 pr-6 lg:pr-8">
        {testimonials.map(t => (
          <div class="w-[320px] md:w-[400px] shrink-0 p-8 rounded-3xl bg-white border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] group">
            <div class="flex gap-1 mb-6 text-yellow-400">
              {[...Array(t.rating)].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              ))}
            </div>
            <p class="text-[16px] md:text-[18px] font-medium text-black/80 leading-relaxed mb-8">"{t.quote}"</p>
            <div class="flex items-center gap-4 mt-auto">
              <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-blue-600 to-cyan-400 flex items-center justify-center text-white font-bold text-sm shadow-lg group-hover:scale-110 transition-transform">
                {t.name.split(' ')[0][0]}{t.name.split(' ')[1]?.[0]}
              </div>
              <div>
                <div class="text-sm font-bold text-black">{t.name}</div>
                <div class="text-xs text-black/50">{t.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="flex gap-6 lg:gap-8 pr-6 lg:pr-8" aria-hidden="true">
        {testimonials.map(t => (
          <div class="w-[320px] md:w-[400px] shrink-0 p-8 rounded-3xl bg-white border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] group">
            <div class="flex gap-1 mb-6 text-yellow-400">
              {[...Array(t.rating)].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              ))}
            </div>
            <p class="text-[16px] md:text-[18px] font-medium text-black/80 leading-relaxed mb-8">"{t.quote}"</p>
            <div class="flex items-center gap-4 mt-auto">
              <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-blue-600 to-cyan-400 flex items-center justify-center text-white font-bold text-sm shadow-lg group-hover:scale-110 transition-transform">
                {t.name.split(' ')[0][0]}{t.name.split(' ')[1]?.[0]}
              </div>
              <div>
                <div class="text-sm font-bold text-black">{t.name}</div>
                <div class="text-xs text-black/50">{t.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Track 2 (Right to Left) -->
    <div class="marquee-track-reverse flex w-max mt-4">
      <div class="flex gap-6 lg:gap-8 pr-6 lg:pr-8">
        {track2.map(t => (
          <div class="w-[320px] md:w-[400px] shrink-0 p-8 rounded-3xl bg-white border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] group">
            <div class="flex gap-1 mb-6 text-yellow-400">
              {[...Array(t.rating)].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              ))}
            </div>
            <p class="text-[16px] md:text-[18px] font-medium text-black/80 leading-relaxed mb-8">"{t.quote}"</p>
            <div class="flex items-center gap-4 mt-auto">
              <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-blue-600 to-cyan-400 flex items-center justify-center text-white font-bold text-sm shadow-lg group-hover:scale-110 transition-transform">
                {t.name.split(' ')[0][0]}{t.name.split(' ')[1]?.[0]}
              </div>
              <div>
                <div class="text-sm font-bold text-black">{t.name}</div>
                <div class="text-xs text-black/50">{t.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="flex gap-6 lg:gap-8 pr-6 lg:pr-8" aria-hidden="true">
        {track2.map(t => (
          <div class="w-[320px] md:w-[400px] shrink-0 p-8 rounded-3xl bg-white border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] transition-all duration-300 hover:-translate-y-2 hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] group">
            <div class="flex gap-1 mb-6 text-yellow-400">
              {[...Array(t.rating)].map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              ))}
            </div>
            <p class="text-[16px] md:text-[18px] font-medium text-black/80 leading-relaxed mb-8">"{t.quote}"</p>
            <div class="flex items-center gap-4 mt-auto">
              <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-blue-600 to-cyan-400 flex items-center justify-center text-white font-bold text-sm shadow-lg group-hover:scale-110 transition-transform">
                {t.name.split(' ')[0][0]}{t.name.split(' ')[1]?.[0]}
              </div>
              <div>
                <div class="text-sm font-bold text-black">{t.name}</div>
                <div class="text-xs text-black/50">{t.role}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Fades en los bordes para un loop perfecto -->
    <div class="absolute inset-y-0 left-0 w-16 md:w-40 bg-gradient-to-r from-white to-transparent pointer-events-none z-10"></div>
    <div class="absolute inset-y-0 right-0 w-16 md:w-40 bg-gradient-to-l from-white to-transparent pointer-events-none z-10"></div>
  </div>

</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  
  @keyframes marquee-reverse {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  .marquee-track {
    animation: marquee 40s linear infinite;
  }
  
  .marquee-track-reverse {
    animation: marquee-reverse 45s linear infinite;
  }

  /* Pausar animación al hacer hover para leer la reseña */
  .marquee-track:hover,
  .marquee-track-reverse:hover {
    animation-play-state: paused;
  }
</style>
