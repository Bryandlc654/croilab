---
const navLinks = [
  { label: 'Proyectos', href: '/proyectos' },
  { label: 'Servicios', href: '/servicios' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Blog', href: '/blog' },
];
---

<header class="relative z-50">
  <div class="mx-auto flex max-w-[1400px] items-center justify-between px-6 py-6 lg:px-10">
    <a href="/" class="group flex items-center" aria-label="Croilab — inicio">
      <img
        src="/croilab-logo.svg"
        alt="Croilab"
        class="h-7 w-auto transition duration-300 group-hover:opacity-80 md:h-8"
        width="241"
        height="53"
      />
    </a>

    <nav class="hidden items-center gap-9 text-[13px] font-medium text-black/55 md:flex">
      {
        navLinks.map((link) => (
          <a href={link.href} class="transition hover:text-ink">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contacto" class="group hidden items-center gap-3 text-[13px] font-semibold md:flex">
        Contacto
        <span
          class="flex h-8 w-8 items-center justify-center rounded-full bg-black text-white transition duration-300 group-hover:bg-accent"
        >
          →
        </span>
      </a>

      <button
        id="menu-toggle"
        type="button"
        class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 rounded-full border border-black/10 md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <span class="block h-[2px] w-5 bg-ink"></span>
        <span class="block h-[2px] w-5 bg-ink"></span>
        <span class="block h-[2px] w-5 bg-ink"></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-black/10 bg-white px-6 pb-8 pt-2 md:hidden">
    <nav class="flex flex-col" aria-label="Menú móvil">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="border-b border-black/5 py-4 text-lg font-semibold tracking-tight text-black/70 transition hover:text-accent"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/contacto"
        class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-black px-6 py-3.5 text-[13px] font-semibold text-white transition duration-300 hover:bg-accent"
      >
        Contacto →
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.classList.toggle('is-open');
      menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
    });
  }
</script>
