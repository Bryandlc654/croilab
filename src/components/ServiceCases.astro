---
import Container from './ui/Container.astro';

const cases = [
  {
    client: "TechFlow Inc.",
    industry: "SaaS B2B",
    result: "+312%",
    metric: "En leads calificados (MQLs)",
    description: "Reestructuramos todo el ecosistema de conversión, desde los anuncios hasta la arquitectura web, logrando triplicar el pipeline de ventas en 4 meses.",
    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=2000&auto=format&fit=crop"
  },
  {
    client: "Aurora Fashion",
    industry: "Ecommerce",
    result: "5.8x",
    metric: "ROAS sostenido",
    description: "Implementamos ingeniería de conversión en su tienda Shopify. Redujimos el costo de adquisición a la mitad mientras escalábamos la inversión de manera rentable.",
    image: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=2000&auto=format&fit=crop"
  }
];
---

<section class="relative bg-[#f8f9fa] py-32 border-t border-black/5 overflow-hidden">
  <!-- Glowing effects -->
  <div class="absolute top-1/2 left-0 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[120px] -translate-y-1/2 pointer-events-none"></div>
  <div class="absolute top-1/2 right-0 w-[500px] h-[500px] bg-cyan-500/10 rounded-full blur-[120px] -translate-y-1/2 pointer-events-none"></div>
  
  <div class="grid-bg absolute inset-0 opacity-[0.03] pointer-events-none"></div>

  <Container class="relative z-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16">
      <div class="max-w-2xl reveal-up">
        <span class="text-[11px] font-bold uppercase tracking-[.25em] text-blue-500 mb-6 block">Casos de Éxito</span>
        <h2 class="text-[clamp(2.5rem,4vw,4rem)] font-bold tracking-tighter text-black leading-[1.05]">
          No vendemos humo.<br/>
          <span class="italic font-serif font-light text-black/40">Vendemos resultados.</span>
        </h2>
      </div>
      <a href="/proyectos" class="reveal-up group flex items-center gap-3 text-[14px] font-bold text-black transition-all hover:text-blue-500 pb-2">
        Ver todos los casos
        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-black/5 transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {cases.map((c) => (
        <div class="reveal-up group relative rounded-[2.5rem] bg-white border border-black/5 overflow-hidden flex flex-col hover:border-black/10 hover:shadow-[0_20px_50px_rgba(0,0,0,0.05)] transition-all duration-500">
          
          <!-- Image Top Half -->
          <div class="relative w-full h-[250px] overflow-hidden">
            <img 
              src={c.image} 
              alt={c.client} 
              class="w-full h-full object-cover opacity-80 mix-blend-multiply group-hover:scale-105 transition-all duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-white to-transparent"></div>
            
            <div class="absolute top-6 left-6">
              <div class="bg-white/80 backdrop-blur-md border border-black/5 rounded-full px-4 py-1.5 text-[11px] font-bold tracking-[.15em] uppercase text-black shadow-sm">
                {c.industry}
              </div>
            </div>
          </div>

          <!-- Content Bottom Half -->
          <div class="p-10 pt-0 flex-1 flex flex-col">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-6">
              <div>
                <div class="text-[11px] font-bold tracking-[.2em] text-black/30 uppercase mb-2">Cliente</div>
                <h3 class="text-2xl font-bold text-black tracking-tight">{c.client}</h3>
              </div>
              <div class="sm:text-right">
                <div class="text-[clamp(2.5rem,4vw,3.5rem)] font-bold text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 to-emerald-400 leading-none">{c.result}</div>
                <div class="text-[11px] font-bold tracking-widest text-black/40 uppercase mt-2">{c.metric}</div>
              </div>
            </div>
            <p class="text-[15px] leading-relaxed text-black/60">
              {c.description}
            </p>
          </div>

        </div>
      ))}
    </div>
  </Container>
</section>
