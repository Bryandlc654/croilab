---

---

<section id="hero" class="relative min-h-[calc(100vh-85px)] overflow-hidden bg-white">
  <!-- BACKGROUND -->
  <div class="grid-bg absolute inset-0"></div>
  <div class="blue-light right-[-100px] top-[100px]"></div>

  <!-- HERO -->
  <div
    class="relative z-20 mx-auto flex min-h-[calc(100vh-85px)] max-w-[1400px] items-center px-6 pb-20 pt-8 lg:px-10"
  >
    <div class="grid w-full items-center lg:grid-cols-[1.05fr_.95fr]">
      <!-- LEFT -->
      <div class="relative z-30">
        <div class="mb-8 flex items-center gap-4 animate-appear">
          <span class="h-px w-9 bg-accent"></span>
          <span class="text-[11px] font-medium uppercase tracking-[.24em] text-black/40">
            Laboratorio de conversiones
          </span>
        </div>

        <h1
          class="max-w-[850px] text-[clamp(4rem,7.2vw,7.8rem)] font-semibold leading-[.86] tracking-[-.075em]"
        >
          No diseñamos
          <span class="block text-black/20">páginas.</span>
          <span class="block">
            Creamos
            <span class="relative inline-block text-accent">
              conversiones
              <span class="absolute -right-3 top-1 h-2 w-2 rounded-full bg-accent animate-pulseSoft"
              ></span>
            </span>
          </span>
        </h1>

        <p class="mt-9 max-w-[580px] text-[15px] leading-7 text-black/50 md:text-[17px]">
          Diseñamos sistemas digitales donde estrategia, tecnología y adquisición trabajan juntos
          para transformar tráfico en clientes.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a
            href="#proyectos"
            class="group flex items-center gap-5 rounded-full bg-accent px-6 py-3.5 text-[13px] font-semibold text-white shadow-[0_10px_30px_rgba(8,120,249,.18)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_15px_40px_rgba(8,120,249,.25)]"
          >
            Ver proyectos
            <span
              class="flex h-7 w-7 items-center justify-center rounded-full bg-white/15 transition group-hover:bg-white group-hover:text-accent"
              >→</span
            >
          </a>
          <a
            href="#servicios"
            class="rounded-full px-4 py-3.5 text-[13px] font-medium text-black/50 transition hover:text-black"
          >
            Cómo trabajamos
            <span class="ml-2">↘</span>
          </a>
        </div>

        <div class="mt-16 flex max-w-[570px] border-t border-black/10 pt-6">
          <div class="w-1/3">
            <div class="text-[23px] font-semibold tracking-tight">+42%</div>
            <div class="mt-1 text-[10px] uppercase tracking-[.12em] text-black/35">Conversión</div>
          </div>
          <div class="w-1/3 border-l border-black/10 pl-7">
            <div class="text-[23px] font-semibold tracking-tight">3.8x</div>
            <div class="mt-1 text-[10px] uppercase tracking-[.12em] text-black/35">ROAS</div>
          </div>
          <div class="w-1/3 border-l border-black/10 pl-7">
            <div class="text-[23px] font-semibold tracking-tight">+18</div>
            <div class="mt-1 text-[10px] uppercase tracking-[.12em] text-black/35">Proyectos</div>
          </div>
        </div>
      </div>

      <!-- RIGHT VISUAL -->
      <div class="relative flex min-h-[520px] items-center justify-center lg:min-h-[650px]">
        <div class="blue-light animate-pulseSoft"></div>
        <div
          class="ring h-[320px] w-[320px] animate-spinSlow sm:h-[430px] sm:w-[430px] lg:h-[560px] lg:w-[560px]"
        >
        </div>
        <div class="ring h-[240px] w-[240px] sm:h-[340px] sm:w-[340px] lg:h-[430px] lg:w-[430px]">
        </div>
        <div
          class="dashed-ring absolute h-[200px] w-[200px] animate-spinSlow sm:h-[280px] sm:w-[280px] lg:h-[350px] lg:w-[350px]"
        >
        </div>
        <div id="orb" class="z-10 transition-transform duration-300 ease-out">
          <div class="orb animate-float"></div>
        </div>

        <div
          class="absolute z-20 flex h-[90px] w-[90px] items-center justify-center rounded-full border border-white/70 bg-white/50 shadow-xl backdrop-blur-md"
        >
          <div
            class="h-3 w-3 rounded-full bg-accent shadow-[0_0_25px_rgba(8,120,249,.8)] animate-pulse"
          >
          </div>
        </div>

        <div
          class="floating-card absolute left-[2%] top-[15%] z-30 w-[190px] rounded-2xl p-4 animate-floatSlow"
        >
          <div class="flex items-center justify-between">
            <span class="text-[10px] uppercase tracking-[.15em] text-black/35">Conversion</span>
            <span class="text-[11px] font-semibold text-accent">+128%</span>
          </div>
          <div class="mt-5 flex items-end gap-[5px]">
            <span class="h-5 w-2 rounded-full bg-black/10"></span>
            <span class="h-8 w-2 rounded-full bg-black/10"></span>
            <span class="h-11 w-2 rounded-full bg-black/15"></span>
            <span class="h-14 w-2 rounded-full bg-accent/50"></span>
            <span class="h-20 w-2 rounded-full bg-accent"></span>
          </div>
        </div>

        <div
          class="floating-card absolute bottom-[15%] right-[0%] z-30 w-[205px] rounded-2xl p-4 animate-float"
        >
          <div class="flex items-center gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 text-accent">
              ↗
            </div>
            <div>
              <div class="text-[10px] uppercase tracking-[.12em] text-black/35">Tráfico</div>
              <div class="mt-0.5 text-sm font-semibold">84.2K</div>
            </div>
          </div>
          <div class="mt-4 h-[3px] overflow-hidden rounded-full bg-black/5">
            <div class="h-full w-[75%] rounded-full bg-accent animate-lineMove"></div>
          </div>
        </div>

        <div
          class="absolute right-[4%] top-[23%] hidden rounded-full border border-black/10 bg-white/80 px-4 py-2 text-[9px] font-medium uppercase tracking-[.2em] text-black/40 shadow-lg backdrop-blur-md md:block"
        >
          SEO · ADS · ECOMMERCE
        </div>

        <div class="absolute left-[12%] top-[40%] h-2 w-2 rounded-full bg-accent"></div>
        <div class="absolute right-[18%] bottom-[38%] h-1.5 w-1.5 rounded-full bg-black/30"></div>
      </div>
    </div>
  </div>

  <!-- BOTTOM BAR -->
  <div
    class="absolute bottom-0 left-0 right-0 border-t border-black/10 bg-white/70 backdrop-blur-xl"
  >
    <div class="mx-auto flex max-w-[1400px] items-center justify-between px-6 py-4 lg:px-10">
      <span class="text-[9px] font-medium uppercase tracking-[.25em] text-black/30">
        Digital conversion laboratory
      </span>
      <div class="flex items-center gap-2 text-[10px] text-black/40">
        <span class="h-1.5 w-1.5 rounded-full bg-accent animate-pulse"></span>
        Disponible para nuevos proyectos
      </div>
    </div>
  </div>
</section>

<script>
  // Parallax del orb (transform en el wrapper para no chocar con animate-float)
  const hero = document.getElementById('hero');
  const orb = document.getElementById('orb');

  if (hero && orb) {
    hero.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 18;
      const y = (e.clientY / window.innerHeight - 0.5) * 18;
      orb.style.transform = `translate3d(${x}px, ${y}px, 0)`;
    });
  }
</script>
