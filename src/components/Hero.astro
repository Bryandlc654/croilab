  person:
    '<path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  bag: '<path d="M6 8h12l-1.2 10a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  spark: '<path d="M12 3l2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2Z"/>',
  trend: '<path d="M3 17l5-6 4 3 6-8"/><path d="M14 6h5v5"/>',
  search:
    '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>',
  leaf: '<path d="M4 20C4 10 10 4 20 4 20 14 14 20 4 20Z"/><path d="M4 20C8 14 12 10 16 7"/>',
  dress:
    '<path d="M8 3l1 5-4 3 3 10h8l3-10-4-3 1-5-2 2h-4Z"/><path d="M9 12h6"/>',
};
---

<style>
/* From Uiverse.io by dexter-st */ 
.loader-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 1000px;
  height: 1000px;
  border-radius: 50%;
  background-color: transparent;
  user-select: none;
}

.loader {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 50%;
  background-color: transparent;
  animation: loader-rotate 8s linear infinite;
  z-index: 0;
}

@keyframes loader-rotate {
  0% {
    transform: rotate(90deg);
    box-shadow:
      0 10px 20px 0 rgba(100, 200, 255, 0.5) inset, 
      0 20px 50px 0 rgba(8, 120, 249, 0.7) inset,
      0 60px 80px 0 rgba(0, 84, 186, 0.9) inset;
  }
  50% {
    transform: rotate(270deg);
    box-shadow:
      0 10px 20px 0 rgba(8, 120, 249, 0.5) inset,
      0 20px 50px 0 rgba(100, 200, 255, 0.7) inset,
      0 40px 80px 0 rgba(0, 84, 186, 0.9) inset;
  }
  100% {
    transform: rotate(450deg);
    box-shadow:
      0 10px 20px 0 rgba(100, 200, 255, 0.5) inset, 
      0 20px 50px 0 rgba(8, 120, 249, 0.7) inset,
      0 60px 80px 0 rgba(0, 84, 186, 0.9) inset;
  }
}

.noise-overlay {
  position: absolute;
  inset: 0;
  z-index: 10;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  opacity: 0.04;
  mix-blend-mode: overlay;
}
</style>

<section id="hero" class="relative min-h-screen overflow-hidden bg-[#090909] text-white">
  <!-- BACKGROUND ANIMATION (X shape with 2 circles) -->
  <div class="absolute inset-0 z-0 flex flex-col items-center justify-center opacity-90 mix-blend-screen">
    <div class="loader-wrapper -translate-y-[670px]">
      <div class="loader border border-white/30"></div>
    </div>
    <div class="loader-wrapper">
      <div class="loader border border-white/30"></div>
    </div>
  </div>

  <!-- GRID & TEXTURES -->
  <div class="grid-bg-invert absolute inset-0 opacity-15"></div>
  <div class="noise-overlay"></div>

  <!-- HERO CONTENT -->
  <div class="relative z-20 mx-auto flex min-h-screen max-w-[1400px] items-center px-6 pb-16 pt-56 lg:px-10 lg:pb-20">
    <div class="w-full flex flex-col items-center text-center">
        <h1 class="title-reveal max-w-[850px] text-[clamp(4rem,7.2vw,7.8rem)] font-semibold leading-[.86] tracking-[-.075em] text-white">
          No diseñamos
          <span class="block text-white/40 font-serif italic font-normal">páginas.</span>
          <span class="block">
            Creamos
            <span class="relative inline-block text-white font-serif italic font-normal">
              conversiones
              <span class="absolute -right-3 top-1 h-2 w-2 rounded-full bg-white animate-pulseSoft"></span>
            </span>
          </span>
        </h1>

        <p class="mt-9 max-w-[580px] text-[15px] leading-7 text-white/60 md:text-[17px]">
          Diseñamos sistemas digitales donde estrategia, tecnología y adquisición trabajan juntos
          para transformar tráfico en clientes.
        </p>

        <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
          <a
            href="#proyectos"
            class="group flex items-center gap-5 rounded-full bg-white px-6 py-3.5 text-[13px] font-semibold text-[#090909] shadow-[0_10px_30px_rgba(255,255,255,.18)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_15px_40px_rgba(255,255,255,.25)]"
          >
            Ver proyectos
            <span
              class="flex h-7 w-7 items-center justify-center rounded-full bg-[#090909]/15 transition group-hover:bg-[#090909] group-hover:text-white"
              >→</span
            >
          </a>
          <a
            href="#servicios"
            class="rounded-full px-4 py-3.5 text-[13px] font-medium text-white/60 transition hover:text-white"
          >
            Cómo trabajamos
            <span class="ml-2">↘</span>
          </a>
        </div>
      </div>
  </div>
</section>
