---
import Container from './ui/Container.astro';

const steps = [
  {
    num: "01",
    title: "Auditoría & Estrategia",
    desc: "Definimos una hoja de ruta enfocada 100% en aumentar tu rentabilidad y conversiones.",
    mockup: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=1000&auto=format&fit=crop",
    imageAlt: "Mockup de dashboard de métricas",
    color: "from-blue-500 to-cyan-400"
  },
  {
    num: "02",
    title: "UX & Copywriting",
    desc: "Estructuramos la información y escribimos textos persuasivos que atacan los puntos de dolor.",
    mockup: "https://images.unsplash.com/photo-1618761714954-0b8cd0026356?q=80&w=1000&auto=format&fit=crop",
    imageAlt: "Mockup de wireframes",
    color: "from-emerald-400 to-teal-400"
  },
  {
    num: "03",
    title: "Diseño UI Premium",
    desc: "Aplicamos una capa visual de alta gama que posiciona tu marca como líder indiscutible del sector.",
    mockup: "https://images.unsplash.com/photo-1561070791-2526d30994b5?q=80&w=1000&auto=format&fit=crop",
    imageAlt: "Diseño UI visual atractivo",
    color: "from-purple-500 to-pink-500"
  },
  {
    num: "04",
    title: "Desarrollo Headless",
    desc: "Programamos tu web con Astro.js y React para lograr tiempos de carga menores a 1 segundo.",
    mockup: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?q=80&w=1000&auto=format&fit=crop",
    imageAlt: "Mockup de código",
    color: "from-orange-500 to-yellow-400"
  },
  {
    num: "05",
    title: "QA & Testing",
    desc: "Auditoría técnica exhaustiva en todos los dispositivos para garantizar cero fallos antes de salir en vivo.",
    mockup: "https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?q=80&w=1000&auto=format&fit=crop",
    imageAlt: "Mockup de testing",
    color: "from-red-500 to-rose-400"
  },
  {
    num: "06",
    title: "Lanzamiento & CRO",
    desc: "Publicamos la web y comenzamos a medir con mapas de calor para optimizar continuamente la conversión.",
    mockup: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=1000&auto=format&fit=crop",
    imageAlt: "Mockup de resultados",
    color: "from-indigo-500 to-blue-500"
  }
];
---

<section class="relative bg-white py-32 overflow-hidden border-t border-black/5">
  <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.03)_1px,transparent_1px)] bg-[size:64px_64px] pointer-events-none"></div>

  <Container class="relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal-up">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-50 border border-blue-100 mb-6">
        <span class="text-[11px] font-bold uppercase tracking-widest text-blue-600">Nuestro Sistema</span>
      </div>
      <h2 class="text-[clamp(2.5rem,4vw,3.5rem)] font-bold tracking-tight text-black leading-tight mb-6">
        Un proceso diseñado <br/>
        <span class="italic font-serif font-light text-blue-600">para no fallar.</span>
      </h2>
      <p class="text-lg text-black/60">
        Dejamos la improvisación para los amateurs. Cada fase de nuestro desarrollo está calculada para convertir clics en clientes reales.
      </p>
    </div>

    <!-- Grid 3x2 -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 pb-20">
      {steps.map((step, index) => (
        <div class="group bg-[#f8f9fa] border border-black/5 p-6 rounded-[2rem] reveal-up hover:-translate-y-2 transition-transform duration-500 shadow-sm hover:shadow-xl" style={`--delay: ${index * 0.1}s;`}>
          <!-- Contenedor del mockup -->
          <div class="relative w-full aspect-[4/3] rounded-[1.5rem] overflow-hidden mb-8 perspective-1000 border border-black/10 bg-white p-2">
            <div class="absolute inset-0 bg-gradient-to-tr from-black/5 to-transparent rounded-[1.5rem] transform rotate-3 scale-105 opacity-0 group-hover:opacity-100 transition-all duration-700 pointer-events-none z-0"></div>
            
            <div class="w-full h-full rounded-xl overflow-hidden relative z-10 shadow-sm transform group-hover:-rotate-y-6 group-hover:rotate-x-6 group-hover:scale-105 transition-transform duration-700">
              <div class="shimmer-effect absolute inset-0 z-20 pointer-events-none opacity-0 group-hover:opacity-100"></div>
              <img src={step.mockup} alt={step.imageAlt} class="w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-1000" />
            </div>

            <!-- Flotante -->
            <div class="absolute -top-3 -right-3 w-12 h-12 bg-white rounded-xl shadow-lg border border-black/5 flex items-center justify-center animate-float z-20" style={`animation-delay: ${index * 0.2}s;`}>
              <div class={`w-6 h-6 rounded-full bg-gradient-to-br ${step.color} opacity-20 absolute`}></div>
              <span class="text-xs font-black text-black relative z-10">{step.num}</span>
            </div>
          </div>
          
          <!-- Text Box -->
          <div class="text-left px-2">
            <h3 class="text-xl font-bold text-black mb-3 group-hover:text-blue-600 transition-colors">{step.title}</h3>
            <p class="text-sm text-black/60 leading-relaxed">
              {step.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Mini CTA dentro de la sección de Proceso -->
    <div class="mt-4 mx-auto max-w-4xl bg-black rounded-[2.5rem] p-12 text-center relative overflow-hidden reveal-up">
      <!-- Glows -->
      <div class="absolute top-1/2 left-0 w-64 h-64 bg-blue-500/30 rounded-full blur-[80px] -translate-y-1/2 pointer-events-none"></div>
      <div class="absolute top-1/2 right-0 w-64 h-64 bg-cyan-400/30 rounded-full blur-[80px] -translate-y-1/2 pointer-events-none"></div>
      
      <div class="relative z-10">
        <h3 class="text-3xl font-bold text-white mb-4">¿Listo para iniciar este proceso?</h3>
        <p class="text-white/70 mb-8 max-w-xl mx-auto">No pierdas más tiempo ni dinero en estrategias que no te traen clientes reales. Agenda tu sesión de diagnóstico hoy.</p>
        <a href="/contacto" class="inline-flex items-center justify-center bg-white text-black font-bold px-8 py-4 rounded-full transition-transform hover:scale-105 shadow-[0_10px_30px_rgba(255,255,255,0.2)]">
          Quiero trabajar con ustedes
        </a>
      </div>
    </div>
  </Container>
</section>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  
  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
  
  .shimmer-effect {
    background: linear-gradient(
      105deg,
      transparent 20%,
      rgba(255, 255, 255, 0.4) 50%,
      transparent 80%
    );
    background-size: 200% auto;
    animation: shimmer 2s infinite linear;
    mix-blend-mode: overlay;
  }
  
  @keyframes shimmer {
    0% { background-position: 200% center; }
    100% { background-position: -200% center; }
  }
</style>
