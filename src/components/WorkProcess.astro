---
import Container from './ui/Container.astro';

const steps = [
  {
    id: "auditoria",
    num: "01",
    title: "Auditoría & Estrategia",
    desc: "Definimos una hoja de ruta enfocada 100% en aumentar tu rentabilidad y conversiones.",
    color: "from-blue-500 to-cyan-400"
  },
  {
    id: "ux",
    num: "02",
    title: "UX & Copywriting",
    desc: "Estructuramos la información y escribimos textos persuasivos que atacan los puntos de dolor.",
    color: "from-emerald-400 to-teal-400"
  },
  {
    id: "ui",
    num: "03",
    title: "Diseño UI Premium",
    desc: "Aplicamos una capa visual de alta gama que posiciona tu marca como líder indiscutible del sector.",
    color: "from-purple-500 to-pink-500"
  },
  {
    id: "dev",
    num: "04",
    title: "Desarrollo Headless",
    desc: "Programamos tu web con Astro.js y React para lograr tiempos de carga menores a 1 segundo.",
    color: "from-orange-500 to-yellow-400"
  },
  {
    id: "qa",
    num: "05",
    title: "QA & Testing",
    desc: "Auditoría técnica exhaustiva en todos los dispositivos para garantizar cero fallos antes de salir en vivo.",
    color: "from-red-500 to-rose-400"
  },
  {
    id: "cro",
    num: "06",
    title: "Lanzamiento & CRO",
    desc: "Publicamos la web y comenzamos a medir con mapas de calor para optimizar continuamente la conversión.",
    color: "from-indigo-500 to-blue-500"
  }
];
---

<section class="relative bg-white py-32 overflow-hidden border-t border-black/5">
  <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.03)_1px,transparent_1px)] bg-[size:64px_64px] pointer-events-none"></div>

  <Container class="relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal-up">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-50 border border-blue-100 mb-6">
        <span class="text-[11px] font-bold uppercase tracking-widest text-blue-600">Nuestro Sistema</span>
      </div>
      <h2 class="text-[clamp(2.5rem,4vw,3.5rem)] font-bold tracking-tight text-black leading-tight mb-6">
        Un proceso diseñado <br/>
        <span class="italic font-serif font-light text-blue-600">para no fallar.</span>
      </h2>
      <p class="text-lg text-black/60">
        Dejamos la improvisación para los amateurs. Cada fase de nuestro desarrollo está calculada para convertir clics en clientes reales.
      </p>
    </div>

    <!-- Grid 3x2 -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 pb-20">
      {steps.map((step, index) => (
        <div class="group bg-[#f8f9fa] border border-black/5 p-6 rounded-[2rem] reveal-up hover:-translate-y-2 transition-transform duration-500 shadow-sm hover:shadow-xl flex flex-col h-full" style={`--delay: ${index * 0.1}s;`}>
          <!-- Contenedor del mockup -->
          <div class="relative w-full aspect-[4/3] rounded-[1.5rem] overflow-hidden mb-8 perspective-1000 border border-black/10 bg-white p-2 flex-shrink-0">
            <div class="absolute inset-0 bg-gradient-to-tr from-black/5 to-transparent rounded-[1.5rem] transform rotate-3 scale-105 opacity-0 group-hover:opacity-100 transition-all duration-700 pointer-events-none z-0"></div>
            
            <div class={`w-full h-full rounded-xl overflow-hidden relative z-10 shadow-[inset_0_0_20px_rgba(0,0,0,0.05)] transform group-hover:-rotate-y-6 group-hover:rotate-x-6 group-hover:scale-[1.02] transition-transform duration-700 flex items-center justify-center bg-gradient-to-br ${step.color} p-4`}>
              <div class="shimmer-effect absolute inset-0 z-20 pointer-events-none opacity-0 group-hover:opacity-100 mix-blend-overlay"></div>
              
              <!-- MOCKUPS HTML CUSTOM -->
              <div class="w-full h-full bg-white/10 backdrop-blur-md rounded-lg border border-white/20 p-3 shadow-xl relative overflow-hidden flex flex-col group-hover:scale-105 transition-transform duration-700">
                <!-- Mac header dot -->
                <div class="flex gap-1 mb-3">
                  <div class="w-2 h-2 rounded-full bg-white/40"></div>
                  <div class="w-2 h-2 rounded-full bg-white/40"></div>
                  <div class="w-2 h-2 rounded-full bg-white/40"></div>
                </div>

                {step.id === 'auditoria' && (
                  <div class="flex-1 flex flex-col justify-end relative">
                    <div class="flex justify-between items-end h-full gap-2 px-1">
                      {[40, 55, 45, 70, 60, 95].map((h, i) => (
                        <div class="w-full bg-white/20 rounded-t-sm relative group-hover:bg-white/40 transition-colors" style={`height: ${h}%; transition-delay: ${i * 0.1}s`}></div>
                      ))}
                    </div>
                    <svg class="absolute top-1/4 left-0 w-full h-1/2 drop-shadow-[0_0_8px_rgba(255,255,255,0.8)]" preserveAspectRatio="none" viewBox="0 0 100 100">
                      <path d="M0 80 Q 20 70, 40 50 T 80 20 L 100 0" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="dash-anim"/>
                    </svg>
                  </div>
                )}

                {step.id === 'ux' && (
                  <div class="flex-1 flex flex-col gap-2">
                    <div class="w-2/3 h-4 bg-white/30 rounded-md"></div>
                    <div class="w-full h-16 bg-white/10 border border-white/20 rounded-md border-dashed flex items-center justify-center">
                      <div class="w-8 h-8 rounded-full bg-white/20"></div>
                    </div>
                    <div class="grid grid-cols-2 gap-2 flex-1">
                      <div class="bg-white/10 border border-white/20 rounded-md border-dashed"></div>
                      <div class="bg-white/10 border border-white/20 rounded-md border-dashed"></div>
                    </div>
                  </div>
                )}

                {step.id === 'ui' && (
                  <div class="flex-1 flex items-center justify-center relative">
                    <div class="absolute -top-4 -right-4 w-16 h-16 bg-white/20 rounded-full blur-xl"></div>
                    <div class="w-full h-full bg-gradient-to-tr from-white/10 to-white/30 border border-white/40 rounded-lg p-3 shadow-2xl flex flex-col gap-3 justify-center items-center">
                      <div class="w-12 h-12 rounded-full bg-white/40 mb-1 shadow-[0_0_15px_rgba(255,255,255,0.5)]"></div>
                      <div class="w-3/4 h-3 bg-white/50 rounded-full"></div>
                      <div class="w-1/2 h-2 bg-white/30 rounded-full"></div>
                      <div class="mt-2 w-full h-6 bg-white rounded-full text-[8px] font-bold text-black flex items-center justify-center">Buy Now</div>
                    </div>
                  </div>
                )}

                {step.id === 'dev' && (
                  <div class="flex-1 font-mono text-[8px] leading-relaxed text-white/80 overflow-hidden flex flex-col justify-center">
                    <div class="text-white/40">{'<script setup>'}</div>
                    <div class="pl-2">
                      <span class="text-pink-300">import</span> {'{ ref }'} <span class="text-pink-300">from</span> <span class="text-green-300">'vue'</span><br/>
                      <span class="text-blue-300">const</span> speed = ref(<span class="text-orange-300">100</span>)<br/>
                      <span class="text-blue-300">function</span> <span class="text-yellow-300">optimize</span>() {'{'}
                    </div>
                    <div class="pl-4">
                      return <span class="text-green-300">'Lightning Fast!'</span>
                    </div>
                    <div class="pl-2">{'}'}</div>
                    <div class="text-white/40">{'</script>'}</div>
                  </div>
                )}

                {step.id === 'qa' && (
                  <div class="flex-1 flex flex-col gap-2 justify-center">
                    {[1,2,3].map((item, i) => (
                      <div class="w-full bg-white/10 rounded border border-white/20 p-2 flex items-center gap-2">
                        <div class="w-4 h-4 rounded-full bg-green-400 flex items-center justify-center">
                          <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        </div>
                        <div class="flex-1">
                          <div class="w-1/2 h-1.5 bg-white/40 rounded-full mb-1"></div>
                          <div class="w-1/3 h-1 bg-white/20 rounded-full"></div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {step.id === 'cro' && (
                  <div class="flex-1 relative overflow-hidden rounded-md border border-white/20 bg-white/10">
                    <!-- Website skeleton -->
                    <div class="w-full h-8 bg-white/20 border-b border-white/10"></div>
                    <div class="w-1/2 h-12 bg-white/10 mt-2 mx-auto rounded"></div>
                    <div class="w-24 h-6 bg-white/30 mt-2 mx-auto rounded-full"></div>
                    
                    <!-- Heatmap overlays -->
                    <div class="absolute top-1/2 left-1/2 w-16 h-16 bg-red-500/60 blur-xl rounded-full mix-blend-screen animate-pulse"></div>
                    <div class="absolute top-1/4 right-1/4 w-12 h-12 bg-yellow-400/60 blur-lg rounded-full mix-blend-screen animate-pulse" style="animation-delay: 1s"></div>
                  </div>
                )}
              </div>
            </div>

            <!-- Flotante -->
            <div class="absolute -top-3 -right-3 w-12 h-12 bg-white rounded-xl shadow-lg border border-black/5 flex items-center justify-center animate-float z-20" style={`animation-delay: ${index * 0.2}s;`}>
              <div class={`w-6 h-6 rounded-full bg-gradient-to-br ${step.color} opacity-20 absolute`}></div>
              <span class="text-xs font-black text-black relative z-10">{step.num}</span>
            </div>
          </div>
          
          <!-- Text Box -->
          <div class="text-left px-2 flex-1 flex flex-col">
            <h3 class="text-xl font-bold text-black mb-3 group-hover:text-blue-600 transition-colors">{step.title}</h3>
            <p class="text-sm text-black/60 leading-relaxed flex-1">
              {step.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Mini CTA dentro de la sección de Proceso -->
    <div class="mt-4 mx-auto max-w-4xl bg-black rounded-[2.5rem] p-12 text-center relative overflow-hidden reveal-up">
      <!-- Glows -->
      <div class="absolute top-1/2 left-0 w-64 h-64 bg-blue-500/30 rounded-full blur-[80px] -translate-y-1/2 pointer-events-none"></div>
      <div class="absolute top-1/2 right-0 w-64 h-64 bg-cyan-400/30 rounded-full blur-[80px] -translate-y-1/2 pointer-events-none"></div>
      
      <div class="relative z-10">
        <h3 class="text-3xl font-bold text-white mb-4">¿Listo para iniciar este proceso?</h3>
        <p class="text-white/70 mb-8 max-w-xl mx-auto">No pierdas más tiempo ni dinero en estrategias que no te traen clientes reales. Agenda tu sesión de diagnóstico hoy.</p>
        <a href="/contacto" class="inline-flex items-center justify-center bg-white text-black font-bold px-8 py-4 rounded-full transition-transform hover:scale-105 shadow-[0_10px_30px_rgba(255,255,255,0.2)]">
          Quiero trabajar con ustedes
        </a>
      </div>
    </div>
  </Container>
</section>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  
  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
  
  .shimmer-effect {
    background: linear-gradient(
      105deg,
      transparent 20%,
      rgba(255, 255, 255, 0.4) 50%,
      transparent 80%
    );
    background-size: 200% auto;
    animation: shimmer 2s infinite linear;
    mix-blend-mode: overlay;
  }
  
  @keyframes shimmer {
    0% { background-position: 200% center; }
    100% { background-position: -200% center; }
  }
  
  .dash-anim {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: dash 3s ease-out forwards infinite;
  }
  
  @keyframes dash {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
