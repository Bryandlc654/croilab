---
import Container from './ui/Container.astro';

const steps = [
  {
    id: "auditoria",
    num: "01",
    title: "Auditoría & Estrategia",
    desc: "Definimos una hoja de ruta enfocada 100% en aumentar tu rentabilidad y conversiones.",
    color: "from-blue-600 to-cyan-400"
  },
  {
    id: "ux",
    num: "02",
    title: "UX & Copywriting",
    desc: "Estructuramos la información y escribimos textos persuasivos que atacan los puntos de dolor.",
    color: "from-blue-600 to-cyan-400"
  },
  {
    id: "ui",
    num: "03",
    title: "Diseño UI Premium",
    desc: "Aplicamos una capa visual de alta gama que posiciona tu marca como líder indiscutible del sector.",
    color: "from-blue-600 to-cyan-400"
  },
  {
    id: "dev",
    num: "04",
    title: "Desarrollo Headless",
    desc: "Programamos tu web con Astro.js y React para lograr tiempos de carga menores a 1 segundo.",
    color: "from-blue-600 to-cyan-400"
  },
  {
    id: "qa",
    num: "05",
    title: "QA & Testing",
    desc: "Auditoría técnica exhaustiva en todos los dispositivos para garantizar cero fallos antes de salir en vivo.",
    color: "from-blue-600 to-cyan-400"
  },
  {
    id: "cro",
    num: "06",
    title: "Lanzamiento & CRO",
    desc: "Publicamos la web y comenzamos a medir con mapas de calor para optimizar continuamente la conversión.",
    color: "from-blue-600 to-cyan-400"
  }
];
---

<section class="relative bg-white py-32 overflow-hidden border-t border-black/5">
  <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.03)_1px,transparent_1px)] bg-[size:64px_64px] pointer-events-none"></div>

  <Container class="relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-20 reveal-up">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-50 border border-blue-100 mb-6">
        <span class="text-[11px] font-bold uppercase tracking-widest text-blue-600">Nuestro Sistema</span>
      </div>
      <h2 class="text-[clamp(2.5rem,4vw,3.5rem)] font-bold tracking-tight text-black leading-tight mb-6">
        Un proceso diseñado <br/>
        <span class="italic font-serif font-light text-blue-600">para no fallar.</span>
      </h2>
      <p class="text-lg text-black/60">
        Dejamos la improvisación para los amateurs. Cada fase de nuestro desarrollo está calculada para convertir clics en clientes reales.
      </p>
    </div>

    <!-- Grid 3x2 sin cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16 pb-20">
      {steps.map((step, index) => (
        <div class="group reveal-up flex flex-col h-full" style={`--delay: ${index * 0.1}s;`}>
          <!-- Contenedor del mockup -->
          <div class="relative w-full aspect-[4/3] rounded-[1.5rem] overflow-hidden mb-8 perspective-1000 border border-black/10 bg-white p-2 flex-shrink-0">
            <div class="absolute inset-0 bg-gradient-to-tr from-black/5 to-transparent rounded-[1.5rem] transform rotate-3 scale-105 opacity-0 group-hover:opacity-100 transition-all duration-700 pointer-events-none z-0"></div>
            
            <div class="w-full h-full rounded-xl overflow-hidden relative z-10 shadow-[inset_0_0_20px_rgba(0,0,0,0.05)] transform group-hover:-rotate-y-6 group-hover:rotate-x-6 group-hover:scale-[1.02] transition-transform duration-700 flex items-center justify-center bg-slate-50 p-4">
              <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.02)_1px,transparent_1px)] bg-[size:20px_20px] pointer-events-none"></div>
              <div class="shimmer-effect absolute inset-0 z-20 pointer-events-none opacity-0 group-hover:opacity-100 mix-blend-overlay"></div>
              
              <!-- MOCKUPS HTML CUSTOM -->
              <div class="w-full h-full backdrop-blur-md rounded-lg p-3 relative overflow-hidden flex flex-col group-hover:scale-105 transition-transform duration-700 bg-white border border-gray-200 shadow-[0_10px_30px_rgba(0,0,0,0.05)]">
                <!-- Mac header dot -->
                <div class="flex gap-1.5 mb-4 relative z-20">
                  <div class="w-2 h-2 rounded-full bg-gray-200"></div>
                  <div class="w-2 h-2 rounded-full bg-gray-200"></div>
                  <div class="w-2 h-2 rounded-full bg-gray-200"></div>
                </div>

                <!-- 1. Auditoría (High-End SaaS Widget) -->
                {step.id === 'auditoria' && (
                  <div class="flex-1 flex flex-col justify-between relative bg-white rounded-lg shadow-sm border border-gray-100 p-3 overflow-hidden">
                    <!-- Top Stats -->
                    <div class="flex justify-between items-start z-10 relative">
                      <div>
                        <div class="text-[8px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Conversión</div>
                        <div class="text-2xl font-black text-gray-900 leading-none">4.2%</div>
                      </div>
                      <div class="bg-emerald-50 text-emerald-600 font-bold text-[8px] px-1.5 py-0.5 rounded flex items-center gap-0.5 shadow-sm border border-emerald-100">
                        <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
                        +124%
                      </div>
                    </div>
                    
                    <!-- Decorative Circle in background -->
                    <div class="absolute -right-4 top-2 w-16 h-16 rounded-full border-[4px] border-gray-50 flex items-center justify-center z-0">
                      <div class="w-10 h-10 rounded-full border-[3px] border-blue-50 border-t-blue-500 transform -rotate-45 group-hover:rotate-[315deg] transition-transform duration-1000 ease-out"></div>
                    </div>

                    <!-- Smooth Line Chart -->
                    <div class="absolute bottom-0 left-0 w-full h-[55%] z-10">
                      <svg class="w-full h-full" preserveAspectRatio="none" viewBox="0 0 100 100">
                        <!-- Gradient Fill -->
                        <linearGradient id="chartGrad" x1="0" y1="0" x2="0" y2="1">
                          <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.25" />
                          <stop offset="100%" stop-color="#3b82f6" stop-opacity="0" />
                        </linearGradient>
                        <path d="M0,100 C20,80 30,90 50,60 C70,30 80,40 100,15 L100,100 Z" fill="url(#chartGrad)" class="opacity-0 group-hover:opacity-100 transition-opacity duration-700"/>
                        <!-- Curved Line -->
                        <path d="M0,100 C20,80 30,90 50,60 C70,30 80,40 100,15" fill="none" stroke="#2563eb" stroke-width="3" stroke-linecap="round" class="dash-anim drop-shadow-[0_4px_4px_rgba(37,99,235,0.4)]"/>
                        <!-- Target Dot -->
                        <circle cx="100" cy="15" r="4" fill="white" stroke="#2563eb" stroke-width="2" class="opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-500"/>
                        <circle cx="100" cy="15" r="8" fill="#3b82f6" class="opacity-0 group-hover:opacity-30 transition-opacity duration-500 delay-500 animate-ping"/>
                        <!-- Dotted Guide Line -->
                        <line x1="100" y1="15" x2="100" y2="100" stroke="#94a3b8" stroke-width="1" stroke-dasharray="2 2" class="opacity-0 group-hover:opacity-60 transition-opacity duration-500 delay-500"/>
                      </svg>
                    </div>
                  </div>
                )}

                <!-- 2. UX & Copywriting (Wireframe Figma Style) -->
                {step.id === 'ux' && (
                  <div class="flex-1 flex flex-col relative w-full h-full bg-white rounded-lg shadow-sm border border-gray-100 p-2 overflow-hidden">
                    <!-- Figma Toolbar -->
                    <div class="absolute top-2 left-1/2 -translate-x-1/2 bg-gray-900 rounded-full px-3 py-1.5 flex gap-2 items-center shadow-lg z-20">
                      <div class="w-3 h-3 border-2 border-white/50 rounded-sm"></div>
                      <div class="w-3 h-3 text-white/50 flex items-center justify-center">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5v14"/></svg>
                      </div>
                      <div class="text-[10px] font-bold text-white/50 font-serif">T</div>
                    </div>
                    
                    <!-- Web Wireframe -->
                    <div class="mt-7 mx-auto w-[92%] h-full bg-gray-50 border border-gray-200 rounded-t-lg p-2.5 relative group-hover:bg-blue-50/30 transition-colors duration-500">
                      <!-- Grid guidelines -->
                      <div class="absolute inset-0 flex justify-between px-3 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-1000">
                        <div class="w-px h-full bg-blue-200/50"></div>
                        <div class="w-px h-full bg-blue-200/50"></div>
                        <div class="w-px h-full bg-blue-200/50"></div>
                        <div class="w-px h-full bg-blue-200/50"></div>
                      </div>
                      
                      <div class="w-full flex gap-2 h-full">
                        <!-- Left: Text -->
                        <div class="flex-1 flex flex-col gap-1.5 pt-2 relative z-10">
                          <div class="w-full h-3 bg-gray-300 rounded group-hover:bg-blue-300 transition-colors duration-500"></div>
                          <div class="w-2/3 h-3 bg-gray-300 rounded group-hover:bg-blue-300 transition-colors duration-500"></div>
                          <div class="w-full h-1.5 bg-gray-200 rounded mt-1.5"></div>
                          <div class="w-5/6 h-1.5 bg-gray-200 rounded"></div>
                          <div class="w-1/2 h-4 bg-gray-900 rounded mt-1.5 group-hover:bg-blue-600 transition-colors duration-500 shadow-sm"></div>
                        </div>
                        <!-- Right: Image placeholder -->
                        <div class="flex-1 bg-white border-2 border-dashed border-gray-300 rounded-md relative flex items-center justify-center group-hover:border-blue-400 group-hover:bg-blue-50 transition-colors duration-500">
                          <svg class="w-5 h-5 text-gray-300 group-hover:text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                          
                          <!-- Cursor Arrow appearing on hover -->
                          <div class="absolute bottom-1 right-1 opacity-0 group-hover:opacity-100 transform translate-y-4 group-hover:translate-y-0 transition-all duration-700 delay-300 z-30">
                            <svg class="w-6 h-6 text-black" viewBox="0 0 24 24" fill="currentColor"><path d="M4 2v20l5.5-5.5H18z" stroke="white" stroke-width="1.5"/></svg>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                <!-- 3. UI Premium (Light) -->
                {step.id === 'ui' && (
                  <div class="flex-1 relative overflow-hidden bg-gradient-to-br from-white to-blue-50/60 rounded-lg border border-gray-100 shadow-[0_10px_40px_rgba(59,130,246,0.10)]">
                    <!-- decorative glows -->
                    <div class="absolute -top-6 -right-6 w-20 h-20 bg-blue-500/20 rounded-full blur-2xl"></div>
                    <div class="absolute -bottom-6 -left-6 w-16 h-16 bg-cyan-400/20 rounded-full blur-2xl"></div>

                    <!-- Mini Nav -->
                    <div class="relative z-10 flex items-center justify-between px-3 py-2 border-b border-gray-100 bg-white/80 backdrop-blur-sm">
                      <div class="flex items-center gap-1.5">
                        <div class="w-4 h-4 rounded-md bg-gradient-to-tr from-blue-600 to-cyan-400 shadow-[0_0_10px_rgba(59,130,246,0.4)]"></div>
                        <div class="w-6 h-1.5 bg-gray-900 rounded-full"></div>
                      </div>
                      <div class="flex items-center gap-1.5">
                        <div class="w-5 h-1.5 bg-black/20 rounded-full"></div>
                        <div class="w-5 h-1.5 bg-black/20 rounded-full"></div>
                        <div class="w-8 h-3.5 bg-gradient-to-r from-blue-600 to-cyan-500 rounded-full shadow-sm"></div>
                      </div>
                    </div>

                    <!-- Hero -->
                    <div class="relative z-10 px-3 pt-3 pb-2">
                      <div class="flex items-center gap-1 mb-1.5">
                        <div class="w-8 h-1.5 rounded-full bg-blue-600"></div>
                        <div class="w-5 h-1.5 rounded-full bg-blue-200"></div>
                      </div>
                      <div class="flex items-center gap-1 mb-2">
                        <div class="w-10 h-1.5 rounded-full bg-black/70"></div>
                        <div class="w-7 h-1.5 rounded-full bg-black/40"></div>
                      </div>
                      <div class="flex items-center gap-1.5 mb-2.5">
                        <div class="w-9 h-3 rounded-full bg-gradient-to-r from-blue-600 to-cyan-500 shadow-[0_2px_8px_rgba(59,130,246,0.35)]"></div>
                        <div class="w-7 h-3 rounded-full bg-black/10"></div>
                      </div>

                      <!-- Feature card row -->
                      <div class="grid grid-cols-2 gap-1.5">
                        <div class="bg-white rounded-md border border-gray-100 p-1.5 shadow-[0_4px_14px_rgba(0,0,0,0.04)]">
                          <div class="w-4 h-4 rounded-full bg-gradient-to-tr from-blue-500 to-cyan-400 mb-1"></div>
                          <div class="w-8 h-1 bg-black/60 rounded-full mb-1"></div>
                          <div class="w-6 h-1 bg-black/20 rounded-full"></div>
                        </div>
                        <div class="bg-white rounded-md border border-gray-100 p-1.5 shadow-[0_4px_14px_rgba(0,0,0,0.04)]">
                          <div class="flex items-center justify-between mb-1">
                            <div class="text-[8px] font-black text-gray-900 leading-none">+45%</div>
                            <div class="w-3 h-1.5 rounded-full bg-emerald-100"></div>
                          </div>
                          <div class="w-6 h-1 bg-black/30 rounded-full mb-1"></div>
                          <div class="flex items-end gap-0.5 h-3">
                            <div class="flex-1 h-1 bg-blue-200 rounded-sm"></div>
                            <div class="flex-1 h-2 bg-blue-300 rounded-sm"></div>
                            <div class="flex-1 h-1.5 bg-blue-400 rounded-sm"></div>
                            <div class="flex-1 h-3 bg-blue-600 rounded-sm"></div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                <!-- 4. Dev (Light - Code Editor) -->
                {step.id === 'dev' && (
                  <div class="flex-1 flex flex-col relative overflow-hidden rounded-lg border border-gray-200 bg-gray-50">
                    <!-- Editor top bar -->
                    <div class="flex items-center justify-between px-3 py-2 bg-gray-900 border-b border-gray-800">
                      <div class="flex items-center gap-1.5">
                        <div class="w-2 h-2 rounded-full bg-red-400"></div>
                        <div class="w-2 h-2 rounded-full bg-yellow-400"></div>
                        <div class="w-2 h-2 rounded-full bg-green-400"></div>
                      </div>
                      <div class="flex items-center gap-1.5">
                        <div class="w-10 h-1.5 bg-white/20 rounded-full"></div>
                        <div class="w-4 h-3 rounded bg-gradient-to-r from-blue-500 to-cyan-400"></div>
                      </div>
                    </div>
                    <!-- Code lines -->
                    <div class="flex-1 p-3 font-mono text-[9px] leading-relaxed text-gray-700 overflow-hidden">
                      <div class="flex gap-2"><span class="text-gray-300">1</span><span><span class="text-pink-500">import</span> <span class="text-gray-800">{'{'} ref {'}'}</span> <span class="text-pink-500">from</span> <span class="text-emerald-600">'vue'</span></span></div>
                      <div class="flex gap-2"><span class="text-gray-300">2</span><span><span class="text-blue-500">const</span> perf = ref(<span class="text-orange-500">99</span>)</span></div>
                      <div class="flex gap-2"><span class="text-gray-300">3</span><span><span class="text-blue-500">function</span> <span class="text-yellow-500">build</span>() {'{'}</span></div>
                      <div class="flex gap-2 pl-4"><span class="text-gray-300">4</span><span><span class="text-blue-500">return</span> <span class="text-emerald-600">'Blazing Fast'</span></span></div>
                      <div class="flex gap-2"><span class="text-gray-300">5</span><span>{'}'}</span></div>
                      <div class="flex gap-2"><span class="text-gray-300">6</span><span class="text-gray-500">build()</span></div>
                    </div>
                    <!-- loading bar -->
                    <div class="px-3 pb-2">
                      <div class="w-full h-1 bg-gray-200 rounded-full overflow-hidden">
                        <div class="h-full w-2/3 bg-gradient-to-r from-blue-500 to-cyan-400 rounded-full group-hover:w-full transition-all duration-1000"></div>
                      </div>
                    </div>
                  </div>
                )}

                <!-- 5. QA (Light - Test Checklist) -->
                {step.id === 'qa' && (
                  <div class="flex-1 flex flex-col gap-2 justify-center">
                    {[
                      { title: "w-2/3", sub: "w-1/3", done: true },
                      { title: "w-1/2", sub: "w-1/4", done: true },
                      { title: "w-3/4", sub: "w-1/2", done: false }
                    ].map((item, i) => (
                      <div class="w-full bg-gray-50 rounded-md border border-gray-200 p-2 flex items-center gap-2 group-hover:bg-blue-50/50 group-hover:border-blue-100 transition-colors" style={`transition-delay: ${i * 0.1}s`}>
                        <div class={`w-4 h-4 rounded-full flex items-center justify-center shrink-0 ${item.done ? 'bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.3)]' : 'bg-gray-200'}`}>
                          {item.done && (
                            <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                          )}
                        </div>
                        <div class="flex-1">
                          <div class={`${item.title} h-1.5 bg-gray-300 rounded-full mb-1 group-hover:bg-blue-300 transition-colors`}></div>
                          <div class={`${item.sub} h-1 bg-gray-200 rounded-full group-hover:bg-blue-200 transition-colors`}></div>
                        </div>
                        <div class="text-[8px] font-bold uppercase tracking-wide ${item.done ? 'text-emerald-500' : 'text-gray-400'}">Ok</div>
                      </div>
                    ))}
                    <!-- Pass badge -->
                    <div class="flex items-center gap-1.5 px-2">
                      <div class="px-2 py-0.5 rounded-full bg-emerald-50 border border-emerald-100 text-[8px] font-bold text-emerald-600">Pasó</div>
                      <div class="px-2 py-0.5 rounded-full bg-gray-50 border border-gray-200 text-[8px] font-bold text-gray-400">Pendiente</div>
                    </div>
                  </div>
                )}

                <!-- 6. CRO (Light - Heatmap Analytics) -->
                {step.id === 'cro' && (
                  <div class="flex-1 relative overflow-hidden rounded-lg border border-gray-200 bg-gray-50">
                    <!-- Mini top bar -->
                    <div class="w-full h-6 bg-gray-100 border-b border-gray-200 flex items-center px-2 gap-1.5">
                      <div class="flex gap-1">
                        <div class="w-1.5 h-1.5 rounded-full bg-gray-300"></div>
                        <div class="w-1.5 h-1.5 rounded-full bg-gray-300"></div>
                        <div class="w-1.5 h-1.5 rounded-full bg-gray-300"></div>
                      </div>
                      <div class="mx-auto w-16 h-2 bg-gray-200 rounded-full"></div>
                    </div>
                    <!-- Page skeleton -->
                    <div class="w-3/4 h-6 bg-gray-200 mt-3 mx-auto rounded"></div>
                    <div class="w-1/3 h-2.5 bg-blue-100 mt-1.5 mx-auto rounded-full"></div>
                    <div class="grid grid-cols-2 gap-2 mt-3 px-4">
                      <div class="h-10 bg-white rounded border border-gray-200"></div>
                      <div class="h-10 bg-white rounded border border-gray-200"></div>
                    </div>
                    
                    <!-- Heatmap overlays -->
                    <div class="absolute top-[42%] left-1/2 w-16 h-16 bg-red-400/60 blur-xl rounded-full mix-blend-multiply animate-pulse"></div>
                    <div class="absolute top-[30%] right-1/4 w-12 h-12 bg-yellow-400/60 blur-lg rounded-full mix-blend-multiply animate-pulse" style="animation-delay: 1s"></div>
                    <div class="absolute bottom-[10%] left-1/4 w-10 h-10 bg-blue-500/50 blur-lg rounded-full mix-blend-multiply animate-pulse" style="animation-delay: 0.5s"></div>
                    
                    <!-- Conversion badge -->
                    <div class="absolute bottom-3 left-1/2 -translate-x-1/2 px-3 py-1 rounded-full bg-white border border-gray-200 shadow-sm flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                      <span class="text-[8px] font-bold text-gray-700">+32% CRO</span>
                    </div>
                  </div>
                )}
              </div>
            </div>

            <!-- Flotante -->
            <div class="absolute -top-3 -right-3 w-12 h-12 bg-white rounded-xl shadow-lg border border-black/5 flex items-center justify-center animate-float z-20" style={`animation-delay: ${index * 0.2}s;`}>
              <div class={`w-6 h-6 rounded-full bg-gradient-to-br ${step.color} opacity-20 absolute`}></div>
              <span class="text-xs font-black text-black relative z-10">{step.num}</span>
            </div>
          </div>
          
          <!-- Text Box -->
          <div class="text-left flex-1 flex flex-col">
            <h3 class="text-xl font-bold text-black mb-3 group-hover:text-blue-600 transition-colors">{step.title}</h3>
            <p class="text-sm text-black/60 leading-relaxed flex-1">
              {step.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Mini CTA dentro de la sección de Proceso -->
    <div class="mt-4 mx-auto max-w-4xl bg-black rounded-[2.5rem] p-12 text-center relative overflow-hidden reveal-up">
      <!-- Glows -->
      <div class="absolute top-1/2 left-0 w-64 h-64 bg-blue-500/30 rounded-full blur-[80px] -translate-y-1/2 pointer-events-none"></div>
      <div class="absolute top-1/2 right-0 w-64 h-64 bg-cyan-400/30 rounded-full blur-[80px] -translate-y-1/2 pointer-events-none"></div>
      
      <div class="relative z-10">
        <h3 class="text-3xl font-bold text-white mb-4">¿Listo para iniciar este proceso?</h3>
        <p class="text-white/70 mb-8 max-w-xl mx-auto">No pierdas más tiempo ni dinero en estrategias que no te traen clientes reales. Empieza con el primer paso hoy.</p>
        <a href="/contacto" class="inline-flex items-center justify-center bg-white text-black font-bold px-8 py-4 rounded-full transition-transform hover:scale-105 shadow-[0_10px_30px_rgba(255,255,255,0.2)]">
          Quiero trabajar con ustedes
        </a>
      </div>
    </div>
  </Container>
</section>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }
  
  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
  
  .shimmer-effect {
    background: linear-gradient(
      105deg,
      transparent 20%,
      rgba(255, 255, 255, 0.4) 50%,
      transparent 80%
    );
    background-size: 200% auto;
    animation: shimmer 2s infinite linear;
    mix-blend-mode: overlay;
  }
  
  @keyframes shimmer {
    0% { background-position: 200% center; }
    100% { background-position: -200% center; }
  }
  
  .dash-anim {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: dash 3s ease-out forwards infinite;
