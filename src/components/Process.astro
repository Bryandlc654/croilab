---
import { processSteps } from '../data/process';
import Container from './ui/Container.astro';
import SectionTitle from './ui/SectionTitle.astro';
---

<section class="border-t border-black/10 bg-white">
  <Container class="py-24 lg:py-32">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <SectionTitle
        kicker="Proceso"
        description="Un método claro de cuatro fases: sin vueltas, con medición constante."
      >
        Cómo <span class="text-accent">trabajamos</span>
      </SectionTitle>
      <div class="mb-2 flex items-center gap-4">
        <span class="h-px w-10 bg-accent"></span>
        <span class="text-[11px] font-medium uppercase tracking-[.24em] text-muted">04 fases</span>
      </div>
    </div>

    <!-- LÍNEA DE TIEMPO -->
    <div class="relative mt-16">
      <div
        class="absolute inset-x-0 top-5 hidden h-px bg-black/10 lg:block"
        aria-hidden="true"
      ></div>
      <ol class="grid gap-12 lg:grid-cols-4 lg:gap-8">
        {
          processSteps.map((step, i) => (
            <li class="reveal-up relative" style={`--i:${i}`}>
              <div
                class="relative z-10 flex h-10 w-10 items-center justify-center rounded-full border border-black/10 bg-white text-xs font-semibold text-ink transition-colors duration-300 hover:border-accent hover:bg-accent hover:text-white"
              >
                {step.num}
              </div>
              <h3 class="mt-6 text-lg font-semibold tracking-tight text-ink">{step.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Container>
</section>
