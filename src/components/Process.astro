---
import { processSteps } from '../data/process';
import Container from './ui/Container.astro';
import SectionTitle from './ui/SectionTitle.astro';
---

<section class="relative overflow-hidden border-t border-black/10 bg-[#f4f9ff]">
  <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
  <div class="blue-light -top-48 right-[-8%] opacity-80" aria-hidden="true"></div>

  <Container class="relative z-10 py-24 lg:py-32">
    <!-- HEADER -->
    <div class="reveal-up flex flex-wrap items-end justify-between gap-10">
      <SectionTitle
        kicker="Proceso"
        description="Un método claro de cuatro fases: sin vueltas, con medición constante."
      >
        Cómo <span class="text-accent">trabajamos</span>
      </SectionTitle>

      <!-- CONTADOR CIRCULAR -->
      <div class="relative hidden h-32 w-32 shrink-0 items-center justify-center md:flex" aria-hidden="true">
        <svg viewBox="0 0 100 100" class="absolute inset-0 h-full w-full">
          <circle cx="50" cy="50" r="44" fill="none" stroke="rgba(0,0,0,0.08)" stroke-width="1.5" />
          <circle
            cx="50"
            cy="50"
            r="44"
            fill="none"
            stroke="var(--color-accent)"
            stroke-width="1.5"
            stroke-dasharray="276.4"
            stroke-linecap="round"
            transform="rotate(-90 50 50)"
          />
          <circle
            cx="94"
            cy="50"
            r="3.5"
            fill="var(--color-accent)"
            class="animate-spinSlow"
            style="transform-box: view-box; transform-origin: 50px 50px"
          />
        </svg>
        <div class="text-center">
          <span class="block text-3xl font-semibold leading-none tracking-tight text-ink">04</span>
          <span class="mt-1.5 block text-[10px] uppercase tracking-[.18em] text-muted">fases</span>
        </div>
      </div>
    </div>

    <!-- CIRCUITO -->
    <div class="mt-16 lg:mt-24">
      <!-- PISTA DE NODOS -->
      <div class="relative h-28 lg:h-32" aria-hidden="true">
        <svg
          class="absolute inset-0 h-full w-full"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
        >
          <path
            d="M 12.5 35 C 25 35, 25 65, 37.5 65 C 50 65, 50 35, 62.5 35 C 75 35, 75 65, 87.5 65"
            fill="none"
            stroke="rgba(0,0,0,0.1)"
            stroke-width="1"
            vector-effect="non-scaling-stroke"
          />
          <path
            d="M 12.5 35 C 25 35, 25 65, 37.5 65 C 50 65, 50 35, 62.5 35 C 75 35, 75 65, 87.5 65"
            fill="none"
            stroke="var(--color-accent)"
            stroke-width="2"
            stroke-linecap="round"
            vector-effect="non-scaling-stroke"
            pathLength="1"
            stroke-dasharray="0.02 0.02"
            class="animate-dash"
          />
        </svg>

        {processSteps.map((step, i) => (
          <div
            class="absolute z-10 flex h-14 w-14 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-accent/30 bg-white text-sm font-semibold text-ink shadow-[0_8px_24px_rgba(8,120,249,0.15)] transition-colors duration-300 hover:border-accent hover:bg-accent hover:text-white"
            style={`left:${i * 25 + 12.5}%; top:${i % 2 === 0 ? 35 : 65}%`}
          >
            {step.num}
          </div>
        ))}

        <span
          class="animate-pulseSoft absolute h-20 w-20 rounded-full border border-accent/40"
          style="left: calc(12.5% - 40px); top: calc(35% - 40px)"
        ></span>
      </div>

      <!-- TARJETAS -->
      <div class="grid gap-12 pt-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8 lg:pt-14">
        {processSteps.map((step, i) => (
          <div
            class="reveal-up group relative border-t border-black/10 pt-6 transition-colors duration-300 hover:border-accent"
            style={`--i:${i}`}
          >
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -top-6 right-0 select-none text-6xl font-semibold leading-none tracking-tighter text-black/[.05] transition-colors duration-300 group-hover:text-accent/15"
            >
              {step.num}
            </span>
            <h3 class="text-lg font-semibold tracking-tight text-ink">{step.title}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{step.description}</p>
            <span
              class="mt-6 block h-px w-8 bg-black/10 transition-all duration-300 group-hover:w-14 group-hover:bg-accent"
            ></span>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>
