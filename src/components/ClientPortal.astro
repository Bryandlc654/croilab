---
import Container from './ui/Container.astro';
---

<section class="relative overflow-hidden border-t border-black/10 bg-[#090909] text-white">
  <div class="grid-bg absolute inset-0 opacity-10" aria-hidden="true"></div>

  <!-- Glow decorativo -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-blue-500/10 rounded-full blur-[120px] pointer-events-none" aria-hidden="true"></div>

  <Container class="relative z-10 py-24 lg:py-36">
    <!-- CABECERA -->
    <div class="reveal-up max-w-[700px]">
      <div class="mb-8 flex items-center gap-4">
        <span class="h-px w-9 bg-blue-500"></span>
        <span class="text-[11px] font-medium uppercase tracking-[.24em] text-white/40">Portal del Cliente</span>
        <span class="h-px w-24 bg-white/10"></span>
      </div>
      <h2 class="text-[clamp(2.6rem,5vw,4.5rem)] font-semibold leading-[.92] tracking-[-.055em]">
        <span class="block text-white/15">Transparencia total.</span>
        <span class="block text-white">Control en tiempo real.</span>
      </h2>
      <p class="mt-8 max-w-lg text-[15px] leading-7 text-white/45">
        Cada cliente tiene acceso a un panel exclusivo donde puede seguir el avance de cada tarea, revisar entregables y gestionar tickets de soporte sin depender de emails o llamadas.
      </p>
    </div>

    <!-- MOCKUP: PORTAL DEL CLIENTE -->
    <div class="reveal-up mt-20 lg:mt-28 relative" style="--i:1">

      <!-- Reflejo superior del terminal -->
      <div class="absolute top-0 left-[10%] right-[10%] h-[1px] bg-gradient-to-r from-transparent via-white/20 to-transparent z-20"></div>

      <!-- Browser chrome -->
      <div class="rounded-t-2xl border border-b-0 border-white/10 bg-white/[0.03] backdrop-blur-xl px-5 py-4 flex items-center gap-3">
        <span class="h-3 w-3 rounded-full bg-red-500/70"></span>
        <span class="h-3 w-3 rounded-full bg-yellow-500/70"></span>
        <span class="h-3 w-3 rounded-full bg-green-500/70"></span>
        <div class="ml-4 flex-1 rounded-lg bg-white/5 border border-white/5 px-4 py-1.5 text-[11px] text-white/30 font-mono">
          portal.croilab.com/dashboard
        </div>
      </div>

      <!-- Portal Content -->
      <div class="rounded-b-2xl border border-t-0 border-white/10 bg-[#0d0d0d] backdrop-blur-xl overflow-hidden">
        <div class="flex flex-col lg:flex-row">

          <!-- SIDEBAR -->
          <div class="hidden lg:flex flex-col w-[220px] border-r border-white/5 bg-white/[0.01] p-5 gap-1">
            <div class="flex items-center gap-2.5 mb-6">
              <div class="w-8 h-8 rounded-lg bg-blue-500/20 flex items-center justify-center">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
              </div>
              <span class="text-[12px] font-bold text-white">Croilab</span>
            </div>

            <a href="#" class="flex items-center gap-2.5 px-3 py-2 rounded-lg bg-white/5 text-[12px] font-medium text-white transition">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              Dashboard
            </a>
            <a href="#" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[12px] font-medium text-white/40 hover:text-white/70 hover:bg-white/5 transition">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
              Tareas
            </a>
            <a href="#" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[12px] font-medium text-white/40 hover:text-white/70 hover:bg-white/5 transition">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Tickets
            </a>
            <a href="#" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-[12px] font-medium text-white/40 hover:text-white/70 hover:bg-white/5 transition">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
              Config
            </a>
          </div>

          <!-- MAIN CONTENT -->
          <div class="flex-1 p-6 lg:p-8">

            <!-- Header del dashboard -->
            <div class="flex items-center justify-between mb-8">
              <div>
                <h3 class="text-[16px] font-bold text-white">Dashboard</h3>
                <p class="text-[12px] text-white/30 mt-0.5">Proyecto: Ecommerce Premium</p>
              </div>
              <div class="flex items-center gap-2">
                <span class="px-3 py-1 rounded-full bg-green-500/10 border border-green-500/20 text-[10px] font-semibold text-green-400 uppercase tracking-wider">Activo</span>
              </div>
            </div>

            <!-- Stats row -->
            <div class="grid grid-cols-3 gap-4 mb-8">
              <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
                <div class="text-[10px] text-white/30 uppercase tracking-wider mb-1">Tareas Completadas</div>
                <div class="text-[22px] font-bold text-white">18 <span class="text-[12px] text-white/30 font-normal">/ 24</span></div>
              </div>
              <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
                <div class="text-[10px] text-white/30 uppercase tracking-wider mb-1">Tickets Abiertos</div>
                <div class="text-[22px] font-bold text-white">2</div>
              </div>
              <div class="rounded-xl border border-white/5 bg-white/[0.02] p-4">
                <div class="text-[10px] text-white/30 uppercase tracking-wider mb-1">Progreso General</div>
                <div class="text-[22px] font-bold text-blue-400">75%</div>
              </div>
            </div>

            <!-- Tab: Tareas recientes -->
            <div class="mb-6">
              <h4 class="text-[11px] font-bold uppercase tracking-wider text-white/40 mb-4">Tareas Recientes</h4>
              <div class="space-y-2">
                <div class="flex items-center gap-3 rounded-xl border border-white/5 bg-white/[0.02] px-4 py-3">
                  <div class="w-5 h-5 rounded-full border-2 border-green-500 flex items-center justify-center flex-shrink-0">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-green-500"><polyline points="20 6 9 17 4 12"/></svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-[12px] font-medium text-white truncate">Diseño de Landing Page</div>
                    <div class="text-[10px] text-white/30">Completado hace 2 dias</div>
                  </div>
                  <span class="px-2 py-0.5 rounded-full bg-green-500/10 text-[9px] font-semibold text-green-400 uppercase">Hecho</span>
                </div>
                <div class="flex items-center gap-3 rounded-xl border border-blue-500/20 bg-blue-500/5 px-4 py-3">
                  <div class="w-5 h-5 rounded-full border-2 border-blue-500 flex items-center justify-center flex-shrink-0">
                    <div class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></div>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-[12px] font-medium text-white truncate">Configuracion de Meta Ads</div>
                    <div class="text-[10px] text-white/30">En progreso - 60%</div>
                  </div>
                  <span class="px-2 py-0.5 rounded-full bg-blue-500/10 text-[9px] font-semibold text-blue-400 uppercase">Activo</span>
                </div>
                <div class="flex items-center gap-3 rounded-xl border border-white/5 bg-white/[0.02] px-4 py-3">
                  <div class="w-5 h-5 rounded-full border-2 border-white/20 flex items-center justify-center flex-shrink-0"></div>
                  <div class="flex-1 min-w-0">
                    <div class="text-[12px] font-medium text-white/60 truncate">Implementacion de Pixel</div>
                    <div class="text-[10px] text-white/30">Pendiente</div>
                  </div>
                  <span class="px-2 py-0.5 rounded-full bg-white/5 text-[9px] font-semibold text-white/30 uppercase">Pendiente</span>
                </div>
              </div>
            </div>

            <!-- Tab: Tickets de soporte -->
            <div>
              <div class="flex items-center justify-between mb-4">
                <h4 class="text-[11px] font-bold uppercase tracking-wider text-white/40">Tickets de Soporte</h4>
                <span class="text-[10px] text-blue-400 font-medium cursor-pointer hover:text-blue-300 transition">+ Nuevo ticket</span>
              </div>
              <div class="space-y-2">
                <div class="flex items-center gap-3 rounded-xl border border-white/5 bg-white/[0.02] px-4 py-3">
                  <div class="w-2 h-2 rounded-full bg-yellow-400 flex-shrink-0"></div>
                  <div class="flex-1 min-w-0">
                    <div class="text-[12px] font-medium text-white truncate">Error en formulario de contacto</div>
                    <div class="text-[10px] text-white/30">Ticket #1042 - Abierto hace 4h</div>
                  </div>
                  <span class="px-2 py-0.5 rounded-full bg-yellow-500/10 text-[9px] font-semibold text-yellow-400 uppercase">En revision</span>
                </div>
                <div class="flex items-center gap-3 rounded-xl border border-white/5 bg-white/[0.02] px-4 py-3">
                  <div class="w-2 h-2 rounded-full bg-green-400 flex-shrink-0"></div>
                  <div class="flex-1 min-w-0">
                    <div class="text-[12px] font-medium text-white truncate">Solicitud de cambio de copy</div>
                    <div class="text-[10px] text-white/30">Ticket #1039 - Resuelto</div>
                  </div>
                  <span class="px-2 py-0.5 rounded-full bg-green-500/10 text-[9px] font-semibold text-green-400 uppercase">Resuelto</span>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Glow sutil debajo del mockup -->
      <div class="absolute -bottom-20 left-1/2 -translate-x-1/2 w-[60%] h-[100px] bg-blue-500/10 blur-[80px] pointer-events-none" aria-hidden="true"></div>

    </div>

    <!-- FEATURES LIST -->
    <div class="reveal-up mt-16 grid grid-cols-1 sm:grid-cols-3 gap-6" style="--i:2">
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        </div>
        <div>
          <h4 class="text-[13px] font-bold text-white">Seguimiento en tiempo real</h4>
          <p class="text-[12px] text-white/35 leading-relaxed mt-1">Visualiza el progreso de cada tarea asignada al instante.</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div>
          <h4 class="text-[13px] font-bold text-white">Tickets de soporte</h4>
          <p class="text-[12px] text-white/35 leading-relaxed mt-1">Abre, gestiona y resuelve incidencias sin salir del panel.</p>
        </div>
      </div>
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-blue-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
          <h4 class="text-[13px] font-bold text-white">Colaboracion directa</h4>
          <p class="text-[12px] text-white/35 leading-relaxed mt-1">Comunica cambios y feedback en un solo lugar.</p>
        </div>
      </div>
    </div>

  </Container>
</section>
