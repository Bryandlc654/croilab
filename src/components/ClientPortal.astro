---
import Container from './ui/Container.astro';
---

<section class="relative overflow-hidden border-t border-black/10 bg-[#050505] text-white py-32 lg:py-48">
  <div class="grid-bg absolute inset-0 opacity-[0.03]" aria-hidden="true"></div>

  <!-- Luces volumétricas -->
  <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-blue-600/10 rounded-full blur-[150px] pointer-events-none" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-indigo-500/10 rounded-full blur-[120px] pointer-events-none" aria-hidden="true"></div>

  <Container class="relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.5fr] gap-16 lg:gap-20 items-center">
      
      <!-- COPY -->
      <div class="reveal-up">
        <div class="mb-8 flex items-center gap-4">
          <span class="h-px w-9 bg-blue-500"></span>
          <span class="text-[11px] font-semibold uppercase tracking-[.25em] text-blue-400">Portal de Clientes</span>
        </div>
        <h2 class="text-[clamp(2.5rem,4vw,3.5rem)] font-bold leading-[1.1] tracking-tight mb-8">
          Transparencia absoluta. <br/>
          <span class="italic font-serif font-normal text-white/50">Control en tiempo real.</span>
        </h2>
        <p class="text-[16px] leading-relaxed text-white/60 mb-12">
          Olvídate de los hilos de correo interminables y las agencias que desaparecen. Te damos acceso a un <strong>entorno operativo exclusivo</strong> donde ves el código subido, las campañas activas y el ROI en tiempo real.
        </p>

        <!-- FEATURES LIST -->
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center flex-shrink-0 mt-1">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <div>
              <h4 class="text-[15px] font-bold text-white mb-1">Métricas en Vivo</h4>
              <p class="text-[14px] text-white/50 leading-relaxed">Conexión directa a GA4 y Meta Ads. Tus KPIs sin filtros.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center flex-shrink-0 mt-1">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <div>
              <h4 class="text-[15px] font-bold text-white mb-1">Gestión de Tareas (Kanban)</h4>
              <p class="text-[14px] text-white/50 leading-relaxed">Aprueba diseños, solicita cambios y ve en qué estamos trabajando hoy.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center flex-shrink-0 mt-1">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-400"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <div>
              <h4 class="text-[15px] font-bold text-white mb-1">Repositorio de Entregables</h4>
              <p class="text-[14px] text-white/50 leading-relaxed">Todos tus assets, copys, y reportes mensuales a un clic de distancia.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- MOCKUP: PORTAL DEL CLIENTE (SaaS STYLE) -->
      <div class="reveal-up relative" style="--i:1">
        <!-- Borde Gradiente -->
        <div class="absolute -inset-[1px] rounded-[2rem] bg-gradient-to-b from-white/20 via-white/5 to-transparent z-0 pointer-events-none"></div>
        
        <div class="relative z-10 flex flex-col rounded-[2rem] bg-[#0A0A0B] overflow-hidden shadow-[0_0_50px_rgba(0,0,0,0.5)]">
          <!-- Browser chrome -->
          <div class="flex items-center gap-3 px-6 py-4 border-b border-white/5 bg-white/[0.02]">
            <div class="flex gap-2">
              <span class="h-3 w-3 rounded-full bg-[#FF5F56]"></span>
              <span class="h-3 w-3 rounded-full bg-[#FFBD2E]"></span>
              <span class="h-3 w-3 rounded-full bg-[#27C93F]"></span>
            </div>
            <div class="mx-auto flex h-7 items-center justify-center rounded-md bg-white/5 px-6 text-[11px] font-mono text-white/30 border border-white/5">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 opacity-50"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              app.croilab.com
            </div>
          </div>

          <!-- Dashboard Layout -->
          <div class="flex flex-col md:flex-row h-full">
            <!-- Sidebar -->
            <div class="hidden md:flex flex-col w-[200px] border-r border-white/5 bg-[#0F0F11] p-4 gap-1">
              <div class="flex items-center gap-3 mb-8 px-2 mt-2">
                <div class="w-7 h-7 rounded-md bg-blue-500 flex items-center justify-center shadow-[0_0_15px_rgba(59,130,246,0.5)]">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-white"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                </div>
                <span class="text-[13px] font-bold text-white tracking-wide">Croilab</span>
              </div>

              <div class="text-[10px] font-bold text-white/30 uppercase tracking-wider mb-2 px-2">Menu</div>
              <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg bg-blue-500/10 text-blue-400 text-[12px] font-medium border border-blue-500/20">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                Overview
              </a>
              <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg text-white/50 hover:text-white hover:bg-white/5 text-[12px] font-medium transition-colors">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Sprint Board
              </a>
              <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg text-white/50 hover:text-white hover:bg-white/5 text-[12px] font-medium transition-colors">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/></svg>
                Analytics
              </a>
              <a href="#" class="flex items-center gap-3 px-3 py-2 rounded-lg text-white/50 hover:text-white hover:bg-white/5 text-[12px] font-medium transition-colors">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                Assets
              </a>

              <div class="mt-auto pt-4 border-t border-white/5">
                <div class="flex items-center gap-3 px-2">
                  <div class="w-8 h-8 rounded-full bg-white/10 overflow-hidden">
                    <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?q=80&w=100&auto=format&fit=crop" class="w-full h-full object-cover grayscale opacity-80" alt="User">
                  </div>
                  <div>
                    <div class="text-[11px] font-bold text-white">Acme Corp.</div>
                    <div class="text-[9px] text-white/40">Plan Enterprise</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Main Area -->
            <div class="flex-1 p-6 lg:p-8 bg-[#0A0A0B]">
              <div class="flex items-center justify-between mb-8">
                <div>
                  <h3 class="text-[18px] font-bold text-white mb-1">Bienvenido de nuevo</h3>
                  <p class="text-[13px] text-white/40">Aquí está el resumen de tu proyecto esta semana.</p>
                </div>
                <div class="hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-md bg-white/5 border border-white/10 text-[11px] font-medium text-white/60">
                  <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                  Sistema Operativo
                </div>
              </div>

              <!-- Top Stats -->
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                <div class="p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 transition-colors cursor-pointer group">
                  <div class="text-[11px] text-white/40 mb-2">ROAS Semanal</div>
                  <div class="flex items-end justify-between">
                    <div class="text-2xl font-bold text-white">4.2x</div>
                    <div class="text-[10px] text-green-400 flex items-center group-hover:-translate-y-1 transition-transform">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="mr-1"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                      12%
                    </div>
                  </div>
                </div>
                <div class="p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 transition-colors cursor-pointer group">
                  <div class="text-[11px] text-white/40 mb-2">Conversión Base</div>
                  <div class="flex items-end justify-between">
                    <div class="text-2xl font-bold text-white">3.8%</div>
                    <div class="text-[10px] text-green-400 flex items-center group-hover:-translate-y-1 transition-transform">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="mr-1"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                      0.5%
                    </div>
                  </div>
                </div>
                <div class="p-4 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 transition-colors cursor-pointer group col-span-2">
                  <div class="text-[11px] text-white/40 mb-2">Velocidad (Web Vitals)</div>
                  <div class="flex items-center gap-4">
                    <div class="text-2xl font-bold text-white">99<span class="text-[12px] text-white/30 ml-1">/100</span></div>
                    <div class="flex-1 h-1.5 bg-white/10 rounded-full overflow-hidden">
                      <div class="h-full w-[99%] bg-gradient-to-r from-blue-500 to-green-400 rounded-full"></div>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Active Sprint Board -->
              <div>
                <div class="flex items-center justify-between mb-4">
                  <h4 class="text-[13px] font-bold text-white">Sprint Actual <span class="text-white/30 font-normal ml-2">Semana 3</span></h4>
                  <a href="#" class="text-[11px] text-blue-400 hover:text-blue-300">Ver Kanban completo →</a>
                </div>
                <div class="space-y-3">
                  <!-- Task 1 -->
                  <div class="flex items-center justify-between p-3 rounded-lg bg-white/[0.02] border border-white/5 hover:border-white/10 transition-colors">
                    <div class="flex items-center gap-3">
                      <div class="w-4 h-4 rounded-full border-2 border-green-500 flex items-center justify-center">
                        <svg width="8" height="8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" class="text-green-500"><polyline points="20 6 9 17 4 12"/></svg>
                      </div>
                      <div class="text-[12px] font-medium text-white/80 line-through">Lanzamiento Campaña Meta Retargeting</div>
                    </div>
                    <div class="flex items-center gap-3">
                      <div class="flex -space-x-2">
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=100&auto=format&fit=crop" class="w-5 h-5 rounded-full border border-[#0A0A0B] grayscale">
                      </div>
                      <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase bg-green-500/10 text-green-400">Hecho</span>
                    </div>
                  </div>
                  <!-- Task 2 -->
                  <div class="flex items-center justify-between p-3 rounded-lg bg-blue-500/5 border border-blue-500/20 shadow-[0_0_15px_rgba(59,130,246,0.05)]">
                    <div class="flex items-center gap-3">
                      <div class="w-4 h-4 rounded-full border-2 border-blue-500 flex items-center justify-center">
                        <div class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-ping"></div>
                      </div>
                      <div class="text-[12px] font-medium text-white">Test A/B: Botón Checkout vs Sticky</div>
                    </div>
                    <div class="flex items-center gap-3">
                       <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase bg-blue-500/20 text-blue-400 border border-blue-500/20">En curso</span>
                    </div>
                  </div>
                  <!-- Task 3 -->
                  <div class="flex items-center justify-between p-3 rounded-lg bg-white/[0.02] border border-white/5 hover:border-white/10 transition-colors">
                    <div class="flex items-center gap-3">
                      <div class="w-4 h-4 rounded-full border-2 border-white/20"></div>
                      <div class="text-[12px] font-medium text-white/60">Auditoría SEO Técnico Mensual</div>
                    </div>
                    <div class="flex items-center gap-3">
                      <span class="px-2 py-0.5 rounded text-[9px] font-bold uppercase bg-white/5 text-white/40">Pendiente</span>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
        
        <!-- Reflejo Suelo -->
        <div class="absolute -bottom-10 left-[10%] right-[10%] h-[30px] bg-gradient-to-t from-blue-500/20 to-transparent blur-xl pointer-events-none z-0"></div>
      </div>

    </div>
  </Container>
</section>
