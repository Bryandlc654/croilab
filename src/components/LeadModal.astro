---
// LeadModal.astro
---
<div id="lead-modal-overlay" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300">
  <div id="lead-modal-content" class="relative w-full max-w-lg scale-95 transform overflow-hidden rounded-3xl bg-white p-8 shadow-2xl transition-all duration-300">
    <button id="close-lead-modal" class="absolute right-6 top-6 text-black/40 hover:text-black transition-colors">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    
    <div class="mb-8">
      <h3 class="text-2xl font-bold text-black tracking-tight mb-2">Iniciar un proyecto</h3>
      <p class="text-black/60 text-sm leading-relaxed">Djanos tus datos y nos pondremos en contacto contigo para agendar una llamada exploratoria.</p>
    </div>

    <form id="lead-form" class="flex flex-col gap-5">
      <div>
        <label for="lead_nombre" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-black/50">Nombre completo</label>
        <input type="text" id="lead_nombre" name="nombre" required class="w-full rounded-xl border border-black/10 bg-black/5 px-4 py-3 text-sm text-black placeholder:text-black/30 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all" placeholder="Ej. Juan Prez" />
      </div>
      
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <label for="lead_correo" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-black/50">Correo corporativo</label>
          <input type="email" id="lead_correo" name="correo" required class="w-full rounded-xl border border-black/10 bg-black/5 px-4 py-3 text-sm text-black placeholder:text-black/30 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all" placeholder="juan@empresa.com" />
        </div>
        <div>
          <label for="lead_telefono" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-black/50">Telfono</label>
          <input type="tel" id="lead_telefono" name="telefono" required class="w-full rounded-xl border border-black/10 bg-black/5 px-4 py-3 text-sm text-black placeholder:text-black/30 focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all" placeholder="+34 600..." />
        </div>
      </div>
      
      <div>
        <label for="lead_servicio" class="mb-1.5 block text-xs font-bold uppercase tracking-wider text-black/50">Servicio de inters</label>
        <select id="lead_servicio" name="servicio" required class="w-full rounded-xl border border-black/10 bg-black/5 px-4 py-3 text-sm text-black focus:border-blue-500 focus:bg-white focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all">
          <option value="" disabled selected>Selecciona una opcin</option>
          <option value="Auditora CRO">Auditora CRO</option>
          <option value="Desarrollo Web">Diseo y Desarrollo Web</option>
          <option value="Meta & Google Ads">Publicidad (Ads)</option>
          <option value="Consultora SEO">SEO</option>
          <option value="Otro">Otro proyecto</option>
        </select>
      </div>
      
      <button type="submit" id="lead-submit-btn" class="mt-4 flex w-full items-center justify-center gap-2 rounded-xl bg-blue-600 px-6 py-4 text-sm font-bold text-white transition hover:bg-blue-700 hover:shadow-[0_10px_20px_rgba(37,99,235,0.2)]">
        <span>Agendar llamada</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </button>

      <div id="lead-success-msg" class="hidden mt-4 rounded-xl bg-green-50 p-4 border border-green-200">
        <p class="text-sm font-semibold text-green-800 text-center">Gracias! Hemos recibido tus datos. Nos comunicaremos contigo a la brevedad.</p>
      </div>
      <div id="lead-error-msg" class="hidden mt-4 rounded-xl bg-red-50 p-4 border border-red-200">
        <p class="text-sm font-semibold text-red-800 text-center">Hubo un error al enviar tu solicitud. Intntalo de nuevo.</p>
      </div>
    </form>
  </div>
</div>

<script>
  // Script para manejar el modal y el envo del form
  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.getElementById('lead-modal-overlay');
    const content = document.getElementById('lead-modal-content');
    const closeBtn = document.getElementById('close-lead-modal');
    const form = document.getElementById('lead-form') as HTMLFormElement;
    const submitBtn = document.getElementById('lead-submit-btn') as HTMLButtonElement;
    const successMsg = document.getElementById('lead-success-msg');
    const errorMsg = document.getElementById('lead-error-msg');
    const openTriggers = document.querySelectorAll('[data-open-modal="lead-modal"]');

    const openModal = (e: Event) => {
      e.preventDefault();
      overlay?.classList.remove('hidden');
      // Forzar reflow para la animacin
      void overlay?.offsetWidth;
      overlay?.classList.remove('opacity-0');
      content?.classList.remove('scale-95');
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      overlay?.classList.add('opacity-0');
      content?.classList.add('scale-95');
      setTimeout(() => {
        overlay?.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
      
      // Reset form on close
      setTimeout(() => {
        form?.reset();
        successMsg?.classList.add('hidden');
        errorMsg?.classList.add('hidden');
        submitBtn.style.display = 'flex';
      }, 400);
    };

    openTriggers.forEach(btn => btn.addEventListener('click', openModal));
    closeBtn?.addEventListener('click', closeModal);
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) closeModal();
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const btnText = submitBtn.querySelector('span');
      if (btnText) btnText.textContent = 'Enviando...';
      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
      errorMsg?.classList.add('hidden');

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());
      
      try {
        const res = await fetch('https://core.croilab.com/wp-json/croilab/v1/lead', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });
        
        if (res.ok) {
          form.reset();
          submitBtn.style.display = 'none';
          successMsg?.classList.remove('hidden');
          setTimeout(() => {
            closeModal();
          }, 4000);
        } else {
          throw new Error('Server error');
        }
      } catch (err) {
        errorMsg?.classList.remove('hidden');
        if (btnText) btnText.textContent = 'Agendar llamada';
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      }
    });
  });
</script>
