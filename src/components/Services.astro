---
import { services } from '../data/services';
import Container from './ui/Container.astro';
import ServiceCard from './ui/ServiceCard.astro';
---

<section id="servicios" class="border-t border-black/10 bg-white">
  <Container class="py-24 lg:py-32">
    <div class="grid gap-16 lg:grid-cols-[.9fr_1.1fr]">
      <!-- HEADER STICKY -->
      <div class="reveal-up lg:sticky lg:top-10 lg:self-start">
        <div class="mb-8 flex items-center gap-4">
          <span class="h-px w-9 bg-accent"></span>
          <span class="text-[11px] font-medium uppercase tracking-[.24em] text-muted"
            >Servicios</span
          >
        </div>
        <h2
          class="text-[clamp(2.6rem,4.6vw,4.2rem)] font-semibold leading-[.95] tracking-[-.05em] text-ink"
        >
          No vendemos horas,
          <span class="block text-black/20">buscamos</span>
          <span class="block text-accent">crecimiento.</span>
        </h2>
        <p class="mt-8 max-w-md text-[15px] leading-7 text-muted">
          Nos alejamos del modelo de agencia 360 que intenta hacerlo todo en lugar de enfocarse en
          crecer el negocio. Cinco disciplinas, un único objetivo: convertir tráfico en ingresos.
        </p>
        <div class="mt-10 flex items-center gap-6">
          <span class="text-6xl font-semibold leading-none tracking-tight text-accent">05</span>
          <div class="text-[10px] uppercase leading-4 tracking-[.12em] text-black/35">
            disciplinas<br />un sistema
          </div>
        </div>
      </div>

      <!-- LISTA DE SERVICIOS -->
      <div class="border-t border-black/10">
        {services.map((service, i) => <ServiceCard service={service} index={i} />)}
      </div>
    </div>
  </Container>
</section>
