<section id="servicios" class="border-t border-black/10 bg-white relative overflow-hidden">
  <!-- Textura de fondo sutil -->
  <div class="grid-bg absolute inset-0 opacity-10"></div>
  
  <Container class="py-24 lg:py-40 relative z-10 flex flex-col items-center">
    
    <!-- HEADER CENTERED -->
    <div class="flex flex-col items-center text-center mb-20 w-full max-w-[900px]">
      <div class="reveal-up mb-8 flex items-center gap-4">
        <span class="h-px w-9 bg-blue-400/50"></span>
        <span class="text-[11px] font-medium uppercase tracking-[.24em] text-blue-300/60">Servicios</span>
        <span class="h-px w-9 bg-blue-400/50"></span>
      </div>
      
      <h2 class="title-reveal text-[clamp(2.5rem,5vw,4.5rem)] font-semibold leading-[1.05] tracking-[-.04em] text-black">
        No vendemos horas,
        <span class="block text-black/40 mt-2">buscamos</span>
        <span class="relative inline-block mt-2 font-serif italic text-black drop-shadow-[0_0_10px_rgba(100,200,255,0.3)]">
          crecimiento.
          <span class="absolute -right-4 top-2 h-2.5 w-2.5 rounded-full bg-blue-400 animate-pulseSoft shadow-[0_0_10px_rgba(8,120,249,0.8)]"></span>
        </span>
      </h2>
      
      <p class="reveal-up mt-8 max-w-[600px] text-[16px] leading-relaxed text-black/50">
        Nos alejamos del modelo de agencia 360 que intenta hacerlo todo en lugar de enfocarse en crecer el negocio. Cinco disciplinas, un único objetivo: convertir tráfico en ingresos.
      </p>
    </div>

    
