---
import { services as fallbackServices } from '../data/services';
import { getWpServices } from '../lib/wp';
import Container from './ui/Container.astro';

// Clases para lograr la asimetría del Bento Grid (3 columnas en Desktop)
const bentoClasses = [
  "md:col-span-2 md:row-span-2", // 01: Principal (Grande)
  "md:col-span-1 md:row-span-1", // 02: Cuadrado pequeño
  "md:col-span-1 md:row-span-1", // 03: Cuadrado pequeño
  "md:col-span-2 md:row-span-1", // 04: Rectángulo ancho horizontal
  "md:col-span-1 md:row-span-1"  // 05: Cuadrado pequeño
];

let dynamicServices = [];
try {
  const { items } = await getWpServices({ per_page: '20' });
  dynamicServices = items.map(s => {
    const data = s.croilab_servicio || {};
    return {
      num: data.num || '00',
      name: s.title?.rendered || 'Servicio',
      slug: s.slug,
      desc: data.desc || '',
      icon: data.icon || '',
      features: data.features || []
    };
  });
} catch (e) {
  console.error("Error fetching services:", e);
}

const services = dynamicServices.length > 0 ? dynamicServices : fallbackServices;
