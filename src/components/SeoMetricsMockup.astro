---
import Container from './ui/Container.astro';
---

<section class="bg-[#050505] py-32 overflow-hidden border-t border-white/5 relative">
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:32px_32px]"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-600/10 rounded-full blur-[120px] animate-glowDrift pointer-events-none"></div>

  <Container class="text-center relative z-10">
    <h2 class="text-white text-[clamp(2rem,3vw,3rem)] font-bold mb-4 tracking-tight">
      Todo tu posicionamiento, <br class="hidden md:block" />
      <span class="italic font-serif font-light text-white/50">en un solo panel.</span>
    </h2>
    <p class="text-white/50 text-lg mb-16 max-w-2xl mx-auto">
      Dejamos de vender humo y te mostramos datos: posiciones, clics, impresiones y tráfico real, medidos y optimizados semana a semana.
    </p>

    <div id="seo-mockup-container" class="relative w-full max-w-[1100px] mx-auto rounded-3xl border border-white/10 shadow-[0_0_100px_rgba(8,120,249,0.15)] overflow-hidden bg-[#0c0c0e] text-left">
      <!-- Topbar -->
      <div class="h-14 border-b border-white/5 flex items-center justify-between px-6 bg-white/[0.02]">
        <div class="flex items-center gap-4">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
            <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
            <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
          </div>
          <div class="h-5 w-px bg-white/10 mx-2"></div>
          <div class="flex items-center gap-2 text-white/50 text-[11px] font-mono bg-white/5 px-2 py-1 rounded border border-white/5">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            Buscar keywords, páginas...
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="bg-white/5 border border-white/10 text-white/80 text-[12px] font-medium px-3 py-1.5 rounded-lg flex items-center gap-2 cursor-pointer hover:bg-white/10 transition">
            Últimos 90 días
            <svg class="w-3 h-3 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </div>
          <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center border border-white/10">
            <span class="text-white text-[12px] font-bold">DB</span>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="flex h-[680px]">
        <!-- Sidebar -->
        <div class="w-56 border-r border-white/5 p-6 hidden md:flex flex-col gap-2 bg-[#0a0a0c]">
          <div class="text-[10px] uppercase tracking-widest text-white/30 font-bold mb-2 px-2 text-left">Analítica</div>
          <div class="bg-blue-500/10 text-blue-400 text-[13px] font-medium p-3 rounded-lg flex items-center gap-3 border border-blue-500/20 shadow-[0_0_15px_rgba(59,130,246,0.1)]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3v18h18"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 14l4-4 3 3 5-6"/></svg>
            Visión General
          </div>
          <div class="text-white/60 hover:text-white hover:bg-white/5 transition text-[13px] font-medium p-3 rounded-lg flex items-center gap-3 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.6a2 2 0 011.56.75l4.4 5.5A2 2 0 0119 10.5V19a2 2 0 01-2 2z"/></svg>
            Keywords
            <span class="ml-auto bg-blue-500 text-white text-[9px] px-1.5 py-0.5 rounded font-bold">1.2k</span>
          </div>
          <div class="text-white/60 hover:text-white hover:bg-white/5 transition text-[13px] font-medium p-3 rounded-lg flex items-center gap-3 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10M12 17V9M12 6V3M12 3l-3 3h6l-3-3z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 21v-9a3 3 0 016 0v9"/></svg>
            Posiciones
          </div>
          <div class="text-white/60 hover:text-white hover:bg-white/5 transition text-[13px] font-medium p-3 rounded-lg flex items-center gap-3 cursor-pointer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 17h18M6 17V9m6 8V5m6 12v-5"/></svg>
            Rendimiento</div>

          <div class="text-[10px] uppercase tracking-widest text-white/30 font-bold mt-6 mb-2 px-2 text-left">Proyectos</div>
          <div class="text-white/60 text-[12px] p-2 pl-3 rounded flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-blue-400"></span> clienteA.com
          </div>
          <div class="text-white/40 text-[12px] p-2 pl-3 rounded flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400"></span> clienteB.com
          </div>

          <div class="mt-auto border-t border-white/5 pt-4">
            <div class="text-white/60 hover:text-white hover:bg-white/5 transition text-[13px] font-medium p-3 rounded-lg flex items-center gap-3 cursor-pointer">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
              Reporte Mensual
            </div>
          </div>
        </div>

        <!-- Main Area -->
        <div class="flex-1 p-8 overflow-y-auto custom-scrollbar">
          <!-- Header -->
          <div class="flex justify-between items-end mb-8">
            <div>
              <h1 class="text-white text-2xl font-bold mb-1">Rendimiento SEO</h1>
              <p class="text-white/40 text-[13px]">Tráfico orgánico consolidado de Google</p>
            </div>
          </div>

          <!-- Metric Cards -->
          <div class="grid grid-cols-3 gap-6 mb-8">
            <!-- Card 1 Highlight -->
            <div class="bg-gradient-to-br from-blue-900/40 to-[#0a0a0c] border border-blue-500/30 rounded-2xl p-5 shadow-[0_10px_30px_rgba(59,130,246,0.1)] relative overflow-hidden group">
              <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/20 rounded-full blur-[40px] pointer-events-none"></div>
              <div class="text-[12px] text-blue-200/60 font-medium mb-4 relative z-10">Clics Orgánicos</div>
              <div class="text-3xl font-bold text-white mb-2 relative z-10">24,580</div>
              <div class="relative z-10">
                <span class="text-[11px] text-green-400 bg-green-400/10 px-1.5 py-0.5 rounded font-bold">↑ 45.2%</span>
                <span class="text-[11px] text-white/30 ml-1">en 3 meses</span>
              </div>
            </div>

            <!-- Card 2 -->
            <div class="bg-white/[0.02] border border-white/10 rounded-2xl p-5 hover:bg-white/[0.04] transition group">
              <div class="flex justify-between items-center mb-4">
                <div class="text-[12px] text-white/50 font-medium">Posición Promedio</div>
                <svg class="w-4 h-4 text-white/20 group-hover:text-white/50 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M6 21V9m6 12V3m6 18v-8"/></svg>
              </div>
              <div class="text-3xl font-bold text-white mb-2">4.2</div>
              <div class="flex items-center gap-2">
                <span class="text-[11px] text-green-400 bg-green-400/10 px-1.5 py-0.5 rounded font-bold">↑ 6 puestos</span>
              </div>
            </div>

            <!-- Card 3 -->
            <div class="bg-white/[0.02] border border-white/10 rounded-2xl p-5 hover:bg-white/[0.04] transition group">
              <div class="flex justify-between items-center mb-4">
                <div class="text-[12px] text-white/50 font-medium">Impresiones</div>
                <svg class="w-4 h-4 text-white/20 group-hover:text-white/50 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 3l6 6m0 0l-6 6m6-6h14"/></svg>
              </div>
              <div class="text-3xl font-bold text-white mb-2">198,410</div>
              <div class="flex items-center gap-2">
                <span class="text-[11px] text-green-400 bg-green-400/10 px-1.5 py-0.5 rounded font-bold">↑ 78%</span>
              </div>
            </div>
          </div>

          <!-- Traffic Chart -->
          <div class="bg-white/[0.02] border border-white/10 rounded-2xl p-6 h-64 flex flex-col relative mb-8">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-white text-sm font-bold">Tráfico orgánico mensual</h3>
              <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-blue-500"></div>
                <span class="text-[11px] text-white/50 font-medium">Clics</span>
              </div>
            </div>

            <div class="flex-1 border-b border-l border-white/10 relative mt-2">
              <div class="absolute inset-0 flex flex-col justify-between">
                <div class="border-t border-white/5 w-full"></div>
                <div class="border-t border-white/5 w-full"></div>
                <div class="border-t border-white/5 w-full"></div>
                <div class="border-t border-white/5 w-full"></div>
              </div>

              <svg class="absolute inset-0 w-full h-full" preserveAspectRatio="none" viewBox="0 0 100 100">
                <path d="M0,80 Q12,72 24,66 T48,55 T72,35 T100,20" fill="none" stroke="#3b82f6" stroke-width="3" stroke-linecap="round" />
                <path d="M0,80 Q12,72 24,66 T48,55 T72,35 T100,20 L100,100 L0,100 Z" fill="url(#seo-blue-grad)" opacity="0.2" />
                <defs>
                  <linearGradient id="seo-blue-grad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#3b82f6" />
                    <stop offset="100%" stop-color="transparent" />
                  </linearGradient>
                </defs>
              </svg>
            </div>
            <div class="flex justify-between text-[9px] text-white/40 font-mono mt-3 px-2">
              <span>Ene</span><span>Feb</span><span>Mar</span><span>Abr</span><span>May</span><span>Jun</span>
            </div>
          </div>

          <!-- Keywords Table -->
          <div class="bg-white/[0.02] border border-white/10 rounded-2xl overflow-hidden">
            <div class="flex items-center justify-between px-6 py-4 border-b border-white/5">
              <h3 class="text-white text-sm font-bold">Keywords principales</h3>
              <span class="text-[11px] text-blue-400 font-medium">Ver todas →</span>
            </div>
            <table class="w-full text-left">
              <thead>
                <tr class="text-[10px] uppercase tracking-widest text-white/30">
                  <th class="px-6 py-3 font-bold">Keyword</th>
                  <th class="px-6 py-3 font-bold">Posición</th>
                  <th class="px-6 py-3 font-bold">Volumen</th>
                  <th class="px-6 py-3 font-bold">CTR</th>
                  <th class="px-6 py-3 font-bold">Clics</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-t border-white/5 hover:bg-white/[0.03] transition">
                  <td class="px-6 py-3 text-[13px] text-white/80">diseño web profesional</td>
                  <td class="px-6 py-3"><span class="text-[11px] text-green-400 bg-green-400/10 px-2 py-0.5 rounded font-bold">#3</span></td>
                  <td class="px-6 py-3 text-[13px] text-white/60">12,100</td>
                  <td class="px-6 py-3 text-[13px] text-white/80">18.2%</td>
                  <td class="px-6 py-3 text-[13px] text-white font-bold">2,204</td>
                </tr>
                <tr class="border-t border-white/5 hover:bg-white/[0.03] transition">
                  <td class="px-6 py-3 text-[13px] text-white/80">agencia de desarrollo web</td>
                  <td class="px-6 py-3"><span class="text-[11px] text-green-400 bg-green-400/10 px-2 py-0.5 rounded font-bold">#1</span></td>
                  <td class="px-6 py-3 text-[13px] text-white/60">8,400</td>
                  <td class="px-6 py-3 text-[13px] text-white/80">32.1%</td>
                  <td class="px-6 py-3 text-[13px] text-white font-bold">2,696</td>
                </tr>
                <tr class="border-t border-white/5 hover:bg-white/[0.03] transition">
                  <td class="px-6 py-3 text-[13px] text-white/80">página web para negocios</td>
                  <td class="px-6 py-3"><span class="text-[11px] text-green-400 bg-green-400/10 px-2 py-0.5 rounded font-bold">#4</span></td>
                  <td class="px-6 py-3 text-[13px] text-white/60">6,700</td>
                  <td class="px-6 py-3 text-[13px] text-white/80">14.5%</td>
                  <td class="px-6 py-3 text-[13px] text-white font-bold">971</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const mockup = document.getElementById('seo-mockup-container');
  if (mockup) {
    gsap.fromTo(mockup,
      { scale: 0.85, opacity: 0.5, rotateX: 10 },
      {
        scale: 1,
        opacity: 1,
        rotateX: 0,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: mockup,
          start: 'top 90%',
          end: 'top 30%',
          scrub: true
        }
      }
    );
  }
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 6px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
  .custom-scrollbar:hover::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); }
</style>
