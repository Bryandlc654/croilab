---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Button from '../components/ui/Button.astro';
import Cta from '../components/ui/Cta.astro';
import Calculator from '../components/ui/Calculator.astro';
import ServiceStats from '../components/ServiceStats.astro';
import ServiceCases from '../components/ServiceCases.astro';
import MarqueeTestimonials from '../components/MarqueeTestimonials.astro';

const seoTestimonials = [
  { quote: "Pasamos de 0 leads orgánicos a 45 calificados por mes. Literalmente salvaron nuestro Q3.", name: "Roberto V.", role: "CEO, SaaS B2B", rating: 5 },
  { quote: "Habíamos invertido miles en agencias SEO que solo nos mandaban reportes de 'visitas'. Ellos se enfocaron en ventas.", name: "Camila T.", role: "CMO, Retail", rating: 5 },
  { quote: "No entiendo la mitad de la magia técnica que hacen, pero mi CRM está lleno de prospectos buscando comprar.", name: "Miguel A.", role: "Founder, B2B Services", rating: 5 },
  { quote: "Redujimos nuestro CPA un 60% al dejar de depender exclusivamente de Ads. El mejor ROI del año.", name: "Elena S.", role: "VP Marketing, Tech", rating: 5 },
  { quote: "El tráfico creció un 300%, pero lo más importante: la tasa de conversión se multiplicó por dos.", name: "David R.", role: "Director, Real Estate", rating: 5 },
  { quote: "Finalmente encontramos un partner que entiende que el SEO debe generar dinero, no solo posiciones vanidosas.", name: "Laura M.", role: "Head of Growth", rating: 5 },
];

const wpEndpoint = 'https://darkblue-flamingo-706734.hostingersite.com/wp-json/wp/v2/pages?slug=seo';
let rankMathSEO = null;

try {
  const res = await fetch(wpEndpoint);
  if (res.ok) {
    const pages = await res.json();
    if (pages && pages.length > 0) {
      rankMathSEO = pages[0].rank_math_head || null;
    }
  }
} catch (e) {
  console.error("Error fetching SEO page SEO:", e);
}
---

<BaseLayout
  title="SEO que convierte | Croilab"
  description="Tu competencia te está robando ventas en Google todos los días. Vamos a recuperarlas."
  rankMathSEO={rankMathSEO}
>
  <!-- 1. HERO HOOK -->
  <section class="relative min-h-[90vh] flex flex-col justify-center overflow-hidden border-t border-white/5 bg-[#050505]">
    
    <!-- Imagen de fondo con textura y degradado -->
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img 
        src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=2070&auto=format&fit=crop" 
        alt="SEO y Analítica" 
        class="w-full h-full object-cover object-top opacity-30 grayscale mix-blend-luminosity"
      />
      <!-- Grid Arquitectónico -->
      <div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.03)_1px,transparent_1px)] bg-[size:100px_100px] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_0%,#000_70%,transparent_100%)]"></div>
      
      <!-- Degradado envolvente hacia el negro puro -->
      <div class="absolute inset-0 bg-gradient-to-b from-[#050505]/0 via-[#050505]/80 to-[#050505]"></div>
      
      <!-- Ruido (Grain) para textura premium -->
      <div class="absolute inset-0 opacity-[0.25] mix-blend-overlay" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>
    </div>

    <!-- Efectos de iluminación vibrantes -->
    <div class="absolute top-1/4 right-1/4 w-[500px] h-[500px] bg-blue-500/20 rounded-full blur-[150px] pointer-events-none z-0"></div>
    <div class="absolute bottom-0 left-1/4 w-[600px] h-[600px] bg-cyan-500/15 rounded-full blur-[150px] pointer-events-none z-0"></div>

    <Container class="relative z-10 pt-40 pb-20 lg:pt-48 lg:pb-32">
      <div class="mb-14">
        <Breadcrumb items={[{ label: 'Servicios', href: '/#servicios' }, { label: 'SEO' }]} />
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-16 lg:gap-20 items-center">
        
        <!-- Izquierda: Textos -->
        <div class="flex flex-col text-left">
          <h1 class="gsap-title text-[clamp(3.5rem,7vw,7rem)] font-bold leading-[0.85] tracking-tight text-white mb-8" data-custom-speed="0.8">
            Tu competencia te está <br/>
            <span class="italic font-serif font-light text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">robando ventas.</span>
          </h1>

          <p class="max-w-xl text-[17px] md:text-[19px] leading-relaxed text-white/50 mb-12">
            Tener una web bonita es inútil si nadie la visita. Dominemos la primera página de Google y transformemos tráfico orgánico en clientes predecibles de alto valor.
          </p>

          <div class="flex flex-col sm:flex-row items-start gap-5">
            <a href="#metodologia" class="group relative flex items-center justify-center gap-4 rounded-full bg-white px-8 py-4 text-[15px] font-bold text-black transition-all duration-500 hover:scale-105 hover:shadow-[0_20px_40px_rgba(255,255,255,0.15)] w-full sm:w-auto">
              Descubre cómo
              <span class="inline-block transition-transform duration-300 group-hover:translate-y-1">↓</span>
            </a>
            <a href="/contacto" class="group flex items-center justify-center gap-4 rounded-full border border-white/20 bg-white/5 backdrop-blur-sm px-8 py-4 text-[15px] font-bold text-white transition-all duration-300 hover:bg-white/10 hover:border-white/40 w-full sm:w-auto">
              Quiero trabajar así
            </a>
          </div>
        </div>
          <!-- Derecha: Mockup Animado Mejorado -->
        <div class="relative w-full aspect-square md:aspect-[4/3] lg:aspect-[4/4.5] flex items-center justify-center perspective-1000 mt-10 lg:mt-0">
           
           <!-- Glow de fondo cinemático -->
           <div class="absolute inset-0 bg-gradient-to-tr from-cyan-500/30 via-blue-600/20 to-purple-500/20 rounded-[100px] blur-[120px] animate-pulse-slow mix-blend-screen pointer-events-none"></div>
           
           <!-- Interfaz Principal (Navegador) -->
           <div class="relative w-full max-w-[480px] rounded-[24px] bg-[#0c0c0e]/95 backdrop-blur-2xl border border-white/10 shadow-[0_40px_80px_rgba(0,0,0,0.8)] overflow-hidden animate-float">
             
             <!-- Header del navegador Mac OS style -->
             <div class="h-14 bg-white/[0.03] border-b border-white/5 flex items-center px-6 gap-3">
                <div class="flex gap-2">
                  <div class="w-3 h-3 rounded-full bg-[#FF5F56] border border-[#E0443E]"></div>
                  <div class="w-3 h-3 rounded-full bg-[#FFBD2E] border border-[#DEA123]"></div>
                  <div class="w-3 h-3 rounded-full bg-[#27C93F] border border-[#1AAB29]"></div>
                </div>
                <div class="ml-4 h-7 flex-1 max-w-[240px] bg-black/40 rounded-md px-3 flex items-center border border-white/5 shadow-inner">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-white/40 mr-2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                  <span class="text-[11px] text-white/50 font-mono tracking-wider">google.com/search?q=agencia+b2b</span>
                </div>
             </div>
             
             <!-- Contenido del buscador -->
             <div class="p-6 sm:p-8 relative min-h-[420px] bg-gradient-to-b from-transparent to-[#050505]">
               
               <!-- Top Bar Search (Skeleton) -->
               <div class="flex items-center gap-4 mb-8 border-b border-white/5 pb-4">
                 <div class="w-16 h-5 bg-white/10 rounded-full"></div>
                 <div class="w-12 h-5 bg-white/5 rounded-full"></div>
                 <div class="w-20 h-5 bg-white/5 rounded-full"></div>
               </div>
               
               <!-- Nuestro Resultado (El #1 - Super Premium) -->
               <div class="mb-6 p-5 rounded-2xl border border-blue-500/40 bg-gradient-to-br from-blue-500/10 to-transparent relative overflow-hidden group shadow-[0_0_30px_rgba(59,130,246,0.15)]">
                 <!-- Shimmer effect -->
                 <div class="absolute inset-0 bg-gradient-to-r from-transparent via-blue-400/10 to-transparent -translate-x-full animate-shimmer"></div>
                 
                 <div class="flex items-center gap-3 mb-2">
                   <div class="w-7 h-7 rounded-full bg-blue-500 shadow-[0_0_15px_rgba(59,130,246,0.5)] flex items-center justify-center text-[11px] text-white font-black">1</div>
                   <div class="text-[11px] text-white/60 font-mono">https://tuempresa.com</div>
                 </div>
                 
                 <h3 class="text-[17px] font-bold text-blue-400 mb-1 leading-snug">Tu Empresa | Líder en Soluciones B2B</h3>
                 <p class="text-[12px] text-white/50 leading-relaxed mb-4">La plataforma líder para escalar tus operaciones. Descubre cómo ayudamos a empresas a crecer un 300% su facturación anual.</p>
                 
                 <!-- Sitelinks -->
                 <div class="grid grid-cols-2 gap-2 mt-3">
                   <div class="text-[11px] text-blue-300/80 hover:underline cursor-pointer">↳ Casos de Éxito</div>
                   <div class="text-[11px] text-blue-300/80 hover:underline cursor-pointer">↳ Agendar Demo</div>
                 </div>

                 <!-- Badge animado de ROI -->
                 <div class="absolute top-4 right-4 bg-green-500/20 text-green-400 text-[10px] uppercase tracking-wider font-bold px-3 py-1.5 rounded-full border border-green-500/40 shadow-[0_0_15px_rgba(34,197,94,0.3)] animate-pulse flex items-center gap-1.5">
                   <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>
                   Top Ranking
                 </div>
               </div>

               <!-- Resultado Competencia 1 (Opaco) -->
               <div class="mb-6 p-4 rounded-xl border border-white/5 bg-white/[0.02] opacity-40 blur-[0.5px]">
                 <div class="flex items-center gap-3 mb-2">
                   <div class="w-6 h-6 rounded-full bg-white/10 flex items-center justify-center text-[10px] text-white/50">2</div>
                   <div class="h-3 w-32 bg-white/20 rounded"></div>
                 </div>
                 <div class="h-4 w-4/5 bg-white/30 rounded mb-2"></div>
                 <div class="h-2.5 w-full bg-white/10 rounded mb-1.5"></div>
                 <div class="h-2.5 w-2/3 bg-white/10 rounded"></div>
               </div>
               
               <!-- Resultado Competencia 2 (Opaco) -->
               <div class="mb-6 p-4 rounded-xl border border-white/5 bg-white/[0.02] opacity-20 blur-[1px]">
                 <div class="flex items-center gap-3 mb-2">
                   <div class="w-6 h-6 rounded-full bg-white/10 flex items-center justify-center text-[10px] text-white/50">3</div>
                   <div class="h-3 w-28 bg-white/20 rounded"></div>
                 </div>
                 <div class="h-4 w-3/4 bg-white/30 rounded mb-2"></div>
                 <div class="h-2.5 w-full bg-white/10 rounded"></div>
               </div>

             </div>
             
             <!-- Fade out inferior -->
             <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-[#0c0c0e] to-transparent pointer-events-none"></div>
           </div>

           <!-- Card Flotante 1: Analytics Graph -->
           <div class="absolute -right-6 lg:-right-12 top-1/3 bg-[#111115]/90 backdrop-blur-xl border border-white/10 rounded-2xl p-5 shadow-[0_20px_50px_rgba(0,0,0,0.5)] animate-float-delayed z-20 w-48 hidden sm:block">
             <div class="flex items-center justify-between mb-3">
               <div class="text-[10px] font-bold uppercase tracking-wider text-white/50">Tráfico Mensual</div>
               <div class="text-[10px] text-green-400 font-bold bg-green-500/10 px-1.5 py-0.5 rounded">+84%</div>
             </div>
             <div class="text-2xl font-bold text-white mb-2">45.2K</div>
             <!-- Mini Graph SVG -->
             <svg width="100%" height="30" viewBox="0 0 100 30" class="overflow-visible">
               <defs>
                 <linearGradient id="lineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                   <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.2" />
                   <stop offset="100%" stop-color="#3b82f6" stop-opacity="1" />
                 </linearGradient>
                 <linearGradient id="fillGrad" x1="0%" y1="0%" x2="0%" y2="100%">
                   <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.2" />
                   <stop offset="100%" stop-color="#3b82f6" stop-opacity="0" />
                 </linearGradient>
               </defs>
               <path d="M0,25 Q10,20 20,22 T40,15 T60,18 T80,5 T100,2" fill="none" stroke="url(#lineGrad)" stroke-width="2" stroke-linecap="round" class="animate-[dash_3s_ease-out_forwards]" stroke-dasharray="150" stroke-dashoffset="150" />
               <path d="M0,25 Q10,20 20,22 T40,15 T60,18 T80,5 T100,2 L100,30 L0,30 Z" fill="url(#fillGrad)" opacity="0.5" />
             </svg>
             <style>
               @keyframes dash {
                 to { stroke-dashoffset: 0; }
               }
             </style>
           </div>
           
           <!-- Card Flotante 2: CPA -->
           <div class="absolute -left-4 lg:-left-10 bottom-1/4 bg-[#111115]/90 backdrop-blur-xl border border-white/10 rounded-2xl p-4 shadow-[0_20px_50px_rgba(0,0,0,0.5)] animate-float z-20" style="animation-delay: 1.5s;">
             <div class="flex items-center gap-4">
               <div class="w-12 h-12 rounded-full bg-green-500/10 border border-green-500/20 flex items-center justify-center">
                 <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-green-400"><path d="M12 2v20"/><path d="m17 17-5 5-5-5"/></svg>
               </div>
               <div>
                 <div class="text-[10px] font-bold uppercase tracking-wider text-white/50 mb-1">Costo por Lead (CPA)</div>
                 <div class="flex items-end gap-2">
                   <div class="text-xl font-bold text-white">$12.50</div>
                   <div class="text-[12px] text-green-400 font-medium mb-0.5 line-through opacity-50">$45.00</div>
                 </div>
               </div>
             </div>
           </div>

        </div>

      </div>
    </Container>
  </section>

  <ServiceStats />

  <!-- 1.5 LOS SÍNTOMAS (PAIN POINTS) -->
  <section class="relative bg-[#f8f9fa] py-32 border-t border-black/5 overflow-hidden">
    <!-- Fondos y destellos sutiles de alerta -->
    <div class="grid-bg absolute inset-0 opacity-[0.03] pointer-events-none"></div>

    <Container class="relative z-10">
      <div class="flex flex-col lg:flex-row gap-16 lg:gap-24 items-start">
        
        <!-- Lado izquierdo: Título (Sticky) -->
        <div class="lg:w-1/3 lg:sticky lg:top-32 reveal-up">
          <div class="mb-6 flex items-center gap-4">
            <span class="h-px w-8 bg-gradient-to-r from-transparent to-red-500/50"></span>
            <span class="text-[11px] font-bold uppercase tracking-[.25em] text-red-500">Diagnóstico Crítico</span>
          </div>
          <h2 class="text-[clamp(2.5rem,4vw,3.5rem)] font-bold tracking-tight text-black mb-6 leading-[1.05]">
            ¿Te resulta dolorosamente <br/>
            <span class="italic font-serif font-light text-black/40">familiar?</span>
          </h2>
          <p class="text-[16px] text-black/50 leading-relaxed max-w-sm mb-12">
            Estos son los síntomas de un ecosistema digital que está perdiendo dinero (y clientes) todos los días frente a competidores más rápidos.
          </p>

          <!-- Imagen Editorial de Frustración / Análisis -->
          <div class="relative w-full aspect-video rounded-3xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-black/5 group">
            <img 
              src="https://images.unsplash.com/photo-1554151228-14d9def656e4?q=80&w=2070&auto=format&fit=crop" 
              alt="Análisis de negocio" 
              class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-80"></div>
          </div>
        </div>

        <!-- Lado derecho: Tarjetas tipo Bento -->
        <div class="lg:w-2/3 grid grid-cols-1 md:grid-cols-2 gap-6 reveal-up">
          
          <!-- Tarjeta 1 (Ancha) -->
          <div class="bg-white p-10 rounded-[2rem] border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.03)] transition-all duration-500 hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] hover:-translate-y-1 md:col-span-2 group">
            <div class="w-12 h-12 rounded-2xl bg-red-50 text-red-500 flex items-center justify-center mb-6 transition-transform group-hover:scale-110">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <h3 class="text-2xl font-bold text-black mb-4">Dependencia absoluta de Ads</h3>
            <p class="text-[16px] leading-relaxed text-black/60 max-w-2xl">
              Cada mes el costo por clic sube. Si dejas de pagar pauta a Meta o Google, tu negocio literalmente se detiene y las ventas caen a cero. Eres rehén de sus algoritmos y precios.
            </p>
          </div>

          <!-- Tarjeta 2 -->
          <div class="bg-white p-10 rounded-[2rem] border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.03)] transition-all duration-500 hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] hover:-translate-y-1 group">
            <div class="w-12 h-12 rounded-2xl bg-red-50 text-red-500 flex items-center justify-center mb-6 transition-transform group-hover:scale-110">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/></svg>
            </div>
            <h3 class="text-xl font-bold text-black mb-4">Competencia Inferior</h3>
            <p class="text-[15px] leading-relaxed text-black/60">
              Tus competidores tienen un peor producto y servicio, pero se llevan a tus clientes simplemente porque aparecen primero en Google.
            </p>
          </div>

          <!-- Tarjeta 3 -->
          <div class="bg-white p-10 rounded-[2rem] border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.03)] transition-all duration-500 hover:shadow-[0_20px_50px_rgba(0,0,0,0.08)] hover:-translate-y-1 group">
            <div class="w-12 h-12 rounded-2xl bg-red-50 text-red-500 flex items-center justify-center mb-6 transition-transform group-hover:scale-110">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <h3 class="text-xl font-bold text-black mb-4">Tráfico Fantasma</h3>
            <p class="text-[15px] leading-relaxed text-black/60">
              Tienes cientos de visitas mensuales a tu web, pero el teléfono no suena y los formularios de contacto están acumulando polvo.
            </p>
          </div>

        </div>
      </div>
    </Container>
  </section>

  <!-- 2. LA AGITACIÓN (LIGHT MODE) -->
  <section class="relative bg-white py-32 lg:py-48 overflow-hidden">
    <!-- Línea decorativa sutil -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-6xl h-px bg-gradient-to-r from-transparent via-black/10 to-transparent"></div>
    
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
        
        <!-- Columna Izquierda: Copy Editorial -->
        <div class="reveal-up relative">
          <!-- Decoración sutil de fondo -->
          <div class="absolute -top-20 -left-20 w-[400px] h-[400px] bg-black/[0.02] rounded-full blur-[80px] pointer-events-none"></div>

          <h2 class="text-[clamp(3.5rem,6vw,5.5rem)] font-bold tracking-tighter text-black mb-8 leading-[0.95]">
            El SEO <br/>
            tradicional <br/>
            está <span class="italic font-serif font-light text-black/30 relative inline-block">
              muerto.
              <span class="absolute top-1/2 left-0 w-full h-[2px] bg-red-500/50 -rotate-3"></span>
            </span>
          </h2>
          
          <div class="space-y-6 text-[16px] md:text-[18px] leading-relaxed text-black/60 max-w-lg">
            <p>
              Agencias creando artículos de blog genéricos que nadie lee. Creación masiva de enlaces en sitios basura. Promesas vacías de "estar el número 1" para palabras clave que no generan un solo centavo de ingresos.
            </p>
            <p>
              Nosotros <strong class="text-black font-semibold">no hacemos eso</strong>. Nuestro enfoque de Ingeniería de Conversión se asegura de que cada visita que atraemos a tu sitio web esté a un paso de sacar la tarjeta y comprar.
            </p>
          </div>

          <div class="mt-12 flex items-center gap-4">
             <div class="flex -space-x-4">
                <img class="w-12 h-12 rounded-full border-2 border-white grayscale object-cover" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?q=80&w=200&auto=format&fit=crop" alt="Cliente B2B" />
                <img class="w-12 h-12 rounded-full border-2 border-white grayscale object-cover" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?q=80&w=200&auto=format&fit=crop" alt="Cliente B2B" />
                <img class="w-12 h-12 rounded-full border-2 border-white grayscale object-cover" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=200&auto=format&fit=crop" alt="Cliente B2B" />
             </div>
             <p class="text-[13px] font-medium text-black/50 leading-tight max-w-[200px]">Empresas B2B que ya escalaron orgánicamente con nosotros.</p>
          </div>
        </div>

        <!-- Columna Derecha: Tarjeta de Dato Duro -->
        <div class="reveal-up relative group mt-10 lg:mt-0">
