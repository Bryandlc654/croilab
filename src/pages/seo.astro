<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animaciones de entrada suave para las tarjetas de pasos
  const cards = gsap.utils.toArray('.step-card');
  
  cards.forEach((card) => {
    gsap.from(card, {
      y: 60,
      opacity: 0,
      duration: 1,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: card,
        start: 'top 85%',
      }
    });
  });

  // Animación Parallax GSAP para los Títulos
  const titles = gsap.utils.toArray('.gsap-title');
  titles.forEach((title) => {
    const speed = parseFloat(title.getAttribute('data-custom-speed')) || 1;
    const yOffset = (1 - speed) * 200; // Calcula el desplazamiento basado en la velocidad

    gsap.fromTo(title,
      { y: yOffset, opacity: 0.2 },
      {
        y: 0,
        opacity: 1,
        ease: "none",
        scrollTrigger: {
          trigger: title,
          start: "top 95%", // Comienza la animación cuando el título entra en la vista
          end: "top 20%",   // Termina cuando el título está en la parte superior
          scrub: 1,         // Sincroniza suavemente con el scroll (efecto Parallax real)
        }
      }
    );
  });
</script>

<style is:global>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }
  @keyframes shimmer {
    100% { transform: translateX(100%); }
  }
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
  .animate-float-delayed {
    animation: float 6s ease-in-out infinite;
    animation-delay: 3s;
  }
  .animate-shimmer {
    animation: shimmer 3s infinite linear;
  }
</style>
