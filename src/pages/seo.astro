---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Cta from '../components/ui/Cta.astro';
import ServiceStats from '../components/ServiceStats.astro';

const wpEndpoint = 'https://darkblue-flamingo-706734.hostingersite.com/wp-json/wp/v2/pages?slug=seo';
let rankMathSEO = null;

try {
  const res = await fetch(wpEndpoint);
  if (res.ok) {
    const pages = await res.json();
    if (pages && pages.length > 0) {
      rankMathSEO = pages[0].rank_math_head || null;
    }
  }
} catch (e) {
  console.error("Error fetching SEO page SEO:", e);
}
---

<BaseLayout
  title="SEO que convierte | Croilab"
  description="Tu competencia te está robando ventas en Google todos los días. Vamos a recuperarlas."
  rankMathSEO={rankMathSEO}
>
  <!-- 1. HERO HOOK -->
  <section class="relative min-h-[90vh] flex flex-col justify-center overflow-hidden bg-[#050505]">
    <!-- Luces de fondo dinámicas -->
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-blue-500/10 rounded-full blur-[150px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-white/[0.03] rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-white/[0.04] rounded-full blur-[100px] pointer-events-none"></div>
    <div class="grid-bg absolute inset-0 opacity-15 pointer-events-none"></div>

    <Container class="relative z-10 pt-32 pb-20 text-center">

      <h1 class="gsap-title mx-auto max-w-5xl text-[clamp(3.5rem,7vw,7.5rem)] font-bold leading-[0.9] tracking-tight text-white mb-8" data-custom-speed="0.8">
        Tu competencia te está <span class="italic font-serif font-normal text-transparent bg-clip-text bg-gradient-to-r from-white via-white/70 to-white/30">robando ventas</span> en Google.
      </h1>

      <p class="mx-auto max-w-2xl text-[17px] leading-relaxed text-white/50 mb-12">
        Tener una web bonita es inútil si nadie la visita. Dominemos la primera página y transformemos tráfico orgánico en clientes predecibles.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
        <a href="#metodologia" class="group relative inline-flex items-center gap-4 rounded-full bg-white px-8 py-4 text-[15px] font-bold text-black transition-transform duration-300 hover:scale-105 shadow-[0_0_30px_rgba(255,255,255,0.15)]">
          Descubre cómo
          <span class="inline-block transition-transform duration-300 group-hover:translate-y-1">↓</span>
        </a>
        <a href="/contacto" class="group inline-flex items-center gap-4 rounded-full border border-white/20 bg-white/5 backdrop-blur-sm px-8 py-4 text-[15px] font-bold text-white transition-all duration-300 hover:bg-white/10 hover:border-white/30 hover:scale-105">
          Quiero trabajar así
        </a>
      </div>
    </Container>
  </section>

  <ServiceStats />

  <!-- 1.5 LOS SÍNTOMAS (PAIN POINTS) -->
  <section class="relative bg-[#f8f9fa] py-32 border-t border-black/5">
    <Container>
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-[11px] font-semibold uppercase tracking-[.25em] text-black/40 mb-6 block">Diagnóstico de negocio</span>
        <h2 class="gsap-title text-[clamp(2.5rem,4vw,3.5rem)] font-bold tracking-tight text-black mb-6 leading-tight">
          ¿Te resulta dolorosamente familiar alguna de estas situaciones?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`, title: "Dependencia de Ads", desc: "Cada mes el costo por clic sube. Si dejas de pagar pauta a Meta o Google, tu negocio literalmente se detiene y las ventas caen a cero." },
          { icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/></svg>`, title: "Competencia Inferior", desc: "Tus competidores tienen un peor producto y peor servicio, pero se llevan a tus clientes simplemente porque aparecen primero en Google." },
          { icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`, title: "Tráfico Fantasma", desc: "Tienes cientos de visitas mensuales a tu sitio web, pero el teléfono no suena y los formularios de contacto están acumulando polvo." }
        ].map(s => (
          <div class="bg-white p-10 rounded-[2rem] border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] transition-transform duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,0,0,0.06)]">
            <div class="mb-6 grayscale opacity-80" set:html={s.icon}></div>
            <h3 class="text-xl font-bold text-black mb-4">{s.title}</h3>
            <p class="text-[15px] leading-relaxed text-black/60">{s.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- 2. LA AGITACIÓN (LIGHT MODE) -->
  <section class="relative bg-white py-32 lg:py-48 border-t border-black/5 pt-10">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="gsap-title text-4xl lg:text-6xl font-bold tracking-tight text-black mb-8 leading-[1.1]" data-custom-speed="0.9">
            El SEO tradicional está <span class="text-black/30 line-through">muerto.</span>
          </h2>
          <div class="space-y-6 text-[16px] leading-relaxed text-black/60">
            <p>
              Agencias creando artículos de blog genéricos que nadie lee. Creación de enlaces en sitios basura. Promesas de "estar el número 1" para palabras clave que no generan ingresos.
            </p>
            <p>
              Nosotros no hacemos eso. Nuestro enfoque de <strong class="text-black">Ingeniería de Conversión</strong> se asegura de que cada visita que atraemos a tu sitio web tiene la tarjeta en la mano lista para comprar.
            </p>
          </div>
        </div>

        <div class="relative group">
          <div class="absolute inset-0 bg-gradient-to-tr from-black/5 to-transparent rounded-[2.5rem] border border-black/10 transition-colors duration-500 group-hover:border-black/20"></div>
          
          <div class="relative flex flex-col h-full overflow-hidden rounded-[2.5rem] bg-[#fbfbfb]">
            <div class="p-10 pb-0">
              <div class="text-7xl font-bold text-black mb-4">91%</div>
              <p class="text-lg text-black/60 mb-10">de las páginas en internet no reciben tráfico orgánico de Google porque no tienen una arquitectura diseñada para responder a la intención de búsqueda real del usuario.</p>
            </div>
            
            <!-- MOCKUP (Data Visualization / Fall of traffic) -->
            <div class="relative w-full h-[300px] mt-auto overflow-hidden">
              <img 
                src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=2000&auto=format&fit=crop" 
                alt="Gráfico de pérdida de tráfico" 
                class="absolute inset-0 w-full h-full object-cover object-top opacity-80 mix-blend-multiply filter contrast-125 transition-transform duration-700 group-hover:scale-105" 
              />
              <!-- Gradiente para fundir la imagen con el fondo -->
              <div class="absolute inset-0 bg-gradient-to-t from-[#fbfbfb] via-transparent to-transparent"></div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 3. METODOLOGÍA (LIGHT MODE) -->
  <section id="metodologia" class="relative bg-white py-32 border-t border-black/5">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-16 lg:gap-24 relative items-start">
        <!-- Izquierda: Sticky Header con Imagen -->
        <div class="lg:sticky lg:top-40 flex flex-col gap-12">
          <div>
            <span class="text-[11px] font-semibold uppercase tracking-[.25em] text-black/40 mb-6 block">Mecanismo Único</span>
            <h2 class="gsap-title text-[clamp(3rem,5vw,5rem)] font-bold leading-[1] tracking-tight text-black mb-6" data-custom-speed="0.95">
              Ingeniería <br/>
              <span class="italic font-serif font-normal text-black/40">Inversa.</span>
            </h2>
            <p class="text-[16px] leading-relaxed text-black/60 max-w-sm">
              En lugar de adivinar qué busca tu cliente ideal, mapeamos cada una de sus dudas, miedos y objeciones de compra, y construimos activos digitales para dominarlas.
            </p>
          </div>
          
          <!-- IMAGEN MOCKUP (Arquitectura/Estructura) -->
          <div class="relative w-full aspect-square max-w-sm rounded-[2.5rem] overflow-hidden bg-black/5 border border-black/10 group">
             <img 
               src="https://images.unsplash.com/photo-1618761714954-0b8cd0026356?q=80&w=2000&auto=format&fit=crop" 
               alt="Arquitectura SEO" 
               class="w-full h-full object-cover grayscale opacity-80 mix-blend-multiply transition-transform duration-700 group-hover:scale-105" 
             />
             <div class="absolute inset-0 border-[4px] border-white/50 rounded-[2.5rem] m-4 pointer-events-none"></div>
          </div>
        </div>

        <!-- Derecha: Pasos -->
        <div class="flex flex-col gap-12">
          {
            [
              { title: "Arquitectura Semántica", desc: "Estructuramos tu sitio como un ecosistema. Optimizamos la jerarquía de información para que Google entienda exactamente tu autoridad sobre el tema." },
              { title: "Intención de Compra", desc: "No apuntamos a palabras clave de alto volumen y cero ventas. Apuntamos a los términos transaccionales exactos que tus mejores clientes escriben antes de sacar su tarjeta." },
              { title: "Autoridad Programática", desc: "Inyectamos confianza algorítmica. Construimos PR digital y enlaces desde ecosistemas relevantes que gritan a Google: 'Ellos son los líderes absolutos de la industria'." },
              { title: "Optimización de Conversión", desc: "Atraerlos es solo el primer paso. Aplicamos principios de UX y Neuromarketing para guiar ese tráfico frío hacia tu formulario de contacto o carrito." }
            ].map((step, i) => (
              <div class="step-card group relative p-10 rounded-[2rem] border border-black/5 bg-[#f8f9fa] shadow-[0_10px_30px_rgba(0,0,0,0.03)] transition-all hover:bg-white hover:border-black/10 hover:shadow-[0_20px_40px_rgba(0,0,0,0.06)]">
                <div class="text-[80px] font-bold text-black/[0.03] absolute top-4 right-8 select-none transition-all group-hover:text-black/[0.06] font-serif italic">
                  0{i + 1}
                </div>
                <h3 class="relative z-10 text-2xl font-semibold text-black mb-4">{step.title}</h3>
                <p class="relative z-10 text-[15px] leading-relaxed text-black/60">{step.desc}</p>
              </div>
            ))
          }
        </div>
      </div>
    </Container>
  </section>

  <!-- 4. ROI / RESULTADOS (LIGHT MODE) -->
  <section class="relative bg-[#fbfbfb] py-32 lg:py-48 border-t border-black/5 overflow-hidden">
    <!-- Glows suaves celestes/purpuras sobre fondo claro -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-purple-500/10 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>
    
    <Container class="relative z-10 text-center">
      <h2 class="gsap-title text-[clamp(3rem,5vw,5rem)] font-bold tracking-tight text-black mb-16" data-custom-speed="0.85">
        No compramos clics.<br />
        <span class="italic font-serif font-normal text-black/50">Compramos cuota de mercado.</span>
      </h2>

      <!-- MOCKUP MASIVO (Dashboard SEO / Analytics) -->
      <div class="relative mx-auto max-w-5xl aspect-[16/10] md:aspect-[21/9] mb-20 rounded-[2.5rem] overflow-hidden bg-[#111] shadow-[0_30px_60px_rgba(0,0,0,0.15)] border border-black/10 group">
        <img 
          src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=2426&auto=format&fit=crop" 
          alt="Dashboard de crecimiento orgánico" 
          class="w-full h-full object-cover opacity-90 transition-transform duration-1000 group-hover:scale-105" 
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
        
        <!-- Elemento de UI flotante para dar toque premium -->
        <div class="absolute bottom-6 left-6 md:bottom-10 md:left-10 p-4 md:p-6 rounded-3xl bg-white/90 backdrop-blur-xl shadow-2xl border border-black/5 flex items-center gap-4 md:gap-6 animate-pulse-slow transition-transform hover:scale-105">
          <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-green-500/20 flex items-center justify-center text-green-600 font-bold text-lg md:text-xl">↑</div>
          <div class="text-left">
            <div class="text-[10px] md:text-sm font-bold text-black uppercase tracking-wider">Nuevos Usuarios</div>
            <div class="text-xl md:text-2xl font-black text-black">+24,590</div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-10 rounded-[2.5rem] bg-white border border-black/10 shadow-sm transition-all hover:shadow-xl hover:-translate-y-2">
          <div class="text-5xl font-bold text-black mb-2">+340%</div>
          <div class="text-[13px] uppercase tracking-widest text-black/40 font-bold">Tráfico Orgánico</div>
        </div>
        <div class="p-10 rounded-[2.5rem] bg-black text-white border border-black/20 shadow-[0_20px_40px_rgba(0,0,0,0.1)] transform md:-translate-y-6 transition-all hover:shadow-[0_30px_60px_rgba(0,0,0,0.2)] hover:-translate-y-8">
          <div class="text-6xl font-bold text-white mb-2">+45%</div>
          <div class="text-[13px] uppercase tracking-widest text-white/80 font-bold">Tasa de Conversión</div>
        </div>
        <div class="p-10 rounded-[2.5rem] bg-white border border-black/10 shadow-sm transition-all hover:shadow-xl hover:-translate-y-2">
          <div class="text-5xl font-bold text-black mb-2">ROI +</div>
          <div class="text-[13px] uppercase tracking-widest text-black/40 font-bold">En menos de 6 meses</div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 4.5 FAQ (OBJECIONES) -->
  <section class="relative bg-white py-32 lg:py-40 border-t border-black/5">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.5fr] gap-16 lg:gap-24 items-start relative">
        <div class="lg:sticky lg:top-40">
          <span class="text-[11px] font-semibold uppercase tracking-[.25em] text-black/40 mb-6 block">Transparencia Radical</span>
          <h2 class="gsap-title text-[clamp(2.5rem,4vw,3.5rem)] font-bold tracking-tight text-black mb-6 leading-[1.1]">
            Dudas frecuentes antes de empezar.
          </h2>
          <p class="text-[16px] leading-relaxed text-black/60 max-w-sm">
            No ocultamos nada. Creemos en establecer expectativas reales desde el día uno para asegurar una alianza rentable a largo plazo.
          </p>
        </div>

        <div class="flex flex-col gap-6">
          {[
            { q: "¿Cuánto tiempo tardaré en ver resultados reales?", a: "El SEO no es magia, es ingeniería. Normalmente, nuestros clientes ven los primeros movimientos fuertes entre el mes 3 y 4. Para el mes 6, el sistema genera retornos positivos y escalables. Quien te prometa resultados milagrosos en 30 días, te está mintiendo." },
            { q: "¿Por qué debería elegirlos sobre mi agencia actual?", a: "La mayoría de agencias miden su éxito en 'posiciones' o 'visitas'. Nosotros medimos el éxito en leads cualificados y aumento de facturación. Si tu agencia actual te entrega reportes llenos de visitas que no se traducen en dinero en el banco, es hora de cambiar el enfoque." },
            { q: "¿Garantizan la posición #1 en Google?", a: "Nadie que trabaje de forma ética puede garantizar la posición #1 absoluta porque el algoritmo es de Google, no nuestro. Lo que sí garantizamos es la ejecución exacta del sistema de conversión que ya ha escalado a decenas de empresas a liderar sus industrias." }
          ].map(faq => (
            <div class="group bg-[#f8f9fa] p-8 md:p-10 rounded-[2rem] border border-black/5 transition-colors hover:bg-white hover:border-black/10 hover:shadow-[0_20px_40px_rgba(0,0,0,0.03)]">
              <h3 class="text-xl font-bold text-black mb-4 flex items-start gap-4">
                <span class="text-black/20 font-serif italic text-2xl leading-none pt-1 group-hover:text-black/40 transition-colors">Q.</span>
                {faq.q}
              </h3>
              <p class="text-[15px] leading-relaxed text-black/60 pl-8 md:pl-10">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- 5. FINAL CTA (EL CIERRE) -->
  <Cta />
</BaseLayout>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animaciones de entrada suave para las tarjetas de pasos
  const cards = gsap.utils.toArray('.step-card');
  
  cards.forEach((card) => {
    gsap.from(card, {
      y: 60,
      opacity: 0,
      duration: 1,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: card,
        start: 'top 85%',
      }
    });
  });

  // Animación Parallax GSAP para los Títulos
  const titles = gsap.utils.toArray('.gsap-title');
  titles.forEach((title) => {
    const speed = parseFloat(title.getAttribute('data-custom-speed')) || 1;
    const yOffset = (1 - speed) * 200; // Calcula el desplazamiento basado en la velocidad

    gsap.fromTo(title,
      { y: yOffset, opacity: 0.2 },
      {
        y: 0,
        opacity: 1,
        ease: "none",
        scrollTrigger: {
          trigger: title,
          start: "top 95%", // Comienza la animación cuando el título entra en la vista
          end: "top 20%",   // Termina cuando el título está en la parte superior
          scrub: 1,         // Sincroniza suavemente con el scroll (efecto Parallax real)
        }
      }
    );
  });
</script>
