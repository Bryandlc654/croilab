---
import BaseLayout from '../layouts/BaseLayout.astro';
import Services from '../components/Services.astro';
import Cta from '../components/ui/Cta.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Container from '../components/ui/Container.astro';
---

<BaseLayout
  title="Servicios | Croilab — Cinco disciplinas, un objetivo"
  description="SEO, Meta Ads, Diseño Web, Ecommerce y Método Conversiones: cinco disciplinas, un único objetivo, convertir tráfico en ingresos."
>
  <section class="relative overflow-hidden bg-white">
    <div class="grid-bg absolute inset-0"></div>
    <Container class="relative z-10 pb-0 pt-10">
      <Breadcrumb items={[{ label: 'Servicios' }]} />
      <div class="mt-12 max-w-[880px] pb-16 lg:pb-20">
        <div class="mb-8 flex items-center gap-4">
          <span class="h-px w-9 bg-accent"></span>
          <span class="text-[11px] font-medium uppercase tracking-[.24em] text-muted"
            >Servicios</span
          >
        </div>
        <h1
          class="text-[clamp(3.2rem,6.5vw,6.8rem)] font-semibold leading-[.9] tracking-[-.065em] text-ink"
        >
          Servicios de <span class="text-accent">conversión</span>
        </h1>
        <p class="mt-8 max-w-2xl text-[15px] leading-7 text-black/50 md:text-[17px]">
          Cinco disciplinas, un único objetivo: convertir tráfico en ingresos. Explora cada servicio
          y descubre cómo puede impulsar tu negocio.
        </p>
      </div>
    </Container>
  </section>

  <Services />
  <Cta />
</BaseLayout>
