---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Cta from '../components/ui/Cta.astro';
---

<BaseLayout
  title="Nosotros | Croilab"
  description="Conoce al equipo detrás de la ingeniería de tráfico y conversión."
>
  <!-- 1. HERO SECTION (DARK GLASS) -->
  <section class="relative overflow-hidden bg-[#050505] pt-32 lg:pt-40 pb-20 border-t border-white/10">
    <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-white/[0.03] rounded-full blur-[150px] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-white/[0.02] rounded-full blur-[120px] pointer-events-none" aria-hidden="true"></div>

    <Container class="relative z-10">
      <Breadcrumb items={[{ label: 'La Agencia' }]} />
      
      <div class="mt-16 max-w-5xl">
        <div class="mb-8 flex items-center gap-4">
          <span class="h-px w-12 bg-white/30"></span>
          <span class="text-[11px] font-bold uppercase tracking-[.25em] text-white/50">Identidad</span>
        </div>
        <h1 class="gsap-title text-[clamp(3.5rem,7vw,7.5rem)] font-bold leading-[0.95] tracking-tight text-white mb-10" data-custom-speed="0.9">
          No somos una agencia.<br />
          <span class="italic font-serif font-normal text-transparent bg-clip-text bg-gradient-to-r from-white to-white/30">Somos ingenieros.</span>
        </h1>
      </div>
    </Container>
  </section>

  <!-- 2. IMAGEN PANORÁMICA DE EQUIPO / OFICINA -->
  <section class="relative bg-[#050505] pb-24">
    <Container>
      <div class="relative w-full aspect-[21/9] min-h-[400px] rounded-[3rem] overflow-hidden border border-white/10 shadow-[0_0_80px_rgba(255,255,255,0.02)] group">
        <div class="absolute inset-0 bg-black/40 z-10 pointer-events-none"></div>
        <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=2000&auto=format&fit=crop" alt="Equipo Croilab" class="w-full h-full object-cover transition-transform duration-[5s] ease-out group-hover:scale-105" />
        <div class="absolute inset-0 z-20 flex flex-col justify-end p-10 lg:p-16 bg-gradient-to-t from-black/90 via-black/40 to-transparent pointer-events-none">
          <p class="text-2xl lg:text-4xl leading-snug text-white max-w-4xl font-bold tracking-tight">
            "Diseñamos ecosistemas digitales obsesionados con una sola métrica: tu rentabilidad."
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- 3. MANIFIESTO (DARK PREMIUM) -->
  <section class="relative bg-[#050505] py-24 lg:py-32">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24 items-start">
        <div class="lg:col-span-5 lg:sticky lg:top-40">
          <span class="text-[11px] font-bold uppercase tracking-[.25em] text-white/40 mb-6 block">Nuestro Manifiesto</span>
          <h2 class="text-[clamp(2.5rem,4vw,4rem)] font-bold tracking-tight text-white leading-[1.1] mb-8">
            La industria está <span class="text-white/30 line-through">rota.</span>
          </h2>
          <p class="text-[17px] text-white/50 leading-relaxed mb-8">
            Te venden likes, seguidores y "diseños bonitos" que no pagan las facturas. Nosotros decidimos cambiar las reglas del juego por completo.
          </p>
          <div class="w-16 h-px bg-white/20"></div>
        </div>
        
        <div class="lg:col-span-7 flex flex-col gap-10">
          <div class="bg-[#0a0a0a] border border-white/10 rounded-[2.5rem] p-10 lg:p-14 transition-all duration-500 hover:border-white/20 hover:bg-white/[0.02]">
            <div class="flex items-center gap-4 mb-8">
              <div class="w-12 h-12 rounded-full border border-white/20 bg-white/5 flex items-center justify-center">
                <span class="text-lg font-serif italic text-white">1</span>
              </div>
              <h3 class="text-2xl font-bold text-white">Máquinas de conversión</h3>
            </div>
            <p class="text-[17px] text-white/60 leading-[1.8]">
              No pintamos cuadros. Cada botón, cada texto y cada campaña que lanzamos está respaldada por datos duros, mapas de calor y psicología de ventas. Si no suma al ROI, se elimina.
            </p>
          </div>

          <div class="bg-[#0a0a0a] border border-white/10 rounded-[2.5rem] p-10 lg:p-14 transition-all duration-500 hover:border-white/20 hover:bg-white/[0.02]">
            <div class="flex items-center gap-4 mb-8">
              <div class="w-12 h-12 rounded-full border border-white/20 bg-white/5 flex items-center justify-center">
                <span class="text-lg font-serif italic text-white">2</span>
              </div>
              <h3 class="text-2xl font-bold text-white">Tráfico de Élite</h3>
            </div>
            <p class="text-[17px] text-white/60 leading-[1.8]">
              Operamos bajo una premisa simple: Si no podemos medir el retorno, no lo hacemos. Combinamos tráfico de intención alta (SEO/Meta) con plataformas técnicamente impecables.
            </p>
          </div>

          <div class="bg-[#0a0a0a] border border-white/10 rounded-[2.5rem] p-10 lg:p-14 transition-all duration-500 hover:border-white/20 hover:bg-white/[0.02]">
            <div class="flex items-center gap-4 mb-8">
              <div class="w-12 h-12 rounded-full border border-white/20 bg-white/5 flex items-center justify-center">
                <span class="text-lg font-serif italic text-white">3</span>
              </div>
              <h3 class="text-2xl font-bold text-white">Tecnología Headless</h3>
            </div>
            <p class="text-[17px] text-white/60 leading-[1.8]">
              Usamos la arquitectura web más veloz del mercado. Tiempos de carga casi instantáneos que destrozan a tu competencia y retienen al usuario desde el primer milisegundo.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 4. METRICAS DARK GLASS -->
  <section class="relative bg-[#050505] py-24 border-t border-white/5">
    <!-- Grid de fondo sutil -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:100px_100px] [mask-image:radial-gradient(ellipse_50%_50%_at_50%_50%,#000_70%,transparent_100%)] pointer-events-none"></div>

    <Container class="relative z-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <div class="flex flex-col items-center justify-center p-10 rounded-[2rem] bg-[#0a0a0a] border border-white/10 transition hover:bg-white/[0.02]">
          <div class="text-[clamp(2.5rem,4vw,3.5rem)] font-bold text-white tracking-tighter mb-3">+100</div>
          <div class="text-[10px] uppercase tracking-[.2em] text-white/40 font-bold text-center">Lanzamientos</div>
        </div>
        <div class="flex flex-col items-center justify-center p-10 rounded-[2rem] bg-[#0a0a0a] border border-white/10 transition hover:bg-white/[0.02]">
          <div class="text-[clamp(2.5rem,4vw,3.5rem)] font-bold text-white tracking-tighter mb-3">+4M</div>
          <div class="text-[10px] uppercase tracking-[.2em] text-white/40 font-bold text-center">Tráfico Captado</div>
        </div>
        <div class="flex flex-col items-center justify-center p-10 rounded-[2rem] bg-[#0a0a0a] border border-white/10 transition hover:bg-white/[0.02]">
          <div class="text-[clamp(2.5rem,4vw,3.5rem)] font-bold text-white tracking-tighter mb-3">98%</div>
          <div class="text-[10px] uppercase tracking-[.2em] text-white/40 font-bold text-center">Retención</div>
        </div>
        <div class="flex flex-col items-center justify-center p-10 rounded-[2rem] bg-[#0a0a0a] border border-white/10 transition hover:bg-white/[0.02]">
          <div class="text-[clamp(2.5rem,4vw,3.5rem)] font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-white/50 tracking-tighter mb-3">X3</div>
          <div class="text-[10px] uppercase tracking-[.2em] text-white/40 font-bold text-center">ROI Promedio</div>
        </div>
      </div>
    </Container>
  </section>

  <!-- CTA FINAL -->
  <Cta />
</BaseLayout>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Parallax para Títulos Principales
  const titles = gsap.utils.toArray('.gsap-title');
  titles.forEach((title) => {
    const speed = parseFloat(title.getAttribute('data-custom-speed')) || 1;
    const yOffset = (1 - speed) * 150;

    gsap.fromTo(title,
      { y: yOffset, opacity: 0.2 },
      {
        y: 0,
        opacity: 1,
        ease: "none",
        scrollTrigger: {
          trigger: title,
          start: "top 95%",
          end: "top 30%",
          scrub: 1,
        }
      }
    );
  });
</script>
