---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Cta from '../../components/ui/Cta.astro';
import ServiceStats from '../../components/ServiceStats.astro';

export async function getStaticPaths() {
  const wpEndpoint = 'https://darkblue-flamingo-706734.hostingersite.com/wp-json/wp/v2/proyecto';
  let projects = [];
  try {
    const res = await fetch(wpEndpoint);
    projects = await res.json();
  } catch (e) {
    console.error("Error fetching projects from WP:", e);
  }

  return projects.map((project: any) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const title = project.title?.rendered || "Proyecto de Diseño Web";
const image = project.imagen_url || "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=2426&auto=format&fit=crop";
const content = project.content?.rendered || "<p>La optimización de la experiencia de usuario y el diseño de la interfaz jugaron un papel crucial en este proyecto.</p>";
const link = project.enlace_proyecto || "#";

// En un entorno real, estos vendrían de campos personalizados (ACF) en WP.
// Como no los tenemos, usamos placeholders atractivos que el cliente podrá conectar luego.
const metrics = [
  { value: "+150%", label: "Tasa de Conversión" },
  { value: "-3.2s", label: "Tiempo de Carga" },
  { value: "4x", label: "Retorno de Inversión" }
];
---

<BaseLayout seo={project.rank_math_head}>
  
  <!-- 1. HERO DEL PROYECTO -->
  <section class="relative bg-[#050505] min-h-[90vh] flex items-center pt-32 pb-20 overflow-hidden">
    <!-- Glows -->
    <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-blue-600/10 rounded-full blur-[150px] pointer-events-none mix-blend-screen"></div>
    <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-cyan-400/10 rounded-full blur-[120px] pointer-events-none mix-blend-screen"></div>
    <div class="grid-bg absolute inset-0 opacity-[0.05] pointer-events-none"></div>

    <Container class="relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Text -->
        <div class="reveal-up">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-white mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-[10px] font-bold uppercase tracking-widest">Caso de Éxito</span>
          </div>
          <h1 class="text-[clamp(3rem,6vw,5.5rem)] font-bold text-white leading-[1.05] tracking-tight mb-8">
            {title}
          </h1>
          <div class="text-lg text-white/60 mb-10 max-w-xl prose prose-invert prose-p:leading-relaxed" set:html={content}>
          </div>
          {link !== "#" && (
            <a href={link} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-3 bg-white text-black px-8 py-4 rounded-full font-bold text-sm hover:bg-blue-50 transition-colors">
              Visitar sitio web en vivo
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>
          )}
        </div>

        <!-- Mockup Visual -->
        <div class="relative w-full h-[60vh] lg:h-[80vh] perspective-1000 reveal-up" style="--delay: 0.2s;">
          <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-transparent to-transparent z-10"></div>
          <div class="absolute inset-0 rounded-2xl overflow-hidden border border-white/10 shadow-[0_0_50px_rgba(0,100,255,0.15)] transform rotate-y-[-15deg] rotate-x-[5deg] scale-105 group-hover:rotate-0 transition-transform duration-700">
            <img src={image} alt={`Mockup de ${title}`} class="w-full h-full object-cover object-top opacity-90" />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 2. MÉTRICAS DE IMPACTO (EL EMBUDO DE RESULTADOS) -->
  <section class="bg-white py-20 border-b border-black/5">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {metrics.map((m, i) => (
          <div class={`reveal-up flex flex-col items-center justify-center p-8 rounded-3xl bg-[#f8f9fa] border border-black/5 text-center`} style={`--delay: ${i * 0.1}s;`}>
            <div class="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500 mb-2">{m.value}</div>
            <div class="text-xs font-bold uppercase tracking-widest text-black/40">{m.label}</div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- 3. EL RETO VS LA SOLUCIÓN -->
  <section class="bg-white py-32 overflow-hidden">
    <Container>
      <div class="text-center max-w-3xl mx-auto mb-20 reveal-up">
        <h2 class="text-4xl font-bold tracking-tight text-black mb-6">De una web estática a una <span class="text-blue-600 italic font-serif">máquina de ventas</span>.</h2>
        <p class="text-lg text-black/60">El diseño web tradicional ya no funciona. Reestructuramos la arquitectura de la información y el UX/UI para eliminar la fricción y guiar al usuario directamente hacia la compra.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- El Problema -->
        <div class="reveal-up bg-[#fff5f5] rounded-[2.5rem] p-12 border border-red-100">
          <div class="w-12 h-12 bg-red-100 text-red-500 rounded-full flex items-center justify-center mb-8">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </div>
          <h3 class="text-2xl font-bold text-black mb-4">El Problema Anterior</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3 text-black/70"><span class="text-red-500 font-bold">✕</span> Tasa de rebote superior al 70%.</li>
            <li class="flex items-start gap-3 text-black/70"><span class="text-red-500 font-bold">✕</span> Tiempos de carga lentos que penalizaban el SEO.</li>
            <li class="flex items-start gap-3 text-black/70"><span class="text-red-500 font-bold">✕</span> Navegación confusa sin llamadas a la acción claras.</li>
          </ul>
        </div>
        
        <!-- La Solución Croilab -->
        <div class="reveal-up bg-[#f0f9ff] rounded-[2.5rem] p-12 border border-blue-100" style="--delay: 0.2s;">
          <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center mb-8">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <h3 class="text-2xl font-bold text-black mb-4">La Ingeniería Croilab</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3 text-black/70"><span class="text-blue-500 font-bold">✓</span> Rediseño UI con jerarquía visual para destacar CTAs.</li>
            <li class="flex items-start gap-3 text-black/70"><span class="text-blue-500 font-bold">✓</span> Desarrollo headless ultra-rápido (score 99/100).</li>
            <li class="flex items-start gap-3 text-black/70"><span class="text-blue-500 font-bold">✓</span> Copywriting persuasivo y embudo de conversión integrado.</li>
          </ul>
        </div>
      </div>
    </Container>
  </section>

  <!-- 3.5. STACK TECNOLÓGICO -->
  <section class="bg-white py-24 border-y border-black/5 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(0,0,0,0.03)_1px,transparent_1px)] bg-[size:64px_64px] pointer-events-none"></div>
    <Container class="relative z-10 text-center">
      <span class="text-[11px] font-bold uppercase tracking-[.25em] text-blue-600 mb-8 block reveal-up">Stack Tecnológico</span>
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 reveal-up" style="--delay: 0.1s;">
        <!-- Figma -->
        <div class="flex items-center gap-2 text-black/50 hover:text-black transition-colors grayscale hover:grayscale-0">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 12C16 14.2091 14.2091 16 12 16C9.79086 16 8 14.2091 8 12C8 9.79086 9.79086 8 12 8C14.2091 8 16 9.79086 16 12Z" fill="#1ABCFE"/><path d="M8 12C8 14.2091 6.20914 16 4 16C1.79086 16 0 14.2091 0 12C0 9.79086 1.79086 8 4 8C6.20914 8 8 9.79086 8 12Z" fill="#0ACF83"/><path d="M8 4C8 6.20914 6.20914 8 4 8C1.79086 8 0 6.20914 0 4C0 1.79086 1.79086 0 4 0C6.20914 0 8 1.79086 8 4Z" fill="#FF7262"/><path d="M12 8C14.2091 8 16 6.20914 16 4C16 1.79086 14.2091 0 12 0C9.79086 0 8 1.79086 8 4C8 6.20914 9.79086 8 12 8Z" fill="#F24E1E"/><path d="M12 24C14.2091 24 16 22.2091 16 20C16 17.7909 14.2091 16 12 16C9.79086 16 8 17.7909 8 20C8 22.2091 9.79086 24 12 24Z" fill="#A259FF"/></svg>
          <span class="font-bold text-sm">Figma UX/UI</span>
        </div>
        <!-- Astro -->
        <div class="flex items-center gap-2 text-black/50 hover:text-black transition-colors grayscale hover:grayscale-0">
          <svg width="24" height="24" viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMinYMin meet"><path d="M248.8 33.6c-13.8 24.3-15.6 30.7-32.9 61.2 5-6 13.9-19.1 13.9-19.1s2.8-4.7-2.6-7.8c-5.4-3.1-8.5.8-8.5.8s-73.4 99.4-78 105.8c-4.6 6.4-9.3 11.2-14.9 11.2-5.7 0-10.4-4.8-14.9-11.2-4.6-6.4-78-105.8-78-105.8s-3.1-3.9-8.5-.8c-5.4 3.1-2.6 7.8-2.6 7.8s8.9 13.2 13.9 19.1C18 64.3 16.2 57.9 2.4 33.6c-4.4-7.8-4.1-13.2 5.5-7.7 20 11.6 36.1 27.2 47.9 44.8l20.4-27.7c4.6-6.4 12.1-12.8 19.7-12.8s15 6.4 19.6 12.8L126 57.2l10.5-14.3c4.6-6.4 12.1-12.8 19.7-12.8s15 6.4 19.6 12.8l20.4 27.7c11.9-17.6 28-33.2 48-44.8 9.5-5.5 9.8-.1 5.4 7.7Z" fill="#000"/><path d="M125.6 57.2 115 71.5s23.4-1.2 38.6 16.6l-28-30.9Z" fill="#ff5d01"/></svg>
          <span class="font-bold text-sm">Astro.js</span>
        </div>
        <!-- Tailwind -->
        <div class="flex items-center gap-2 text-black/50 hover:text-black transition-colors grayscale hover:grayscale-0">
          <svg width="24" height="24" viewBox="0 0 256 153" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMinYMin meet"><path d="M64 19.2C42.7 19.2 25.6 34.1 21.3 53.3 29.9 40.5 40.5 36.3 53.3 40.5c7.3 2.4 12.5 7.8 18.2 13.7C81 63.8 92.4 76.8 128 76.8c21.3 0 38.4-14.9 42.7-34.1-8.5 12.8-19.2 17.1-32 12.8-7.3-2.4-12.5-7.8-18.2-13.7C110 32.2 98.6 19.2 64 19.2Zm64 76.8c-21.3 0-38.4 14.9-42.7 34.1 8.5-12.8 19.2-17.1 32-12.8 7.3 2.4 12.5 7.8 18.2 13.7C146 150.6 157.4 163.6 192 163.6c21.3 0 38.4-14.9 42.7-34.1-8.5 12.8-19.2 17.1-32 12.8-7.3-2.4-12.5-7.8-18.2-13.7C174 109 162.6 96 128 96Z" fill="#38BDF8"/></svg>
          <span class="font-bold text-sm">Tailwind CSS</span>
        </div>
        <!-- WordPress Headless -->
        <div class="flex items-center gap-2 text-black/50 hover:text-black transition-colors grayscale hover:grayscale-0">
          <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12.158 12.786l-2.698 7.84c.806.236 1.657.365 2.54.365 1.047 0 2.05-.18 2.986-.51-.024-.037-.046-.078-.065-.123l-2.763-7.572zm9.684-2.12c0 .878-.293 1.62-.647 2.274-.46.852-1.01 1.618-1.01 2.392 0 .61.42 1.15 1.05 1.15.05 0 .1-.005.15-.015-.812 2.7-2.627 4.908-5.008 6.136l3.52-9.98c.324-.87.488-1.554.488-2.036 0-1.42-.51-2.49-1.34-3.51l.01-.01c1.71 1.1 2.787 2.296 2.787 3.6zm-17.653-.888c0-1.282.684-2.316 1.704-2.88-1.127 1.48-1.8 3.32-1.8 5.302 0 1.25.26 2.44.72 3.52l3.413-9.52c-.67-.03-1.425-.05-1.425-.05-.33-.01-.33-.51 0-.51 0 0 1.956.03 2.92.03.953 0 1.99-.03 1.99-.03.32-.01.32.49 0 .51 0 0-.712.02-1.36.05l4.316 11.95.83-2.585-2.502-6.72c-.65-.03-1.396-.05-1.396-.05-.32-.01-.32-.51 0-.51 0 0 1.954.03 2.928.03.963 0 2.02-.03 2.02-.03.32-.01.32.49 0 .51 0 0-.75.02-1.427.05l2.678 7.37c-.366-.546-.665-1.077-.872-1.576-.44-.982-.765-2.046-.765-2.986 0-.82.16-1.57.43-2.31.28-.75.64-1.44.97-2.15.5-1.04.99-2.22.99-3.66 0-2.38-1.47-4.14-3.08-5.18l.01-.02c-1.36-.93-3.02-1.48-4.83-1.48-4.7 0-8.52 3.82-8.52 8.52 0 .42.04.83.1 1.22z" fill="#21759b"/></svg>
          <span class="font-bold text-sm">WP Headless</span>
        </div>
      </div>
    </Container>
  </section>

  <!-- 3.6. EL PROCESO -->
  <section class="bg-[#f8f9fa] py-24 border-b border-black/5">
    <Container>
      <div class="text-center mb-16 reveal-up">
        <h2 class="text-3xl font-bold text-black mb-4">¿Cómo logramos estos resultados?</h2>
        <p class="text-black/60 max-w-2xl mx-auto">Una metodología sistemática para reducir el riesgo y maximizar el impacto visual y comercial.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 relative">
        <div class="hidden md:block absolute top-1/2 left-0 w-full h-px bg-black/10 -translate-y-1/2 z-0"></div>
        
        {[
          { title: "1. Auditoría CRO", desc: "Analizamos dónde caían los usuarios y definimos la nueva estructura." },
          { title: "2. Wireframing", desc: "Creamos los esqueletos enfocados 100% en la usabilidad y conversión." },
          { title: "3. UI Design", desc: "Aplicamos la capa visual y de marca en Figma para un look premium." },
          { title: "4. Desarrollo", desc: "Programamos la web con Astro.js para tiempos de carga de 0.1s." }
        ].map((step, i) => (
          <div class="relative z-10 bg-white p-8 rounded-3xl border border-black/5 shadow-sm text-center reveal-up hover:-translate-y-2 transition-transform duration-300" style={`--delay: ${i * 0.1}s;`}>
            <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold mx-auto mb-6 shadow-lg">{i + 1}</div>
            <h4 class="font-bold text-black mb-2">{step.title}</h4>
            <p class="text-sm text-black/60">{step.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- 3.7. TESTIMONIO DEL CLIENTE -->
  <section class="bg-white py-24 overflow-hidden relative">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-500/5 rounded-full blur-[100px] pointer-events-none"></div>
    <Container class="relative z-10">
      <div class="max-w-4xl mx-auto text-center reveal-up">
        <span class="text-7xl font-serif text-blue-500 leading-none block mb-4">"</span>
        <h3 class="text-[clamp(1.5rem,3vw,2.5rem)] font-bold text-black leading-snug mb-10 tracking-tight">
          Entregar el rediseño a Croilab fue la mejor decisión del año. Entendieron exactamente cómo posicionar nuestra marca y crearon un embudo que literalmente nos trajo prospectos desde el día 1.
        </h3>
        <div class="inline-flex items-center gap-4 text-left">
          <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-blue-600 to-cyan-400 flex items-center justify-center text-white font-bold shadow-lg">
            {title.charAt(0)}
          </div>
          <div>
            <div class="font-bold text-black text-lg">CEO</div>
            <div class="text-sm text-black/50">{title}</div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 4. GALERÍA / DETALLE VISUAL -->
  <section class="bg-[#f8f9fa] py-32 border-t border-black/5">
    <Container class="text-center">
      <h2 class="text-[clamp(2rem,4vw,3rem)] font-bold tracking-tight text-black mb-16 reveal-up">Diseñado para convertir.</h2>
      
      <div class="w-full max-w-5xl mx-auto rounded-2xl overflow-hidden shadow-[0_30px_60px_rgba(0,0,0,0.1)] border border-black/5 reveal-up">
        <!-- Header de navegador Mac -->
        <div class="bg-white px-4 py-3 border-b border-black/5 flex items-center gap-2">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-red-400"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
            <div class="w-3 h-3 rounded-full bg-green-400"></div>
          </div>
          <div class="mx-auto bg-[#f1f3f5] rounded-md px-32 py-1 text-[10px] text-black/40 font-mono flex items-center gap-2">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
            {title.toLowerCase().replace(/\s+/g, '')}.com
          </div>
        </div>
        <img src={image} alt={title} class="w-full h-auto object-cover" />
      </div>
    </Container>
  </section>

  <!-- CTA FINAL -->
  <Cta />

</BaseLayout>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
</style>
