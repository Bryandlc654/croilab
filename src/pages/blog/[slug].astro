---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';

export async function getStaticPaths() {
  const wpEndpoint = 'https://darkblue-flamingo-706734.hostingersite.com/wp-json/wp/v2/posts?_embed';
  let posts = [];
  
  try {
    const res = await fetch(wpEndpoint);
    if (res.ok) {
      posts = await res.json();
    }
  } catch (e) {
    console.error("Error fetching posts:", e);
  }

  return posts.map((post) => {
    let imageUrl = "https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=2000&auto=format&fit=crop";
    if (post._embedded && post._embedded['wp:featuredmedia'] && post._embedded['wp:featuredmedia'][0]?.source_url) {
      imageUrl = post._embedded['wp:featuredmedia'][0].source_url;
    }
    
    // Calcular tiempo de lectura estimado (200 palabras por minuto)
    const wordCount = (post.content?.rendered || "").replace(/<[^>]*>?/gm, '').split(/\s+/).length;
    const readingTime = Math.max(1, Math.ceil(wordCount / 200));

    // Extraer encabezados H2 para el índice de contenidos
    const rawContent = post.content?.rendered || "";
    const headings = [...rawContent.matchAll(/<h2[^>]*>(.*?)<\/h2>/gi)].map((m) =>
      m[1].replace(/<[^>]*>/g, "").trim()
    );
    
    return {
      params: { slug: post.slug },
      props: {
        title: post.title?.rendered || "Artículo",
        content: rawContent,
        date: new Date(post.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }),
        image: imageUrl,
        readingTime,
        slug: post.slug,
        headings,
        rankMathSEO: post.head || post.yoast_head || post.rank_math_head || null
      },
    };
  });
}

const { title, content, date, image, readingTime, slug, headings = [], rankMathSEO } = Astro.props;

// Construir slugs de anclaje por heading (id único)
const toc = headings.map((h, i) => ({
  text: h,
  id: `section-${i + 1}`,
}));

// Inyectar id en los H2 del contenido para habilitar anclas del índice
let contentHtml = content;
if (toc.length > 0) {
  let idx = 0;
  contentHtml = contentHtml.replace(/<h2([^>]*)>/gi, (full, attrs) => {
    const id = `section-${idx + 1}`;
    idx += 1;
    if (/\bid=/i.test(attrs)) return full;
    return `<h2 id="${id}"${attrs}>`;
  });
}
const articleContent = contentHtml;

// Artículos relacionados (los 3 primeros distintos al actual)
let relatedPosts = [];
try {
  const relRes = await fetch('https://darkblue-flamingo-706734.hostingersite.com/wp-json/wp/v2/posts?_embed&per_page=4');
  if (relRes.ok) {
    const relPosts = await relRes.json();
    relatedPosts = relPosts
      .filter((p: any) => p.slug !== slug)
      .slice(0, 3)
      .map((p: any) => {
        let img = "https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=2000&auto=format&fit=crop";
        if (p._embedded && p._embedded['wp:featuredmedia'] && p._embedded['wp:featuredmedia'][0]?.source_url) {
          img = p._embedded['wp:featuredmedia'][0].source_url;
        }
        return {
          title: p.title?.rendered || "Artículo",
          slug: p.slug,
          image: img,
          date: new Date(p.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }),
        };
      });
  }
} catch (e) {
  console.error("Error fetching related posts:", e);
}
---

<BaseLayout
  title={`${title} | Croilab Journal`}
  description="Lee nuestro artículo más reciente."
  rankMathSEO={rankMathSEO}
>
  <!-- BARRA DE PROGRESO DE LECTURA -->
  <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-white z-[60] w-0 transition-all duration-75"></div>

  <article class="relative bg-[#050505] pb-32">
    <!-- CINEMATIC HERO HEADER -->
    <header class="relative w-full h-[85vh] min-h-[600px] flex items-end justify-center overflow-hidden">
      <!-- Imagen de fondo con Parallax -->
      <div class="absolute inset-0 z-0 bg-[#111]">
        <img 
          src={image} 
          alt={title} 
          class="w-full h-full object-cover opacity-60 scale-110" 
          id="parallax-hero"
        />
        <!-- Gradientes para asegurar legibilidad -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-[#050505]/60 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-[#050505]/80 via-transparent to-transparent h-48"></div>
      </div>
      
      <Container class="relative z-10 w-full pb-20">
        <div class="max-w-4xl">
          <!-- Metadatos (Breadcrumb y Fecha) -->
          <div class="flex flex-wrap items-center gap-4 lg:gap-6 mb-8">
            <Breadcrumb items={[{ label: 'Blog', href: '/blog' }, { label: 'Lectura' }]} />
            <span class="w-1.5 h-1.5 rounded-full bg-white/30 hidden sm:block"></span>
            <span class="text-[11px] font-semibold uppercase tracking-[.2em] text-white/50">{date}</span>
            <span class="w-1.5 h-1.5 rounded-full bg-white/30 hidden sm:block"></span>
            <span class="text-[11px] font-semibold uppercase tracking-[.2em] text-white/50">{readingTime} min de lectura</span>
          </div>
          
          <!-- Título Gigante -->
          <h1 class="text-[clamp(2.8rem,5.5vw,5.5rem)] font-bold leading-[1.05] tracking-tight text-white mb-8" set:html={title}></h1>
          
          <!-- Línea separadora elegante -->
          <div class="h-px w-full max-w-sm bg-gradient-to-r from-white/30 to-transparent"></div>
        </div>
      </Container>
    </header>

    <!-- CONTENIDO CENTRALIZADO ESTILO EDITORIAL -->
    <div class="relative z-20 bg-[#050505]">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_250px] gap-16 xl:gap-24 items-start relative -top-10">
          
          <!-- Columna principal (El texto) -->
          <div class="bg-[#0a0a0a] rounded-[2.5rem] border border-white/5 p-6 sm:p-12 lg:p-16 shadow-[0_0_80px_rgba(0,0,0,0.8)]">
            <div class="prose prose-invert prose-lg max-w-none
              prose-headings:text-white prose-headings:font-bold prose-headings:tracking-tight 
              prose-h2:text-[36px] prose-h2:leading-[1.2] prose-h2:mt-24 prose-h2:mb-8 prose-h2:pb-4 prose-h2:border-b prose-h2:border-white/10
              prose-h3:text-2xl prose-h3:mt-16 prose-h3:mb-6
              prose-p:text-white/60 prose-p:leading-[1.9] prose-p:mb-8 prose-p:text-[18px]
              prose-a:text-white prose-a:underline prose-a:decoration-white/30 hover:prose-a:decoration-white prose-a:underline-offset-4
              prose-strong:text-white prose-strong:font-semibold
              prose-li:text-white/60 prose-li:text-[18px] prose-li:mb-2
              prose-blockquote:border-l-4 prose-blockquote:border-white/30 prose-blockquote:bg-white/[0.02] prose-blockquote:py-6 prose-blockquote:px-8 prose-blockquote:rounded-r-2xl prose-blockquote:text-white/90 prose-blockquote:italic prose-blockquote:text-xl
              prose-img:rounded-3xl prose-img:border prose-img:border-white/10 prose-img:my-16 prose-img:w-full prose-img:shadow-2xl"
              set:html={articleContent}>
            </div>
            
            <!-- Fin del artículo -->
            <div class="mt-20 pt-10 border-t border-white/10 flex items-center justify-between">
              <span class="text-white/40 text-sm font-semibold tracking-widest uppercase">Fin de lectura</span>
              <a href="/blog" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-transparent px-6 py-3 text-[13px] font-bold text-white transition hover:bg-white hover:text-black">
                ← Volver al Journal
              </a>
            </div>
          </div>

          <!-- Barra lateral flotante (Sticky Share / CTA) -->
          <div class="hidden lg:block sticky top-32">
            <div class="flex flex-col gap-10">
              <!-- Autor / Agencia -->
              <div>
                <h4 class="text-[10px] uppercase tracking-widest text-white/40 mb-4 font-bold">Autoría</h4>
                <div class="flex items-center gap-4">
                  <div class="w-12 h-12 rounded-full border border-white/20 overflow-hidden bg-white/5 p-2">
                    <img src="/croilab-logo.svg" alt="Croilab" class="w-full h-full object-contain filter invert" />
                  </div>
                  <div>
                    <div class="text-sm font-bold text-white">Croilab</div>
                    <div class="text-xs text-white/40">Ingeniería Digital</div>
                  </div>
                </div>
              </div>

              <div class="h-px w-full bg-white/10"></div>

              <!-- Índice de contenidos -->
              {toc.length > 0 && (
                <div>
                  <h4 class="text-[10px] uppercase tracking-widest text-white/40 mb-4 font-bold">En este artículo</h4>
                  <nav id="toc" class="flex flex-col gap-1 text-[13px]">
                    {toc.map((item, i) => (
                      <a
                        href={`#${item.id}`}
                        data-toc-link={i}
                        class="toc-link rounded-lg pl-3 py-1.5 leading-snug block"
                      >
                        {item.text}
                      </a>
                    ))}
                  </nav>
                </div>
              )}

              <div class="h-px w-full bg-white/10"></div>

              <!-- Compartir -->
              <div>
                <h4 class="text-[10px] uppercase tracking-widest text-white/40 mb-4 font-bold">Compartir</h4>
                <div class="flex gap-3">
                  <button class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-white/50 hover:text-white hover:bg-white/5 transition-colors" aria-label="Copiar link" onclick="navigator.clipboard.writeText(window.location.href); alert('Enlace copiado al portapapeles');">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                  </button>
                  <a href={`https://twitter.com/intent/tweet?url=https://croilab.com/blog/${slug}&text=${title}`} target="_blank" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-white/50 hover:text-white hover:bg-white/5 transition-colors">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
                  </a>
                  <a href={`https://www.linkedin.com/shareArticle?mini=true&url=https://croilab.com/blog/${slug}&title=${title}`} target="_blank" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-white/50 hover:text-white hover:bg-white/5 transition-colors">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                  </a>
                </div>
              </div>

              <!-- CTA Lateral Premium -->
              <div class="mt-8 relative group overflow-hidden rounded-3xl p-[1px]">
                <!-- Halo luminoso de fondo en hover -->
                <div class="absolute inset-0 bg-gradient-to-br from-white/20 via-transparent to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></div>
                
                <div class="relative h-full w-full rounded-3xl bg-[#0a0a0a] border border-white/10 p-6 overflow-hidden">
                  <!-- Efecto de luz interior -->
                  <div class="absolute -top-10 -left-10 w-32 h-32 bg-white/5 blur-2xl rounded-full"></div>
                  
                  <div class="relative flex items-center gap-2 mb-4">
                    <span class="relative flex h-2 w-2">
                      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white opacity-50"></span>
                      <span class="relative inline-flex h-2 w-2 rounded-full bg-white shadow-[0_0_5px_white]"></span>
                    </span>
                    <span class="text-[10px] uppercase tracking-[.2em] text-white/40 font-bold">Oportunidad</span>
                  </div>

                  <h4 class="text-lg font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-white/50 mb-3 leading-tight">
                    ¿Quieres estos resultados?
                  </h4>
                  <p class="text-[13px] leading-relaxed text-white/50 mb-8">
                    Aplica estas estrategias en tu negocio con nosotros y escala tus métricas.
                  </p>
                  
                  <a href="/contacto" class="block w-full text-center rounded-full bg-white px-5 py-3 text-[13px] font-bold text-black transition-all duration-300 hover:bg-white/90 hover:shadow-[0_0_20px_rgba(255,255,255,0.3)] hover:-translate-y-0.5">
                    Quiero trabajar así
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </Container>
    </div>

    <!-- ARTÍCULOS RELACIONADOS -->
    {relatedPosts.length > 0 && (
      <section class="relative mt-28 lg:mt-40">
        <Container>
          <div class="flex items-center gap-4 mb-12 reveal-up">
            <span class="h-px w-9 bg-white/20"></span>
            <h3 class="text-[11px] font-semibold uppercase tracking-[.24em] text-white/50">Sigue leyendo</h3>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
            {relatedPosts.map((rp) => (
              <a href={`/blog/${rp.slug}`} class="group relative block overflow-hidden rounded-[2rem] bg-[#0a0a0a] border border-white/10">
                <div class="relative aspect-[16/10] overflow-hidden bg-[#111]">
                  <img
                    src={rp.image}
                    alt={rp.title}
                    loading="lazy"
                    class="h-full w-full object-cover opacity-70 transition-all duration-500 group-hover:opacity-100 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent"></div>
                </div>
                <div class="p-6 lg:p-8">
                  <span class="text-[10px] font-semibold uppercase tracking-widest text-white/40">{rp.date}</span>
                  <h4 class="mt-3 text-lg font-bold leading-snug tracking-tight text-white transition-colors group-hover:text-white/80 line-clamp-3" set:html={rp.title}>
                  </h4>
                  <span class="mt-5 inline-flex items-center gap-2 text-[12px] font-bold text-white/50 transition-colors group-hover:text-white">
                    Leer artículo
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </Container>
      </section>
    )}
  </article>
</BaseLayout>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Parallax sutil en la imagen principal
  const heroImg = document.getElementById('parallax-hero');
  if (heroImg) {
    gsap.to(heroImg, {
      y: 150,
      ease: "none",
      scrollTrigger: {
        trigger: "header",
        start: "top top",
        end: "bottom top",
        scrub: true
      }
    });
  }

  // Barra de progreso de lectura
  window.addEventListener('scroll', () => {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    const progressBar = document.getElementById('reading-progress');
    if (progressBar) {
      progressBar.style.width = scrolled + '%';
    }
  });

  // Scroll-spy del índice de contenidos
  const tocLinks = Array.from(document.querySelectorAll('.toc-link'));
  if (tocLinks.length > 0) {
    const sections = tocLinks
      .map((link) => document.getElementById(link.getAttribute('href').slice(1)))
      .filter(Boolean);

    const spy = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          tocLinks.forEach((link) => {
            link.classList.toggle('toc-active', link.getAttribute('href') === `#${id}`);
          });
        }
      });
    }, { rootMargin: '-30% 0px -60% 0px', threshold: 0 });

    sections.forEach((s) => spy.observe(s));
  }
</script>

<style>
  .toc-link {
    border-left: 2px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.45);
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .toc-link:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
  }
  .toc-link.toc-active {
    color: #fff;
    border-color: #fff;
  }
</style>
