---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import AuthorCard from '../../components/ui/AuthorCard.astro';

export async function getStaticPaths() {
  const wpEndpoint = 'https://darkblue-flamingo-706734.hostingersite.com/wp-json/wp/v2/posts?_embed';
  let posts = [];
  
  try {
    const res = await fetch(wpEndpoint);
    if (res.ok) {
      posts = await res.json();
    }
  } catch (e) {
    console.error("Error fetching posts:", e);
  }

  return posts.map((post) => {
    let imageUrl = "https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=2000&auto=format&fit=crop";
    if (post._embedded && post._embedded['wp:featuredmedia'] && post._embedded['wp:featuredmedia'][0]?.source_url) {
      imageUrl = post._embedded['wp:featuredmedia'][0].source_url;
    }
    
    // Calcular tiempo de lectura estimado (200 palabras por minuto)
    const wordCount = (post.content?.rendered || "").replace(/<[^>]*>?/gm, '').split(/\s+/).length;
    const readingTime = Math.max(1, Math.ceil(wordCount / 200));

    // Extraer encabezados H2 para el índice de contenidos
    const rawContent = post.content?.rendered || "";
    const headings = [...rawContent.matchAll(/<h2[^>]*>(.*?)<\/h2>/gi)].map((m) =>
      m[1].replace(/<[^>]*>/g, "").trim()
    );
    
    return {
      params: { slug: post.slug },
      props: {
        title: post.title?.rendered || "Artículo",
        content: rawContent,
        date: new Date(post.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }),
        image: imageUrl,
        readingTime,
        slug: post.slug,
        headings,
        rankMathSEO: post.head || post.yoast_head || post.rank_math_head || null
      },
    };
  });
}

const { title, content, date, image, readingTime, slug, headings = [], rankMathSEO } = Astro.props;

// Construir slugs de anclaje por heading (id único)
const toc = headings.map((h, i) => ({
  text: h,
  id: `section-${i + 1}`,
}));

// Inyectar id en los H2 del contenido para habilitar anclas del índice
let contentHtml = content;
if (toc.length > 0) {
  let idx = 0;
  contentHtml = contentHtml.replace(/<h2([^>]*)>/gi, (full, attrs) => {
    const id = `section-${idx + 1}`;
    idx += 1;
    if (/\bid=/i.test(attrs)) return full;
    return `<h2 id="${id}"${attrs}>`;
  });
}
const articleContent = contentHtml;

// Artículos relacionados (los 3 primeros distintos al actual)
let relatedPosts = [];
try {
  const relRes = await fetch('https://darkblue-flamingo-706734.hostingersite.com/wp-json/wp/v2/posts?_embed&per_page=4');
  if (relRes.ok) {
    const relPosts = await relRes.json();
    relatedPosts = relPosts
      .filter((p: any) => p.slug !== slug)
      .slice(0, 3)
      .map((p: any) => {
        let img = "https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=2000&auto=format&fit=crop";
        if (p._embedded && p._embedded['wp:featuredmedia'] && p._embedded['wp:featuredmedia'][0]?.source_url) {
          img = p._embedded['wp:featuredmedia'][0].source_url;
        }
        return {
          title: p.title?.rendered || "Artículo",
          slug: p.slug,
          image: img,
          date: new Date(p.date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }),
        };
      });
  }
} catch (e) {
  console.error("Error fetching related posts:", e);
}
---

<BaseLayout
  title={`${title} | Croilab Journal`}
  description="Lee nuestro artículo más reciente."
  rankMathSEO={rankMathSEO}
>
  <!-- BARRA DE PROGRESO DE LECTURA -->
  <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-black z-[60] w-0 transition-all duration-75"></div>

  <!-- BOTÓN VOLVER ARRIBA -->
  <button
    id="back-to-top"
    aria-label="Volver arriba"
    class="fixed bottom-8 right-8 z-[70] w-12 h-12 rounded-full bg-black text-white flex items-center justify-center shadow-[0_10px_30px_rgba(0,0,0,0.3)] opacity-0 translate-y-4 pointer-events-none transition-all duration-500 hover:bg-black/85 hover:-translate-y-1"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
  </button>

  <article class="relative bg-white pb-32">
    <!-- HERO CINEMÁTICO DARK -->
    <header class="relative w-full h-[85vh] min-h-[600px] flex items-end justify-center overflow-hidden bg-[#0a0a0a]">
      <!-- Imagen de fondo con Parallax -->
      <div class="absolute inset-0 z-0">
        <img
          src={image}
          alt={title}
          id="parallax-hero"
          class="w-full h-full object-cover opacity-60 scale-110"
        />
        <!-- Gradientes para asegurar legibilidad -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/50 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-transparent to-transparent"></div>
        <div class="absolute inset-0 bg-[#0a0a0a]/10"></div>
      </div>

      <Container class="relative z-10 w-full pb-20">
        <div class="max-w-4xl">
          <!-- Metadatos (Breadcrumb y Fecha) -->
          <div class="flex flex-wrap items-center gap-4 lg:gap-6 mb-8">
            <Breadcrumb items={[{ label: 'Blog', href: '/blog' }, { label: 'Lectura' }]} />
            <span class="w-1.5 h-1.5 rounded-full bg-white/30 hidden sm:block"></span>
            <span class="text-[11px] font-semibold uppercase tracking-[.2em] text-white/60">{date}</span>
            <span class="w-1.5 h-1.5 rounded-full bg-white/30 hidden sm:block"></span>
            <span class="text-[11px] font-semibold uppercase tracking-[.2em] text-white/60">{readingTime} min de lectura</span>
          </div>

          <!-- Título -->
          <h1 class="text-[clamp(2.8rem,5.5vw,5.5rem)] font-bold leading-[1.05] tracking-tight text-white mb-8" set:html={title}></h1>

          <!-- Línea separadora elegante -->
          <div class="h-px w-full max-w-sm bg-gradient-to-r from-white/30 to-transparent"></div>
        </div>
      </Container>
    </header>

    <!-- CONTENIDO CENTRALIZADO ESTILO EDITORIAL -->
    <div class="relative z-20 bg-white">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_250px] gap-16 xl:gap-24 items-start relative -mt-24">
          <!-- Columna principal (El texto) -->
          <div class="bg-white rounded-[2.5rem] border border-black/10 p-6 sm:p-12 lg:p-16 shadow-[0_20px_60px_rgba(0,0,0,0.08)]">
            
            <!-- RESUMEN RÁPIDO / KEY TAKEAWAYS -->
            <div class="mb-12 rounded-2xl bg-[#f8f9fa] border border-black/5 p-8">
              <div class="flex items-center gap-3 mb-5">
                <div class="w-8 h-8 rounded-full bg-black flex items-center justify-center">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M2 12h20"/></svg>
                </div>
                <span class="text-[11px] font-bold uppercase tracking-[.2em] text-black/50">Resumen rápido</span>
              </div>
              <p class="text-[16px] leading-relaxed text-black/70 mb-0">
                Este artículo cubre las estrategias y metodologías más efectivas para optimizar tu presencia digital. 
                En menos de {readingTime} minutos aprenderás los conceptos clave que nuestros clientes aplican para 
                escalar sus métricas de negocio.
              </p>
            </div>

            <!-- CONTENIDO DEL ARTÍCULO -->
            <div class="prose prose-lg max-w-none
              prose-headings:text-black prose-headings:font-bold prose-headings:tracking-tight 
              prose-h2:text-[36px] prose-h2:leading-[1.2] prose-h2:mt-24 prose-h2:mb-8 prose-h2:pb-4 prose-h2:border-b prose-h2:border-black/10
              prose-h3:text-2xl prose-h3:mt-16 prose-h3:mb-6
              prose-p:text-black/70 prose-p:leading-[1.9] prose-p:mb-8 prose-p:text-[18px]
              prose-a:text-black prose-a:underline prose-a:decoration-black/30 hover:prose-a:decoration-black prose-a:underline-offset-4
              prose-strong:text-black prose-strong:font-semibold
              prose-li:text-black/70 prose-li:text-[18px] prose-li:mb-2
              prose-blockquote:border-l-4 prose-blockquote:border-black/20 prose-blockquote:bg-black/[0.02] prose-blockquote:py-6 prose-blockquote:px-8 prose-blockquote:rounded-r-2xl prose-blockquote:text-black/80 prose-blockquote:italic prose-blockquote:text-xl
              prose-img:rounded-3xl prose-img:border prose-img:border-black/10 prose-img:my-16 prose-img:w-full prose-img:shadow-2xl"
              set:html={articleContent}>
            </div>

            <!-- CTA MID-ARTICLE: Newsletter -->
            <div class="my-16 rounded-[2rem] bg-[#0a0a0a] p-10 lg:p-12 relative overflow-hidden">
              <div class="absolute -top-20 -right-20 w-64 h-64 bg-white/5 blur-3xl rounded-full"></div>
              <div class="absolute -bottom-20 -left-20 w-48 h-48 bg-white/5 blur-3xl rounded-full"></div>
              <div class="relative z-10">
                <div class="flex items-center gap-2 mb-4">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                  <span class="text-[11px] font-bold uppercase tracking-[.2em] text-white/40">Newsletter</span>
                </div>
                <h3 class="text-2xl lg:text-3xl font-bold text-white mb-3 leading-tight">Recibe estrategias de conversiones cada semana</h3>
                <p class="text-[15px] text-white/50 mb-8 max-w-lg leading-relaxed">Cases de estudio, tácticas de CRO y frameworks probados que usamos con nuestros clientes para escalar resultados.</p>
                <form class="flex flex-col sm:flex-row gap-3" onsubmit="event.preventDefault(); alert('¡Gracias por suscribirte!');">
                  <input type="email" placeholder="tu@email.com" required class="flex-1 rounded-full bg-white/10 border border-white/10 px-6 py-3.5 text-[14px] text-white placeholder:text-white/30 focus:outline-none focus:border-white/30 focus:bg-white/15 transition-all" />
                  <button type="submit" class="rounded-full bg-white px-8 py-3.5 text-[13px] font-bold text-black transition-all hover:bg-white/90 hover:shadow-[0_0_20px_rgba(255,255,255,0.2)] whitespace-nowrap">
                    Suscribirme
                  </button>
                </form>
                <p class="text-[11px] text-white/30 mt-4">Sin spam. Cancela cuando quieras.</p>
              </div>
            </div>
            
            <!-- FICHA DE AUTOR COMPLETA -->
            <div class="mt-16">
              <div class="mb-6 flex items-center gap-4">
                <span class="h-px w-8 bg-black/20"></span>
                <span class="text-[11px] font-semibold uppercase tracking-[.24em] text-black/50">Sobre el autor</span>
              </div>
              <div class="rounded-[2rem] border border-black/5 bg-[#f8f9fa] p-8 lg:p-10">
                <div class="flex flex-col sm:flex-row items-start gap-6">
                  <div class="w-16 h-16 rounded-full bg-black flex items-center justify-center flex-shrink-0">
                    <span class="text-white text-xl font-bold">C</span>
                  </div>
                  <div class="flex-1">
                    <h4 class="text-xl font-bold text-black mb-1">Croilab</h4>
                    <p class="text-[13px] text-black/40 font-medium mb-4">Estrategia de Crecimiento Digital</p>
                    <p class="text-[15px] leading-relaxed text-black/60 mb-6">Equipo de ingenieros y estrategas especializado en ecosistemas digitales a medida basados en CRO, SEO y adquisición de clientes. Nos enfocamos en métricas que importan: conversiones y ventas.</p>
                    <div class="flex items-center gap-3">
                      <a href="https://twitter.com/croilab" target="_blank" class="w-9 h-9 rounded-full border border-black/10 flex items-center justify-center text-black/40 hover:text-black hover:bg-black/5 transition-colors">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
                      </a>
                      <a href="https://linkedin.com/company/croilab" target="_blank" class="w-9 h-9 rounded-full border border-black/10 flex items-center justify-center text-black/40 hover:text-black hover:bg-black/5 transition-colors">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                      </a>
                      <a href="https://instagram.com/croilab" target="_blank" class="w-9 h-9 rounded-full border border-black/10 flex items-center justify-center text-black/40 hover:text-black hover:bg-black/5 transition-colors">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- ¿TE FUE ÚTIL? -->
            <div class="mt-12 text-center">
              <p class="text-[15px] text-black/50 mb-4">¿Te fue útil este artículo?</p>
              <div class="flex items-center justify-center gap-3">
                <button onclick="this.innerHTML='¡Gracias! 👍'; this.disabled=true; this.classList.add('bg-green-50','text-green-700','border-green-200');" class="flex items-center gap-2 rounded-full border border-black/10 bg-white px-6 py-3 text-[13px] font-semibold text-black/60 transition-all hover:bg-green-50 hover:text-green-700 hover:border-green-200">
                  <span>Sí</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"/></svg>
                </button>
                <button onclick="this.innerHTML='Gracias por el feedback 👎'; this.disabled=true; this.classList.add('bg-orange-50','text-orange-700','border-orange-200');" class="flex items-center gap-2 rounded-full border border-black/10 bg-white px-6 py-3 text-[13px] font-semibold text-black/60 transition-all hover:bg-orange-50 hover:text-orange-700 hover:border-orange-200">
                  <span>No</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h2.67A2.31 2.31 0 0 1 22 4v7a2.31 2.31 0 0 1-2.33 2H17"/></svg>
                </button>
              </div>
            </div>

            <!-- Fin del artículo -->
            <div class="mt-16 pt-10 border-t border-black/10 flex flex-col sm:flex-row items-center justify-between gap-4">
              <span class="text-black/40 text-sm font-semibold tracking-widest uppercase">Fin de lectura</span>
              <div class="flex items-center gap-3">
                <a href="/blog" class="inline-flex items-center gap-2 rounded-full border border-black/20 bg-transparent px-6 py-3 text-[13px] font-bold text-black transition hover:bg-black hover:text-white">
                  ← Volver al Journal
                </a>
                <button onclick="navigator.clipboard.writeText(window.location.href); this.textContent='¡Copiado!'; setTimeout(() => this.textContent='Compartir', 2000);" class="inline-flex items-center gap-2 rounded-full border border-black/20 bg-black px-6 py-3 text-[13px] font-bold text-white transition hover:bg-black/80">
                  Compartir
                </button>
              </div>
            </div>
          </div>

          <!-- Barra lateral flotante (Sticky Share / CTA) -->
          <div class="hidden lg:block sticky top-32">
            <div class="flex flex-col gap-10">
              <!-- Ficha de autor (compacta) -->
              <AuthorCard
                name="Croilab"
                role="Ingeniería Digital"
                compact={true}
                avatar="/croilab-logo.svg"
              />

              <div class="h-px w-full bg-black/10"></div>

              <!-- Índice de contenidos -->
              {toc.length > 0 && (
                <div>
                  <h4 class="text-[10px] uppercase tracking-widest text-black/40 mb-4 font-bold">En este artículo</h4>
                  <nav id="toc" class="flex flex-col gap-1 text-[13px]">
                    {toc.map((item, i) => (
                      <a
                        href={`#${item.id}`}
                        data-toc-link={i}
                        class="toc-link rounded-lg pl-3 py-1.5 leading-snug block"
                      >
                        {item.text}
                      </a>
                    ))}
                  </nav>
                </div>
              )}

              <div class="h-px w-full bg-black/10"></div>

              <!-- Compartir -->
              <div>
                <h4 class="text-[10px] uppercase tracking-widest text-black/40 mb-4 font-bold">Compartir</h4>
                <div class="flex gap-3">
                  <button class="w-10 h-10 rounded-full border border-black/10 flex items-center justify-center text-black/50 hover:text-black hover:bg-black/5 transition-colors" aria-label="Copiar link" onclick="navigator.clipboard.writeText(window.location.href); alert('Enlace copiado al portapapeles');">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
                  </button>
                  <a href={`https://twitter.com/intent/tweet?url=https://croilab.com/blog/${slug}&text=${title}`} target="_blank" class="w-10 h-10 rounded-full border border-black/10 flex items-center justify-center text-black/50 hover:text-black hover:bg-black/5 transition-colors">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
                  </a>
                  <a href={`https://www.linkedin.com/shareArticle?mini=true&url=https://croilab.com/blog/${slug}&title=${title}`} target="_blank" class="w-10 h-10 rounded-full border border-black/10 flex items-center justify-center text-black/50 hover:text-black hover:bg-black/5 transition-colors">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                  </a>
                </div>
              </div>

              <!-- CTA Lateral Premium -->
              <div class="mt-8 relative group overflow-hidden rounded-3xl p-[1px]">
                <div class="relative h-full w-full rounded-3xl bg-black text-white border border-black/10 p-6 overflow-hidden">
                  <!-- Efecto de luz interior -->
                  <div class="absolute -top-10 -left-10 w-32 h-32 bg-white/5 blur-2xl rounded-full"></div>
                  
                  <div class="relative flex items-center gap-2 mb-4">
                    <span class="relative flex h-2 w-2">
                      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-white opacity-50"></span>
                      <span class="relative inline-flex h-2 w-2 rounded-full bg-white shadow-[0_0_5px_white]"></span>
                    </span>
                    <span class="text-[10px] uppercase tracking-[.2em] text-white/40 font-bold">Oportunidad</span>
                  </div>

                  <h4 class="text-lg font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-white/50 mb-3 leading-tight">
                    ¿Quieres estos resultados?
                  </h4>
                  <p class="text-[13px] leading-relaxed text-white/50 mb-8">
                    Aplica estas estrategias en tu negocio con nosotros y escala tus métricas.
                  </p>
                  
                  <a href="/contacto" class="block w-full text-center rounded-full bg-white px-5 py-3 text-[13px] font-bold text-black transition-all duration-300 hover:bg-white/90 hover:shadow-[0_0_20px_rgba(255,255,255,0.3)] hover:-translate-y-0.5">
                    Quiero trabajar así
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </Container>
    </div>

    <!-- ARTÍCULOS RELACIONADOS -->
    {relatedPosts.length > 0 && (
      <section class="relative mt-28 lg:mt-40">
        <Container>
          <div class="flex items-center gap-4 mb-12 reveal-up">
            <span class="h-px w-9 bg-black/20"></span>
            <h3 class="text-[11px] font-semibold uppercase tracking-[.24em] text-black/50">Sigue leyendo</h3>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
            {relatedPosts.map((rp) => (
              <a href={`/blog/${rp.slug}`} class="group relative block overflow-hidden rounded-[2rem] bg-white border border-black/10">
                <div class="relative aspect-[16/10] overflow-hidden bg-[#e8e8e8]">
                  <img
                    src={rp.image}
                    alt={rp.title}
                    loading="lazy"
                    class="h-full w-full object-cover opacity-80 transition-all duration-500 group-hover:opacity-100 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-white/80 via-transparent to-transparent"></div>
                </div>
                <div class="p-6 lg:p-8">
                  <span class="text-[10px] font-semibold uppercase tracking-widest text-black/40">{rp.date}</span>
                  <h4 class="mt-3 text-lg font-bold leading-snug tracking-tight text-black transition-colors group-hover:text-black/60 line-clamp-3" set:html={rp.title}>
                  </h4>
                  <span class="mt-5 inline-flex items-center gap-2 text-[12px] font-bold text-black/50 transition-colors group-hover:text-black">
                    Leer artículo
