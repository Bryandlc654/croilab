  }
  @keyframes dash {
    to { stroke-dashoffset: 0; }
  }
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
  .animate-float-delayed {
    animation: float 6s ease-in-out infinite;
    animation-delay: 3s;
  }
  .animate-shimmer {
    animation: shimmer 2s infinite linear;
  }
</style>
