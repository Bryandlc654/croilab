---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import Cta from '../components/ui/Cta.astro';
import ServiceStats from '../components/ServiceStats.astro';
import ServiceCases from '../components/ServiceCases.astro';

// Sincronización Headless con WordPress Rank Math
const wpEndpoint = 'https://darkblue-flamingo-706734.hostingersite.com/wp-json/wp/v2/pages?slug=meta-ads';
let rankMathSEO = null;

try {
  const res = await fetch(wpEndpoint);
  if (res.ok) {
    const pages = await res.json();
    if (pages && pages.length > 0) {
      rankMathSEO = pages[0].rank_math_head || null;
    }
  }
} catch (e) {
  console.error("Error fetching SEO:", e);
}
---

<BaseLayout
  title="Publicidad Rentable (Meta & Google Ads) | Croilab"
  description="Tus campañas no necesitan más presupuesto, necesitan estrategia. Sistemas de adquisición para escalar tu ROAS y bajar tu CPA."
  rankMathSEO={rankMathSEO}
>
  <!-- 1. HERO HOOK -->
  <section class="relative min-h-[90vh] flex flex-col justify-center overflow-hidden bg-[#050505]">
    <!-- Luces de fondo dinámicas (Azul Meta) -->
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-blue-600/15 rounded-full blur-[150px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-cyan-400/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-white/[0.04] rounded-full blur-[100px] pointer-events-none"></div>
    <div class="grid-bg absolute inset-0 opacity-15 pointer-events-none"></div>

    <Container class="relative z-10 pt-40 pb-20 lg:pt-48 lg:pb-32">
      <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-16 lg:gap-20 items-center">
        
        <!-- Izquierda: Textos -->
        <div class="flex flex-col text-left">
          <h1 class="gsap-title max-w-5xl text-[clamp(3.5rem,7vw,7.5rem)] font-bold leading-[0.9] tracking-tight text-white mb-8" data-custom-speed="0.8">
            Tus campañas no necesitan más presupuesto. Necesitan <br/><span class="italic font-serif font-light text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-white/80 to-white/30">estrategia.</span>
          </h1>

          <p class="max-w-xl text-[17px] md:text-[19px] leading-relaxed text-white/50 mb-12">
            Dejemos de comprar clics vacíos. Construimos sistemas de adquisición rentables que convierten tráfico frío en facturación predecible. Menos excusas, más ROAS.
          </p>

          <div class="flex flex-col sm:flex-row items-start gap-5">
            <a href="#metodologia" class="group relative flex items-center justify-center gap-4 rounded-full bg-white px-8 py-4 text-[15px] font-bold text-black transition-all duration-500 hover:scale-105 hover:shadow-[0_20px_40px_rgba(255,255,255,0.15)] w-full sm:w-auto">
              Descubrir sistema
              <span class="inline-block transition-transform duration-300 group-hover:translate-y-1">↓</span>
            </a>
            <a href="/contacto" class="group flex items-center justify-center gap-4 rounded-full border border-white/20 bg-white/5 backdrop-blur-sm px-8 py-4 text-[15px] font-bold text-white transition-all duration-300 hover:bg-white/10 hover:border-white/40 w-full sm:w-auto">
              Quiero trabajar así
            </a>
          </div>
        </div>

        <!-- Derecha: Mockup Animado Meta Ads -->
        <div class="relative w-full aspect-square md:aspect-[4/3] lg:aspect-[4/4.5] flex items-center justify-center perspective-1000 mt-10 lg:mt-0">
           
           <!-- Glow de fondo cinemático -->
           <div class="absolute inset-0 bg-gradient-to-br from-blue-600/30 via-indigo-600/20 to-cyan-500/10 rounded-[100px] blur-[100px] animate-pulse-slow mix-blend-screen pointer-events-none"></div>
           
           <!-- Interfaz Ads Manager -->
           <div class="relative w-full max-w-[480px] rounded-[24px] bg-[#0c0c0e]/95 backdrop-blur-2xl border border-white/10 shadow-[0_40px_80px_rgba(0,0,0,0.8)] overflow-hidden animate-float">
             
             <!-- Header Mac OS style -->
             <div class="h-14 bg-white/[0.03] border-b border-white/5 flex items-center px-6 gap-3">
                <div class="flex gap-2">
                  <div class="w-3 h-3 rounded-full bg-white/20"></div>
                  <div class="w-3 h-3 rounded-full bg-white/20"></div>
                  <div class="w-3 h-3 rounded-full bg-white/20"></div>
                </div>
                <div class="ml-4 h-7 flex-1 max-w-[200px] bg-black/40 rounded-md px-3 flex items-center border border-white/5">
                  <span class="text-[10px] text-white/50 font-medium">Ads Manager Pro</span>
                </div>
             </div>
             
             <!-- Contenido del Dashboard -->
             <div class="p-6 relative min-h-[420px] bg-[#050505]">
               
               <!-- Top Stats Row -->
               <div class="grid grid-cols-2 gap-4 mb-6">
                 <!-- Stat 1: ROAS -->
                 <div class="p-4 rounded-xl border border-white/5 bg-white/[0.02] hover:bg-white/[0.04] transition-colors relative overflow-hidden group">
                   <div class="absolute inset-0 bg-gradient-to-r from-transparent via-blue-500/10 to-transparent -translate-x-full group-hover:animate-[shimmer_1.5s_infinite]"></div>
                   <div class="text-[10px] uppercase font-bold text-white/40 mb-1">ROAS Total</div>
                   <div class="flex items-end gap-2">
                     <div class="text-3xl font-bold text-white">4.8x</div>
                     <div class="text-[11px] font-bold text-green-400 mb-1">+24%</div>
                   </div>
                 </div>
                 
                 <!-- Stat 2: Ventas -->
                 <div class="p-4 rounded-xl border border-white/5 bg-white/[0.02]">
                   <div class="text-[10px] uppercase font-bold text-white/40 mb-1">Leads Calificados</div>
                   <div class="flex items-end gap-2">
                     <div class="text-3xl font-bold text-white">342</div>
                     <div class="text-[11px] font-bold text-green-400 mb-1">+12%</div>
                   </div>
                 </div>
               </div>
               
               <!-- Gráfica Principal -->
               <div class="mb-6 p-5 rounded-2xl border border-blue-500/30 bg-gradient-to-br from-blue-500/10 to-transparent relative shadow-[0_0_30px_rgba(59,130,246,0.1)]">
                 <div class="flex items-center justify-between mb-6">
                   <h3 class="text-[12px] font-bold text-white/80">Tendencia de Adquisición</h3>
                   <span class="px-2 py-0.5 rounded-full bg-blue-500/20 text-blue-400 text-[9px] font-bold uppercase border border-blue-500/20">30 Días</span>
                 </div>
                 
                 <!-- SVG Graph -->
                 <div class="h-[100px] w-full relative">
                   <svg width="100%" height="100%" viewBox="0 0 100 40" preserveAspectRatio="none" class="overflow-visible">
                     <defs>
                       <linearGradient id="metaGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                         <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.2" />
                         <stop offset="100%" stop-color="#3b82f6" stop-opacity="1" />
                       </linearGradient>
                       <linearGradient id="metaFill" x1="0%" y1="0%" x2="0%" y2="100%">
                         <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.3" />
                         <stop offset="100%" stop-color="#3b82f6" stop-opacity="0" />
                       </linearGradient>
                     </defs>
                     <path d="M0,35 Q15,30 25,25 T50,15 T75,20 T100,5" fill="none" stroke="url(#metaGrad)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="animate-[dash_3s_ease-out_forwards]" stroke-dasharray="150" stroke-dashoffset="150" />
                     <path d="M0,35 Q15,30 25,25 T50,15 T75,20 T100,5 L100,40 L0,40 Z" fill="url(#metaFill)" opacity="0.8" />
                   </svg>
                 </div>
               </div>

               <!-- Lista de Campañas (Skeleton) -->
               <div class="space-y-3">
                 <div class="flex items-center justify-between p-3 rounded-lg bg-white/[0.03] border border-white/5">
                   <div class="flex items-center gap-3">
                     <div class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.6)] animate-pulse"></div>
                     <div class="w-32 h-3 bg-white/20 rounded"></div>
                   </div>
                   <div class="w-12 h-3 bg-white/10 rounded"></div>
                 </div>
                 <div class="flex items-center justify-between p-3 rounded-lg bg-white/[0.02] border border-white/5 opacity-50">
                   <div class="flex items-center gap-3">
                     <div class="w-2 h-2 rounded-full bg-white/20"></div>
                     <div class="w-24 h-3 bg-white/20 rounded"></div>
                   </div>
                   <div class="w-12 h-3 bg-white/10 rounded"></div>
                 </div>
               </div>

             </div>
             
             <!-- Fade out inferior -->
             <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-[#0c0c0e] to-transparent pointer-events-none"></div>
           </div>

           <!-- Card Flotante 1: Coste por Lead Bajando -->
           <div class="absolute -right-4 lg:-right-10 top-1/4 bg-[#111115]/95 backdrop-blur-xl border border-white/10 rounded-2xl p-4 shadow-[0_20px_50px_rgba(0,0,0,0.5)] animate-float-delayed z-20">
             <div class="flex items-center gap-3 mb-2">
               <div class="w-8 h-8 rounded-full bg-green-500/10 flex items-center justify-center">
                 <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-green-400"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
               </div>
               <div class="text-[10px] font-bold uppercase tracking-wider text-white/50">CPA (Costo Adq.)</div>
             </div>
             <div class="flex items-end gap-2">
               <div class="text-2xl font-bold text-white">$14.50</div>
               <div class="text-[12px] text-green-400 font-medium mb-1">-42% vs Mes Ant.</div>
             </div>
           </div>
           
           <!-- Card Flotante 2: Creative A/B Test -->
           <div class="absolute -left-6 lg:-left-12 bottom-1/3 bg-[#111115]/95 backdrop-blur-xl border border-white/10 rounded-2xl p-4 shadow-[0_20px_50px_rgba(0,0,0,0.5)] animate-float z-20 hidden sm:block" style="animation-delay: 1.5s;">
             <div class="text-[10px] font-bold uppercase tracking-wider text-white/50 mb-3">Creative Winner</div>
             <div class="flex items-center gap-4">
               <div class="w-12 h-12 rounded-lg bg-white/10 overflow-hidden border border-white/10">
                 <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=100&auto=format&fit=crop" class="w-full h-full object-cover grayscale opacity-80" alt="Ad Creative">
               </div>
               <div>
                 <div class="text-[13px] font-bold text-white mb-1">Video Story Ads</div>
                 <div class="text-[11px] text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded inline-block border border-blue-500/20">CTR: 4.8%</div>
               </div>
             </div>
           </div>

        </div>
      </div>
    </Container>
  </section>

  <ServiceStats />

  <!-- 1.5 LOS SÍNTOMAS -->
  <section class="relative bg-[#f8f9fa] py-32 border-t border-black/5">
    <Container>
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-[11px] font-semibold uppercase tracking-[.25em] text-black/40 mb-6 block">Diagnóstico de Campañas</span>
        <h2 class="gsap-title text-[clamp(2.5rem,4vw,3.5rem)] font-bold tracking-tight text-black mb-6 leading-tight">
          ¿Tu presupuesto se está evaporando sin retorno?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[
          { icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`, title: "CPA por las nubes", desc: "Zuckerberg y Google se están quedando todo tu margen. Cada mes cuesta más adquirir un cliente y la rentabilidad baja." },
          { icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="18" y1="8" x2="23" y2="13"/><line x1="23" y1="8" x2="18" y2="13"/></svg>`, title: "Leads 'Basura'", desc: "Tus anuncios generan muchos clics e interacciones, pero atraen a curiosos que no tienen el dinero o la intención real de comprar." },
          { icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"/><polyline points="17 18 23 18 23 12"/></svg>`, title: "Estancamiento al Escalar", desc: "Tus campañas venden bien con poco presupuesto, pero en cuanto intentas meterles más dinero, todo se desploma." }
        ].map(s => (
          <div class="bg-white p-10 rounded-[2rem] border border-black/5 shadow-[0_10px_30px_rgba(0,0,0,0.02)] transition-transform duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_rgba(0,0,0,0.06)]">
            <div class="mb-6 grayscale opacity-80" set:html={s.icon}></div>
            <h3 class="text-xl font-bold text-black mb-4">{s.title}</h3>
            <p class="text-[15px] leading-relaxed text-black/60">{s.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- 2. LA AGITACIÓN -->
  <section class="relative bg-white py-32 lg:py-48 border-t border-black/5 pt-10">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="gsap-title text-4xl lg:text-6xl font-bold tracking-tight text-black mb-8 leading-[1.1]" data-custom-speed="0.9">
            Los 'likes' no pagan <span class="text-black/30 line-through">tus nóminas.</span>
          </h2>
          <div class="space-y-6 text-[16px] leading-relaxed text-black/60">
            <p>
              Las agencias tradicionales te venden reportes hermosos llenos de "impresiones", "alcance" y métricas de vanidad para justificar su iguala mensual.
            </p>
            <p>
              Nosotros somos Media Buyers de respuesta directa. Nuestro único KPI es cuánto dinero entra en tu caja al final del mes. Si el ROAS no escala, la campaña no sirve, así de simple. Combinamos compra de medios con optimización de landing pages para asegurar que el clic se convierta en cliente.
            </p>
          </div>
        </div>

        <div class="relative group">
          <div class="absolute inset-0 bg-gradient-to-tr from-black/5 to-transparent rounded-[2.5rem] border border-black/10 transition-colors duration-500 group-hover:border-black/20"></div>
          
          <div class="relative flex flex-col h-full overflow-hidden rounded-[2.5rem] bg-[#fbfbfb]">
            <div class="p-10 pb-0">
              <div class="text-7xl font-bold text-black mb-4">92%</div>
              <p class="text-lg text-black/60 mb-10">de las campañas publicitarias fracasan por tener creatividades débiles o por enviar el tráfico a una web lenta que mata la conversión.</p>
            </div>
            
            <!-- MOCKUP ADS MANAGER -->
            <div class="relative w-full h-[300px] mt-auto overflow-hidden bg-black/5">
              <img 
                src="https://images.unsplash.com/photo-1533750349088-cd871a92f312?q=80&w=2000&auto=format&fit=crop" 
                alt="Ads Manager Mockup" 
                class="absolute inset-0 w-full h-full object-cover object-top opacity-70 mix-blend-multiply filter contrast-125 saturate-50 transition-transform duration-700 group-hover:scale-105" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#fbfbfb] via-transparent to-transparent"></div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 3. METODOLOGÍA -->
  <section id="metodologia" class="relative bg-white py-32 border-t border-black/5">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-16 lg:gap-24 relative items-start">
        <div class="lg:sticky lg:top-40 flex flex-col gap-12">
          <div>
            <span class="text-[11px] font-semibold uppercase tracking-[.25em] text-black/40 mb-6 block">Media Buying Científico</span>
            <h2 class="gsap-title text-[clamp(3rem,5vw,5rem)] font-bold leading-[1] tracking-tight text-black mb-6" data-custom-speed="0.95">
              Sistemas <br/>
              <span class="italic font-serif font-normal text-black/40">de Adquisición.</span>
            </h2>
            <p class="text-[16px] leading-relaxed text-black/60 max-w-sm">
              Olvídate de apretar el "Botón Promocionar". Construimos embudos publicitarios robustos diseñados para educar, perseguir y cerrar a tu cliente ideal.
            </p>
          </div>
          
          <div class="relative w-full aspect-square max-w-sm rounded-[2.5rem] overflow-hidden bg-black/5 border border-black/10 group">
             <img 
               src="https://images.unsplash.com/photo-1551434678-e076c223a692?q=80&w=2000&auto=format&fit=crop" 
               alt="Estructura de campaña" 
               class="w-full h-full object-cover grayscale opacity-80 mix-blend-multiply transition-transform duration-700 group-hover:scale-105" 
             />
             <div class="absolute inset-0 border-[4px] border-white/50 rounded-[2.5rem] m-4 pointer-events-none"></div>
          </div>
        </div>

        <div class="flex flex-col gap-12">
          {[
            { title: "Estructura Full Funnel", desc: "Diseñamos campañas de captación en frío (TOFU), retargeting agresivo (MOFU) y cierre definitivo (BOFU) para cubrir todo el ciclo del cliente." },
            { title: "Ingeniería de Creatividades (UGC)", desc: "El algoritmo hoy es inteligente, la segmentación ya no importa tanto como el mensaje. Diseñamos guiones y directrices de video (Direct Response) que hacen que el usuario se detenga y compre." },
            { title: "Alineación con CRO", desc: "Inyectar tráfico en una web rota es perder dinero. Optimizamos la Landing Page hacia donde apuntan los anuncios para garantizar que cada clic tenga la mayor probabilidad de convertirse." },
            { title: "Escalado Vertical y Horizontal", desc: "Aislamos los anuncios ganadores e inyectamos presupuesto progresivamente donde el algoritmo ya validó la rentabilidad, escalando sin romper el CPA." }
          ].map((step, i) => (
            <div class="step-card group relative p-10 rounded-[2rem] border border-black/5 bg-[#f8f9fa] shadow-[0_10px_30px_rgba(0,0,0,0.03)] transition-all hover:bg-white hover:border-black/10 hover:shadow-[0_20px_40px_rgba(0,0,0,0.06)]">
              <div class="text-[80px] font-bold text-black/[0.03] absolute top-4 right-8 select-none transition-all group-hover:text-black/[0.06] font-serif italic">
                0{i + 1}
              </div>
              <h3 class="relative z-10 text-2xl font-semibold text-black mb-4">{step.title}</h3>
              <p class="relative z-10 text-[15px] leading-relaxed text-black/60">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- 4. ROI -->
  <section class="relative bg-[#fbfbfb] py-32 lg:py-48 border-t border-black/5 overflow-hidden">
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-indigo-500/10 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>
    
    <Container class="relative z-10 text-center">
      <h2 class="gsap-title text-[clamp(3rem,5vw,5rem)] font-bold tracking-tight text-black mb-16" data-custom-speed="0.85">
        Escalabilidad <br/>
        <span class="italic font-serif font-normal text-black/50">Predecible.</span>
      </h2>

      <!-- MOCKUP MASIVO -->
      <div class="relative mx-auto max-w-5xl aspect-[16/10] md:aspect-[21/9] mb-20 rounded-[2.5rem] overflow-hidden bg-[#111] shadow-[0_30px_60px_rgba(0,0,0,0.15)] border border-black/10 group">
        <img 
          src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=2426&auto=format&fit=crop" 
          alt="Dashboard Escalado" 
          class="w-full h-full object-cover opacity-90 transition-transform duration-1000 group-hover:scale-105" 
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
        
        <div class="absolute bottom-6 left-6 md:bottom-10 md:left-10 p-4 md:p-6 rounded-3xl bg-white/90 backdrop-blur-xl shadow-2xl border border-black/5 flex items-center gap-4 md:gap-6 animate-pulse-slow transition-transform hover:scale-105">
          <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-blue-500/20 flex items-center justify-center text-blue-600 font-bold text-lg md:text-xl"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg></div>
          <div class="text-left">
            <div class="text-[10px] md:text-sm font-bold text-black uppercase tracking-wider">Retorno Publicitario</div>
            <div class="text-xl md:text-2xl font-black text-black">ROAS: 6.5x</div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-10 rounded-[2.5rem] bg-white border border-black/10 shadow-sm transition-all hover:shadow-xl hover:-translate-y-2">
          <div class="text-5xl font-bold text-black mb-2">+200%</div>
          <div class="text-[13px] uppercase tracking-widest text-black/40 font-bold">Volumen de Leads/Ventas</div>
        </div>
        <div class="p-10 rounded-[2.5rem] bg-black text-white border border-black/20 shadow-[0_20px_40px_rgba(0,0,0,0.1)] transform md:-translate-y-6 transition-all hover:shadow-[0_30px_60px_rgba(0,0,0,0.2)] hover:-translate-y-8">
          <div class="text-6xl font-bold text-white mb-2">-40%</div>
          <div class="text-[13px] uppercase tracking-widest text-white/80 font-bold">Costo de Adquisición (CPA)</div>
        </div>
        <div class="p-10 rounded-[2.5rem] bg-white border border-black/10 shadow-sm transition-all hover:shadow-xl hover:-translate-y-2">
          <div class="text-5xl font-bold text-black mb-2">Omni</div>
          <div class="text-[13px] uppercase tracking-widest text-black/40 font-bold">Meta + Google Ads Integrado</div>
        </div>
