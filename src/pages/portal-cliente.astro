---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Cta from '../components/ui/Cta.astro';
---

<BaseLayout
  title="Portal de Cliente | Croilab"
  description="Transparencia radical. Visualiza el progreso de tus proyectos, aprueba diseños y revisa métricas en tiempo real en nuestra plataforma propietaria."
>
  <!-- HERO SECTION -->
  <section class="relative overflow-hidden bg-[#050505] pt-32 lg:pt-40 pb-32 border-t border-white/10">
    <div class="absolute top-0 right-1/4 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-1/4 w-[500px] h-[500px] bg-purple-600/10 rounded-full blur-[100px] pointer-events-none"></div>
    
    <div class="grid-bg absolute inset-0 opacity-10 pointer-events-none"></div>

    <Container class="relative z-10">
      <Breadcrumb items={[{ label: 'Tecnología' }, { label: 'Portal de Cliente' }]} class="mb-10" />
      
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Text Content -->
        <div class="text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 backdrop-blur-md mb-8">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
            <span class="text-[10px] font-bold text-white uppercase tracking-wider">Croilab OS v2.0</span>
          </div>
          
          <h1 class="hero-title text-[clamp(3.5rem,6vw,5.5rem)] font-bold leading-[1] tracking-tight text-white mb-6">
            Transparencia <br />
            <span class="italic font-serif font-normal text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400">radical.</span>
          </h1>
          
          <p class="hero-subtitle text-[17px] leading-relaxed text-white/60 mb-10 max-w-md">
            Olvídate de perseguir a tu agencia preguntando "cómo va todo". Te damos acceso directo a nuestro ecosistema operativo. Tareas, métricas y reportes en tiempo real.
          </p>

          <div class="hero-btn">
            <a href="/contacto" class="group relative flex items-center gap-4 rounded-full bg-white px-8 py-4 text-[14px] font-bold text-black transition-all hover:scale-105 inline-flex">
              Ver una demo
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-black/10 transition-transform group-hover:rotate-45">↗</span>
            </a>
          </div>
        </div>

        <!-- Hero Mockup (Animated Glass) -->
        <div class="relative perspective-1000">
          <div class="mockup-float relative w-full aspect-[4/3] rounded-2xl bg-white/[0.03] border border-white/10 backdrop-blur-xl p-4 shadow-2xl flex flex-col overflow-hidden">
            <!-- Browser Chrome -->
            <div class="flex items-center gap-2 mb-4 border-b border-white/5 pb-4">
              <div class="flex gap-1.5">
                <div class="w-3 h-3 rounded-full bg-white/20"></div>
                <div class="w-3 h-3 rounded-full bg-white/20"></div>
                <div class="w-3 h-3 rounded-full bg-white/20"></div>
              </div>
              <div class="mx-auto text-[10px] text-white/30 font-mono bg-white/5 px-2 py-1 rounded">app.croilab.com/dashboard</div>
            </div>

            <!-- UI Skeleton -->
            <div class="flex flex-1 gap-4">
              <!-- Sidebar -->
              <div class="w-1/4 flex flex-col gap-3 border-r border-white/5 pr-4">
                <div class="h-6 w-full bg-white/10 rounded-md"></div>
                <div class="h-4 w-3/4 bg-white/5 rounded-md mt-4"></div>
                <div class="h-4 w-2/3 bg-white/5 rounded-md"></div>
                <div class="h-4 w-5/6 bg-white/5 rounded-md"></div>
              </div>
              <!-- Main Content -->
              <div class="flex-1 flex flex-col gap-4">
                <div class="flex gap-4 h-24">
                  <div class="flex-1 bg-gradient-to-br from-blue-500/20 to-transparent border border-white/5 rounded-xl p-3 flex flex-col justify-end">
                    <div class="text-[10px] text-white/40">ROAS</div>
                    <div class="text-lg font-bold text-white">4.2x</div>
                  </div>
                  <div class="flex-1 bg-white/5 border border-white/5 rounded-xl p-3 flex flex-col justify-end">
                    <div class="text-[10px] text-white/40">Conversión</div>
                    <div class="text-lg font-bold text-white">3.8%</div>
                  </div>
                </div>
                <!-- Kanban Skeleton -->
                <div class="flex-1 bg-white/5 border border-white/5 rounded-xl p-4 flex gap-3">
                  <div class="flex-1 bg-white/5 rounded-lg"></div>
                  <div class="flex-1 bg-blue-500/10 border border-blue-500/20 rounded-lg relative overflow-hidden">
                    <div class="absolute inset-0 bg-blue-400/20 animate-pulse"></div>
                  </div>
                  <div class="flex-1 bg-white/5 rounded-lg"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="absolute -right-6 top-10 bg-white/10 backdrop-blur-md border border-white/20 rounded-lg p-3 text-white shadow-xl animate-float" style="animation-delay: 0.5s;">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-green-400"></div>
              <span class="text-[11px] font-bold">Diseño Aprobado</span>
            </div>
          </div>
          <div class="absolute -left-6 bottom-10 bg-white/10 backdrop-blur-md border border-white/20 rounded-lg p-3 text-white shadow-xl animate-float" style="animation-delay: 1.5s;">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              <span class="text-[11px] font-bold">Sprint completado</span>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- FEATURES (APPLE-STYLE SCROLL) -->
  <section class="bg-white py-32 overflow-hidden border-t border-black/5">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-20">
        <h2 class="text-[clamp(2rem,4vw,3.5rem)] font-bold tracking-tight text-black leading-[1.1] mb-6">
          Un ecosistema operativo <br/>diseñado para crecer.
        </h2>
        <p class="text-[17px] text-black/50">
          No enviamos reportes en PDF a final de mes. Te conectamos directamente al motor de nuestra agencia.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
        <!-- Feature 1 -->
        <div class="group bg-[#f8f9fa] rounded-[2.5rem] p-10 lg:p-14 border border-black/5 transition-all hover:bg-black hover:text-white">
          <div class="w-12 h-12 rounded-xl bg-white border border-black/10 flex items-center justify-center text-black mb-8 group-hover:bg-white/10 group-hover:border-white/20 group-hover:text-white transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Métricas unificadas</h3>
          <p class="text-[15px] leading-relaxed opacity-70">Integramos las APIs de Google Analytics, Meta Ads, Shopify y Stripe. Todo el funnel en un solo panel de control actualizado al segundo.</p>
        </div>

        <!-- Feature 2 -->
        <div class="group bg-[#f8f9fa] rounded-[2.5rem] p-10 lg:p-14 border border-black/5 transition-all hover:bg-black hover:text-white">
          <div class="w-12 h-12 rounded-xl bg-white border border-black/10 flex items-center justify-center text-black mb-8 group-hover:bg-white/10 group-hover:border-white/20 group-hover:text-white transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Aprobación en 1 clic</h3>
          <p class="text-[15px] leading-relaxed opacity-70">Revisa wireframes, copies de anuncios y diseños directamente en la plataforma. Deja comentarios precisos o aprueba la ejecución al instante.</p>
        </div>

        <!-- Feature 3 -->
        <div class="group bg-[#f8f9fa] rounded-[2.5rem] p-10 lg:p-14 border border-black/5 transition-all hover:bg-black hover:text-white">
          <div class="w-12 h-12 rounded-xl bg-white border border-black/10 flex items-center justify-center text-black mb-8 group-hover:bg-white/10 group-hover:border-white/20 group-hover:text-white transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Sprint Board (Kanban)</h3>
          <p class="text-[15px] leading-relaxed opacity-70">Mira en tiempo real en qué tarea exacta está trabajando el ingeniero. Desde la auditoría hasta el código en producción.</p>
        </div>

        <!-- Feature 4 -->
        <div class="group bg-[#f8f9fa] rounded-[2.5rem] p-10 lg:p-14 border border-black/5 transition-all hover:bg-black hover:text-white">
          <div class="w-12 h-12 rounded-xl bg-white border border-black/10 flex items-center justify-center text-black mb-8 group-hover:bg-white/10 group-hover:border-white/20 group-hover:text-white transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Finanzas y Facturación</h3>
          <p class="text-[15px] leading-relaxed opacity-70">Historial completo de pagos, facturas fiscales descargables y proyecciones de inversión. Cero sorpresas a fin de mes.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- MOCKUP GIGANTE CON SCROLL (GSAP) -->
  <section class="bg-black py-32 overflow-hidden">
    <Container class="text-center">
      <h2 class="text-white text-3xl font-bold mb-16">El centro de mando de tu negocio.</h2>
      <div id="mockup-scroll-container" class="relative w-full max-w-5xl mx-auto rounded-3xl border border-white/20 shadow-[0_0_100px_rgba(8,120,249,0.2)] overflow-hidden bg-[#0a0a0a]">
        <!-- Topbar -->
        <div class="h-12 border-b border-white/10 flex items-center px-6 gap-4 bg-white/[0.02]">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
            <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
            <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
          </div>
          <div class="h-6 w-64 bg-white/5 rounded-md ml-auto"></div>
        </div>
        <!-- Content -->
        <div class="flex h-[600px]">
          <!-- Sidebar -->
          <div class="w-64 border-r border-white/10 p-6 hidden md:block">
            <div class="h-8 w-8 bg-blue-500 rounded mb-8"></div>
            <div class="flex flex-col gap-4">
              <div class="h-4 w-full bg-blue-500/20 rounded"></div>
              <div class="h-4 w-3/4 bg-white/5 rounded"></div>
              <div class="h-4 w-5/6 bg-white/5 rounded"></div>
              <div class="h-4 w-2/3 bg-white/5 rounded"></div>
            </div>
          </div>
          <!-- Main Area -->
          <div class="flex-1 p-8 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:32px_32px]">
            <div class="flex gap-6 mb-8">
              <div class="h-32 flex-1 bg-white/[0.02] border border-white/10 rounded-2xl p-6">
                <div class="h-4 w-24 bg-white/10 rounded mb-6"></div>
                <div class="h-8 w-32 bg-white/20 rounded"></div>
              </div>
              <div class="h-32 flex-1 bg-white/[0.02] border border-white/10 rounded-2xl p-6">
                <div class="h-4 w-24 bg-white/10 rounded mb-6"></div>
                <div class="h-8 w-32 bg-white/20 rounded"></div>
              </div>
              <div class="h-32 flex-1 bg-blue-500/10 border border-blue-500/30 rounded-2xl p-6">
                <div class="h-4 w-24 bg-blue-400/50 rounded mb-6"></div>
                <div class="h-8 w-32 bg-blue-400 rounded"></div>
              </div>
            </div>

            <!-- Kanban -->
            <div class="flex gap-6 h-[400px]">
              <div class="flex-1 bg-white/[0.02] border border-white/10 rounded-2xl p-4 flex flex-col gap-4">
                <div class="h-24 bg-white/5 rounded-xl border border-white/10"></div>
                <div class="h-32 bg-white/5 rounded-xl border border-white/10"></div>
              </div>
              <div class="flex-1 bg-white/[0.02] border border-white/10 rounded-2xl p-4 flex flex-col gap-4">
                <div class="h-40 bg-blue-500/10 border border-blue-500/20 rounded-xl relative overflow-hidden">
                  <div class="absolute inset-0 bg-blue-400/10 animate-pulse"></div>
                  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-[10px] text-blue-400 uppercase tracking-widest font-bold">En Progreso</div>
                </div>
              </div>
              <div class="flex-1 bg-white/[0.02] border border-white/10 rounded-2xl p-4 flex flex-col gap-4">
                <div class="h-24 bg-green-500/5 border border-green-500/10 rounded-xl flex items-center justify-center">
                  <span class="text-[10px] text-green-500 uppercase tracking-widest font-bold">Completado</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- CTA -->
  <Cta />

</BaseLayout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Animación de entrada Hero
  const tl = gsap.timeline();
  tl.fromTo('.hero-title', { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 1, ease: 'power4.out', delay: 0.2 })
    .fromTo('.hero-subtitle', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 1, ease: 'power3.out' }, "-=0.8")
    .fromTo('.hero-btn', { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.8 }, "-=0.8");

  // Animación 3D del mockup flotante
  gsap.to('.mockup-float', {
    rotateY: -5,
    rotateX: 5,
    duration: 3,
    yoyo: true,
    repeat: -1,
    ease: 'sine.inOut'
  });

  // Animación de Scale del mockup principal al hacer scroll
  const mockupContainer = document.getElementById('mockup-scroll-container');
  if (mockupContainer) {
    gsap.fromTo(mockupContainer, 
      { scale: 0.85, opacity: 0.5, rotateX: 10 }, 
      {
        scale: 1,
        opacity: 1,
        rotateX: 0,
        ease: 'power2.out',
        scrollTrigger: {
          trigger: mockupContainer,
          start: 'top 90%',
          end: 'top 30%',
          scrub: true
        }
      }
    );
  }
</script>
