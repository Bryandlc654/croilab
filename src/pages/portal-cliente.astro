---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Cta from '../components/ui/Cta.astro';
---

<BaseLayout
  title="Portal de Cliente | Croilab"
  description="Transparencia radical. Visualiza el progreso de tus proyectos, aprueba diseños y revisa métricas en tiempo real en nuestra plataforma propietaria."
>
  <!-- HERO SECTION -->
  <section class="relative overflow-hidden bg-[#050505] pt-32 lg:pt-40 pb-32 border-t border-white/10">
    <div class="absolute top-0 right-1/4 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-1/4 w-[500px] h-[500px] bg-purple-600/10 rounded-full blur-[100px] pointer-events-none"></div>
    
    <div class="grid-bg absolute inset-0 opacity-10 pointer-events-none"></div>

    <Container class="relative z-10">
      <Breadcrumb items={[{ label: 'Tecnología' }, { label: 'Portal de Cliente' }]} class="mb-10" />
      
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Text Content -->
        <div class="text-left">
          <h1 class="hero-title text-[clamp(3.5rem,6vw,5.5rem)] font-bold leading-[1] tracking-tight text-white mb-6">
            Transparencia <br />
            <span class="italic font-serif font-normal text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400">radical.</span>
          </h1>
          
          <p class="hero-subtitle text-[17px] leading-relaxed text-white/60 mb-10 max-w-md">
            Olvídate de perseguir a tu agencia preguntando "cómo va todo". Te damos acceso directo a nuestro ecosistema operativo. Tareas, métricas y reportes en tiempo real, todo centralizado en un solo lugar.
          </p>

          <div class="hero-btn">
            <a href="/contacto" class="group relative flex items-center gap-4 rounded-full bg-white px-8 py-4 text-[14px] font-bold text-black transition-all hover:scale-105 inline-flex magnetic">
              Quiero trabajar así
              <span class="flex h-7 w-7 items-center justify-center rounded-full bg-black/10 transition-transform group-hover:rotate-45">↗</span>
            </a>
          </div>
        </div>

        <!-- Hero Mockup (Premium UI) -->
        <div class="relative perspective-1000">
          <div class="mockup-float relative w-full aspect-[4/3] rounded-2xl bg-[#0f0f11]/90 border border-white/10 backdrop-blur-xl p-5 shadow-[0_30px_60px_rgba(0,0,0,0.8)] flex flex-col overflow-hidden">
            
            <!-- Browser Chrome -->
            <div class="flex items-center gap-2 mb-5 border-b border-white/5 pb-4">
              <div class="flex gap-1.5">
                <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
                <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
                <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
              </div>
              <div class="mx-auto text-[10px] text-white/40 font-mono bg-white/5 px-3 py-1 rounded-md flex items-center gap-2">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                app.croilab.com/client
              </div>
            </div>

            <!-- UI Body -->
            <div class="flex flex-1 gap-5">
              <!-- Sidebar -->
              <div class="w-1/4 flex flex-col gap-4 border-r border-white/5 pr-4">
                <div class="flex items-center gap-3 bg-white/5 p-2 rounded-lg border border-white/5">
                  <div class="w-8 h-8 rounded bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center text-[10px] font-bold text-white">CX</div>
                  <div class="flex-1">
                    <div class="text-[10px] text-white font-bold">Acme Corp.</div>
                    <div class="text-[9px] text-white/40">Plan Growth</div>
                  </div>
                </div>
                
                <div class="flex flex-col gap-1 mt-4">
                  <div class="text-[9px] uppercase tracking-widest text-white/30 font-bold mb-2 px-2">Dashboard</div>
                  <div class="bg-blue-500/10 text-blue-400 text-[11px] font-medium p-2 rounded flex items-center gap-2">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                    Métricas
                  </div>
                  <div class="text-white/50 hover:text-white/80 transition text-[11px] font-medium p-2 rounded flex items-center gap-2">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
                    Kanban Board
                  </div>
                  <div class="text-white/50 hover:text-white/80 transition text-[11px] font-medium p-2 rounded flex items-center gap-2">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                    Facturación
                  </div>
                </div>
              </div>
              
              <!-- Main Content -->
              <div class="flex-1 flex flex-col gap-4">
                <div class="flex items-center justify-between">
                  <h3 class="text-white text-sm font-bold">Rendimiento Mensual</h3>
                  <div class="text-[10px] text-white/40 bg-white/5 px-2 py-1 rounded border border-white/5">Últimos 30 días</div>
                </div>
                
                <div class="grid grid-cols-2 gap-3 h-20">
                  <div class="bg-gradient-to-br from-blue-500/20 to-blue-900/20 border border-blue-500/20 rounded-xl p-3 flex flex-col justify-between">
                    <div class="flex justify-between items-center">
                      <div class="text-[10px] text-blue-200/60 font-medium">ROAS Global</div>
                      <span class="text-[8px] text-green-400 bg-green-400/10 px-1.5 py-0.5 rounded font-bold">+12%</span>
                    </div>
                    <div class="text-2xl font-bold text-white">4.8x</div>
                  </div>
                  <div class="bg-white/5 border border-white/5 rounded-xl p-3 flex flex-col justify-between">
                    <div class="flex justify-between items-center">
                      <div class="text-[10px] text-white/50 font-medium">Ingresos Extra</div>
                    </div>
                    <div class="text-2xl font-bold text-white">+$12.4K</div>
                  </div>
                </div>

                <!-- Chart Skeleton / Mock -->
                <div class="flex-1 bg-white/5 border border-white/5 rounded-xl p-4 flex flex-col relative overflow-hidden">
                  <div class="text-[10px] text-white/50 mb-3">Tasa de Conversión (%)</div>
                  <div class="flex-1 flex items-end justify-between gap-1 mt-auto">
                    <!-- Barras del chart -->
                    <div class="w-full bg-blue-500/20 rounded-t-sm h-[30%] hover:bg-blue-500/40 transition"></div>
                    <div class="w-full bg-blue-500/20 rounded-t-sm h-[45%] hover:bg-blue-500/40 transition"></div>
                    <div class="w-full bg-blue-500/20 rounded-t-sm h-[35%] hover:bg-blue-500/40 transition"></div>
                    <div class="w-full bg-blue-500/20 rounded-t-sm h-[60%] hover:bg-blue-500/40 transition"></div>
                    <div class="w-full bg-blue-500/20 rounded-t-sm h-[85%] hover:bg-blue-500/40 transition bg-gradient-to-t from-blue-500/40 to-blue-400"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="absolute -right-6 top-10 bg-white/10 backdrop-blur-xl border border-white/20 rounded-xl p-3 text-white shadow-2xl animate-float" style="animation-delay: 0.5s;">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-green-500/20 flex items-center justify-center text-green-400 border border-green-500/20">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <div class="flex flex-col">
                <span class="text-[12px] font-bold">Diseño Aprobado</span>
                <span class="text-[9px] text-white/50">Por cliente hace 2 min</span>
              </div>
            </div>
          </div>
          
          <div class="absolute -left-6 bottom-16 bg-white/10 backdrop-blur-xl border border-white/20 rounded-xl p-3 text-white shadow-2xl animate-float" style="animation-delay: 1.5s;">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center text-blue-400 border border-blue-500/20">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
              </div>
              <div class="flex flex-col">
                <span class="text-[12px] font-bold">Sprint Finalizado</span>
                <span class="text-[9px] text-white/50">+15% de velocidad en carga</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- SECCIÓN: CÓMO FUNCIONA -->
  <section class="bg-[#f8f9fa] py-24 border-t border-black/5">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-20">
        <span class="text-[11px] font-bold uppercase tracking-[.25em] text-blue-600 mb-6 block">Metodología Transparente</span>
        <h2 class="text-3xl lg:text-4xl font-bold tracking-tight text-black leading-[1.1] mb-6">
          ¿Cómo interactúas con tu equipo?
        </h2>
        <p class="text-[16px] text-black/60">
          Reemplazamos las aburridas llamadas de estado y las cadenas de correos por un flujo de trabajo asíncrono y altamente eficiente.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <!-- Paso 1 -->
        <div class="bg-white p-8 rounded-3xl border border-black/5 shadow-sm text-center relative hover:-translate-y-2 transition-transform duration-300">
          <div class="w-12 h-12 bg-black text-white rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-6">1</div>
          <h3 class="text-lg font-bold mb-3">Revisas el Backlog</h3>
          <p class="text-[14px] text-black/60 leading-relaxed">Entras a tu portal y ves la lista exacta de tareas, experimentos y diseños que estamos preparando para el mes.</p>
        </div>
        
        <!-- Paso 2 -->
        <div class="bg-white p-8 rounded-3xl border border-black/5 shadow-sm text-center relative hover:-translate-y-2 transition-transform duration-300">
          <div class="hidden md:block absolute top-14 -left-4 w-8 border-t-2 border-dashed border-black/20"></div>
          <div class="w-12 h-12 bg-blue-600 text-white rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-6 shadow-lg shadow-blue-500/30">2</div>
          <h3 class="text-lg font-bold mb-3">Apruebas o Comentas</h3>
          <p class="text-[14px] text-black/60 leading-relaxed">Haces clic en un diseño, dejas comentarios visuales directamente sobre la imagen, o le das al botón verde de aprobar.</p>
        </div>

        <!-- Paso 3 -->
        <div class="bg-white p-8 rounded-3xl border border-black/5 shadow-sm text-center relative hover:-translate-y-2 transition-transform duration-300">
          <div class="hidden md:block absolute top-14 -left-4 w-8 border-t-2 border-dashed border-black/20"></div>
          <div class="w-12 h-12 bg-green-500 text-white rounded-full flex items-center justify-center text-lg font-bold mx-auto mb-6 shadow-lg shadow-green-500/30">3</div>
          <h3 class="text-lg font-bold mb-3">Mides el Impacto</h3>
          <p class="text-[14px] text-black/60 leading-relaxed">Una vez implementado, vas a la pestaña de Métricas para ver el impacto en conversiones y ventas en tiempo real.</p>
        </div>
      </div>
      
      <!-- Intermediate CTA -->
      <div class="mt-20 text-center">
        <a href="/contacto" class="group relative inline-flex items-center gap-4 rounded-full bg-black px-8 py-4 text-[14px] font-bold text-white transition-all hover:scale-105 shadow-xl magnetic">
          Cotizar mi proyecto
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-white/20 transition-transform group-hover:rotate-45">↗</span>
        </a>
      </div>
    </Container>
  </section>

  <!-- FEATURES (GRID EDITORIAL) -->
  <section class="bg-white py-32 overflow-hidden border-t border-black/5">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-20">
        <h2 class="text-[clamp(2rem,4vw,3.5rem)] font-bold tracking-tight text-black leading-[1.1] mb-6">
          Un ecosistema operativo <br/>diseñado para crecer.
        </h2>
        <p class="text-[17px] text-black/50">
          No enviamos reportes en PDF a final de mes. Te conectamos directamente al motor de nuestra agencia.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
        <!-- Feature 1 -->
        <div class="group bg-[#f8f9fa] rounded-[2.5rem] p-10 lg:p-14 border border-black/5 transition-all hover:bg-black hover:text-white hover:shadow-2xl hover:-translate-y-2">
          <div class="w-12 h-12 rounded-xl bg-white border border-black/10 flex items-center justify-center text-black mb-8 group-hover:bg-white/10 group-hover:border-white/20 group-hover:text-white transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Métricas unificadas</h3>
          <p class="text-[15px] leading-relaxed opacity-70">Integramos las APIs de Google Analytics, Meta Ads, Shopify y Stripe. Todo el funnel en un solo panel de control actualizado al segundo.</p>
        </div>

        <!-- Feature 2 -->
        <div class="group bg-[#f8f9fa] rounded-[2.5rem] p-10 lg:p-14 border border-black/5 transition-all hover:bg-black hover:text-white hover:shadow-2xl hover:-translate-y-2">
          <div class="w-12 h-12 rounded-xl bg-white border border-black/10 flex items-center justify-center text-black mb-8 group-hover:bg-white/10 group-hover:border-white/20 group-hover:text-white transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Aprobación visual</h3>
          <p class="text-[15px] leading-relaxed opacity-70">Revisa wireframes, copies de anuncios y diseños directamente en la plataforma. Deja comentarios precisos haciendo clic sobre los elementos.</p>
        </div>

        <!-- Feature 3 -->
        <div class="group bg-[#f8f9fa] rounded-[2.5rem] p-10 lg:p-14 border border-black/5 transition-all hover:bg-black hover:text-white hover:shadow-2xl hover:-translate-y-2">
          <div class="w-12 h-12 rounded-xl bg-white border border-black/10 flex items-center justify-center text-black mb-8 group-hover:bg-white/10 group-hover:border-white/20 group-hover:text-white transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Sprint Board (Kanban)</h3>
          <p class="text-[15px] leading-relaxed opacity-70">Mira en tiempo real en qué tarea exacta está trabajando nuestro equipo. Desde la fase de auditoría hasta el código en producción.</p>
        </div>

        <!-- Feature 4 -->
        <div class="group bg-[#f8f9fa] rounded-[2.5rem] p-10 lg:p-14 border border-black/5 transition-all hover:bg-black hover:text-white hover:shadow-2xl hover:-translate-y-2">
          <div class="w-12 h-12 rounded-xl bg-white border border-black/10 flex items-center justify-center text-black mb-8 group-hover:bg-white/10 group-hover:border-white/20 group-hover:text-white transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
          </div>
          <h3 class="text-2xl font-bold mb-4">Finanzas y Facturación</h3>
          <p class="text-[15px] leading-relaxed opacity-70">Historial completo de pagos, facturas fiscales descargables y estado de suscripciones. Cero sorpresas a fin de mes.</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- MOCKUP GIGANTE CON SCROLL (GSAP) -->
  <section class="bg-[#050505] py-32 overflow-hidden border-t border-white/5 relative">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:32px_32px]"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-600/10 rounded-full blur-[120px] pointer-events-none"></div>

    <Container class="text-center relative z-10">
      <h2 class="text-white text-[clamp(2rem,3vw,3rem)] font-bold mb-4 tracking-tight">El centro de mando de tu negocio.</h2>
      <p class="text-white/50 text-lg mb-16 max-w-2xl mx-auto">Una plataforma desarrollada in-house específicamente para escalar tiendas online y ecosistemas de conversión.</p>
      
      <div id="mockup-scroll-container" class="relative w-full max-w-[1100px] mx-auto rounded-3xl border border-white/10 shadow-[0_0_100px_rgba(8,120,249,0.15)] overflow-hidden bg-[#0c0c0e]">
        <!-- Topbar -->
        <div class="h-14 border-b border-white/5 flex items-center justify-between px-6 bg-white/[0.02]">
          <div class="flex items-center gap-4">
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
              <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
              <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
            </div>
            <div class="h-5 w-px bg-white/10 mx-2"></div>
            <div class="flex items-center gap-2 text-white/50 text-[11px] font-mono bg-white/5 px-2 py-1 rounded border border-white/5">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              Buscar proyectos, tareas, facturas... (Ctrl+K)
            </div>
          </div>
          
          <div class="flex items-center gap-4">
            <div class="flex -space-x-2">
              <img class="w-7 h-7 rounded-full border-2 border-[#0c0c0e] object-cover" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=100&auto=format&fit=crop" alt="User">
              <img class="w-7 h-7 rounded-full border-2 border-[#0c0c0e] object-cover" src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=100&auto=format&fit=crop" alt="User">
              <div class="w-7 h-7 rounded-full border-2 border-[#0c0c0e] bg-blue-500 flex items-center justify-center text-[8px] font-bold text-white">+2</div>
            </div>
            <div class="w-8 h-8 rounded-full bg-white/10 flex items-center justify-center border border-white/10">
              <span class="text-white text-[12px] font-bold">JD</span>
            </div>
          </div>
        </div>

        <!-- Content -->
        <div class="flex h-[700px]">
          <!-- Sidebar -->
          <div class="w-64 border-r border-white/5 p-6 hidden md:flex flex-col bg-[#0a0a0c]">
            <!-- User block -->
            <div class="flex items-center gap-3 bg-white/5 p-3 rounded-xl border border-white/5 mb-8 hover:bg-white/10 transition cursor-pointer">
              <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center text-white font-bold shadow-lg">AC</div>
              <div class="flex-1 text-left">
                <div class="text-[12px] text-white font-bold truncate">Acme Store</div>
                <div class="text-[10px] text-green-400 font-medium">Plan Scale Activo</div>
              </div>
              <svg class="w-4 h-4 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </div>

            <div class="flex flex-col gap-2 flex-1">
              <div class="text-[10px] uppercase tracking-widest text-white/30 font-bold mb-2 px-2 text-left">Workspaces</div>
              <div class="bg-blue-500/10 text-blue-400 text-[13px] font-medium p-3 rounded-lg flex items-center gap-3 border border-blue-500/20 shadow-[0_0_15px_rgba(59,130,246,0.1)]">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                Dashboard Growth
              </div>
              <div class="text-white/60 hover:text-white hover:bg-white/5 transition text-[13px] font-medium p-3 rounded-lg flex items-center gap-3 cursor-pointer">
