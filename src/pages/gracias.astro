---
import BaseLayout from '../layouts/BaseLayout.astro';
import WebsMarquee from '../components/WebsMarquee.astro';
import { whatsappLink } from '../data/site';
---

<BaseLayout hideHeaderAndFooter={true} title="¡Listo! · Croilab">
  <!-- Minimal Nav -->
  <div class="fixed top-3 left-1/2 -translate-x-1/2 w-[calc(100%-24px)] max-w-[1140px] z-50">
    <div class="w-full bg-white/80 backdrop-blur-xl border border-black/5 rounded-full px-4 py-2.5 flex items-center justify-center shadow-sm">
      <a href="/" class="flex items-center" aria-label="Croilab">
        <img src="/croilab-logo.svg" alt="Croilab" class="h-6 w-auto" />
      </a>
    </div>
  </div>

  <main class="min-h-screen bg-[#f3f3f1] flex flex-col justify-center items-center text-center px-4 pt-32 pb-20 overflow-hidden relative">
    
    <div class="max-w-3xl mx-auto w-full relative z-10 flex flex-col items-center">
      
      <!-- Progress Bar Mini -->
      <div class="w-full max-w-xl mb-12 opacity-0 animate-fade-up" style="animation-delay: 0.2s; animation-fill-mode: forwards;">
        <div class="inline-flex items-center gap-2 text-[11.5px] uppercase tracking-[0.18em] text-[#128c7e] bg-[#e7faef] border border-[#25d366]/20 px-3.5 py-1.5 rounded-full font-medium mb-5 shadow-sm">
          <span class="w-1.5 h-1.5 rounded-full bg-[#25d366] shadow-[0_0_0_3px_rgba(37,211,102,0.22)] animate-pulse"></span>
          <span>Paso <b class="font-bold">1</b> de <b class="font-bold">4</b> · <b class="font-bold">25%</b> completado</span>
        </div>
        
        <div class="relative w-full">
          <!-- Line -->
          <div class="absolute top-[17px] left-[12.5%] right-[12.5%] h-0.5 bg-black/10 rounded-full z-0 overflow-hidden">
            <div class="absolute top-0 left-0 h-full w-[16%] bg-gradient-to-r from-[#25d366] to-[#128c7e] rounded-full shadow-[0_0_10px_rgba(37,211,102,0.5)]"></div>
          </div>
          
          <!-- Steps -->
          <div class="grid grid-cols-4 gap-2 relative z-10">
            <!-- Step 1: Done -->
            <div class="text-center px-0.5">
              <div class="w-9 h-9 mx-auto rounded-full bg-[#25d366] border-2 border-[#25d366] flex items-center justify-center mb-2.5 shadow-[0_0_0_5px_rgba(37,211,102,0.14)] animate-pulse">
                <svg class="w-4 h-4 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              </div>
              <div class="text-[11.5px] font-medium text-black tracking-tight">Solicitud</div>
            </div>
            <!-- Step 2: Pending -->
            <div class="text-center px-0.5">
              <div class="w-9 h-9 mx-auto rounded-full bg-white border-[1.5px] border-black/15 flex items-center justify-center mb-2.5 text-[13px] font-medium text-black/40">2</div>
              <div class="text-[11.5px] font-normal text-black/50 tracking-tight">Te contactamos</div>
            </div>
            <!-- Step 3: Pending -->
            <div class="text-center px-0.5">
              <div class="w-9 h-9 mx-auto rounded-full bg-white border-[1.5px] border-black/15 flex items-center justify-center mb-2.5 text-[13px] font-medium text-black/40">3</div>
              <div class="text-[11.5px] font-normal text-black/50 tracking-tight">Llamada</div>
            </div>
            <!-- Step 4: Goal -->
            <div class="text-center px-0.5 relative group">
              <div class="absolute inset-0 bg-[#25d366]/40 blur-md rounded-full w-12 h-12 mx-auto -top-1.5 animate-pulse"></div>
              <div class="w-9 h-9 mx-auto rounded-full bg-white border-[1.5px] border-dashed border-[#25d366] flex items-center justify-center mb-2.5 relative z-10 drop-shadow-[0_0_5px_rgba(37,211,102,0.7)]">
                <svg class="w-5 h-5 text-[#1ec96b]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              </div>
              <div class="text-[11.5px] font-medium text-[#128c7e] tracking-tight drop-shadow-[0_0_12px_rgba(37,211,102,0.25)]">Empezamos</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Hero Content -->
      <div class="inline-flex items-center gap-2 px-3.5 py-2 border border-black/10 rounded-full bg-white text-xs font-medium tracking-[0.18em] uppercase text-black mb-6 shadow-sm opacity-0 animate-fade-up" style="animation-delay: 0.9s; animation-fill-mode: forwards;">
        <span class="w-1.5 h-1.5 rounded-full bg-[#25d366] shadow-[0_0_0_3px_rgba(37,211,102,0.25)] animate-pulse"></span>
        Datos recibidos
      </div>

      <h1 class="text-[clamp(38px,7vw,68px)] font-normal text-[#0a0a0a] tracking-tight leading-[1.1] md:leading-tight mb-10 overflow-hidden py-2">
        <span class="inline-block opacity-0 animate-rise" style="animation-delay: 0.95s; animation-fill-mode: forwards;">Gracias,</span>
        <span class="inline-block opacity-0 animate-rise" style="animation-delay: 1.01s; animation-fill-mode: forwards;" id="userName">.</span><br/>
        <span class="inline-block opacity-0 animate-rise font-serif italic text-black/60 tracking-normal" style="animation-delay: 1.12s; animation-fill-mode: forwards;">Hemos</span>
        <span class="inline-block opacity-0 animate-rise font-serif italic text-black/60 tracking-normal" style="animation-delay: 1.18s; animation-fill-mode: forwards;">recibido</span>
        <span class="inline-block opacity-0 animate-rise font-serif italic text-black/60 tracking-normal" style="animation-delay: 1.24s; animation-fill-mode: forwards;">tu</span>
        <span class="relative inline-block px-1">
          <span class="inline-block opacity-0 animate-rise font-serif italic text-black/60 tracking-normal relative z-10" style="animation-delay: 1.30s; animation-fill-mode: forwards;">solicitud.</span>
          <svg class="absolute -bottom-1 -left-2 -right-2 w-[110%] h-3 z-0" viewBox="0 0 220 16" preserveAspectRatio="none">
            <path class="stroke-[#25d366] stroke-[5] fill-none drop-shadow-[0_2px_8px_rgba(37,211,102,0.4)] path-draw" stroke-linecap="round" d="M3,10 Q55,3 110,7 T217,8" style="stroke-dasharray: 100; stroke-dashoffset: 100; animation: drawUnderline 1.4s cubic-bezier(0.16,1,0.3,1) 1.8s forwards;" pathLength="100"></path>
          </svg>
        </span>
      </h1>

      <p class="text-[clamp(17px,1.7vw,19px)] text-[#1a1a1a] max-w-[540px] mx-auto leading-relaxed mb-8 opacity-0 animate-fade-up" style="animation-delay: 1.5s; animation-fill-mode: forwards;">
        Te contactaremos en menos de 24h para agendar tu llamada. Si lo prefieres, puedes <strong class="font-medium text-black">adelantarnos el contacto por WhatsApp</strong> y la agendamos al momento.
      </p>

      <!-- WA Button -->
      <div class="w-full max-w-[520px] mx-auto px-1 opacity-0 animate-fade-up" style="animation-delay: 1.75s; animation-fill-mode: forwards;">
        <a href={whatsappLink()} id="whatsappBtn" class="group relative overflow-hidden w-full inline-flex items-center justify-center gap-3 bg-[#25d366] text-white py-5 md:py-6 px-8 rounded-full text-[17px] font-medium tracking-tight shadow-[0_14px_30px_-8px_rgba(37,211,102,0.5)] transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_20px_40px_-8px_rgba(37,211,102,0.65)] hover:-translate-y-1 z-10">
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/30 to-transparent -translate-x-full group-hover:animate-[waShimmer_1.5s_ease-in-out_infinite] pointer-events-none z-0"></div>
          <svg class="w-6 h-6 shrink-0 relative z-10" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          <span class="relative z-10">Hablar por WhatsApp ahora</span>
          <span class="relative z-10 transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>

        <div class="mt-4 text-[13.5px] text-black/50 flex items-center justify-center gap-4 flex-wrap">
          <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#25d366]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Nos adaptamos a ti</span>
          <span class="flex items-center gap-1.5"><svg class="w-3.5 h-3.5 text-[#25d366]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg> Sin compromiso</span>
        </div>

        <div class="mt-6 flex justify-center gap-2.5 flex-wrap">
          <div class="inline-flex items-center gap-2 text-[13px] text-[#1a1a1a] bg-white border border-black/10 px-3.5 py-2 rounded-full shadow-sm animate-[float_3.6s_ease-in-out_infinite]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#25d366] shadow-[0_0_0_3px_rgba(37,211,102,0.22)] animate-pulse"></span>
            Eres el <b class="font-bold">#4</b> en cola
          </div>
          <div class="inline-flex items-center gap-2 text-[13px] text-[#1a1a1a] bg-white border border-black/10 px-3.5 py-2 rounded-full shadow-sm animate-[float_3.6s_ease-in-out_infinite]" style="animation-delay: 1.8s;">
            <svg class="w-3.5 h-3.5 text-[#25d366]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <b class="font-bold">1 cliente</b> cerró su web esta semana
          </div>
        </div>
      </div>
      
    </div>
  </main>

  <div class="bg-white border-t border-black/5 pt-16 pb-20">
    <div class="text-center text-[12px] tracking-[0.18em] uppercase text-black/40 font-semibold flex items-center justify-center gap-3 mb-10 px-4">
      <span class="h-px bg-black/10 w-8 md:w-16"></span>
      Algunas de nuestras webs
      <span class="h-px bg-black/10 w-8 md:w-16"></span>
    </div>
    <!-- Re-use the existing marquee component -->
    <WebsMarquee />
  </div>

</BaseLayout>

<style>
  @keyframes fade-up {
    0% { opacity: 0; transform: translateY(14px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-up {
    animation: fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes rise {
    0% { transform: translateY(110%); opacity: 0; }
    1% { opacity: 1; }
    100% { transform: translateY(0); opacity: 1; }
  }
  .animate-rise {
    animation: rise 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes drawUnderline {
    to { stroke-dashoffset: 0; }
  }

  @keyframes waShimmer {
    0% { transform: translateX(-100%); }
    55% { transform: translateX(100%); }
    100% { transform: translateX(100%); }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Ocultar los modales de elementor si es que cargan
    document.querySelectorAll('[data-elementor-type="popup"], .dialog-widget, .dialog-lightbox-message, .elementor-popup-modal').forEach(el => el.remove());
    document.body.classList.remove('dialog-prevent-scroll');

    // 2. Lógica de URL params
    const params = new URLSearchParams(window.location.search);
    const nombre = (params.get('nombre') || '').trim();
    const web = (params.get('web') || '').trim();
    const sector = (params.get('sector') || '').trim();

    const nameEl = document.getElementById('userName');
    if (nombre && nameEl) {
      const firstName = nombre.split(' ')[0];
      const safeName = firstName.charAt(0).toUpperCase() + firstName.slice(1).toLowerCase();
      nameEl.textContent = safeName + '.';
    } else if (nameEl) {
      const prevEl = nameEl.previousElementSibling as HTMLElement;
      if (prevEl) prevEl.textContent = 'Gracias.';
      nameEl.style.display = 'none';
    }

    // 3. WA Button
    const WHATSAPP_NUMBER = '34640188024';
    let mensaje = '¡Hola! Soy ' + (nombre || '[tu nombre]') + '. ';
    mensaje += 'Acabo de dejar mis datos en la web para el diagnóstico gratuito';
    if (web) mensaje += ' (mi web: ' + web + ')';
    if (sector) mensaje += '. Mi sector: ' + sector;
    mensaje += '. ¿Cuándo agendamos la llamada de 20 min?';

    const waUrl = 'https://wa.me/' + WHATSAPP_NUMBER + '?text=' + encodeURIComponent(mensaje);
    const btn = document.getElementById('whatsappBtn');
    if (btn) btn.setAttribute('href', waUrl);
  });
</script>

