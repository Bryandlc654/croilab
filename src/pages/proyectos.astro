---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import Container from '../components/ui/Container.astro';
import ServiceStats from '../components/ServiceStats.astro';
import { whatsappLink } from '../data/site';

const waLink = whatsappLink();

// Fetch projects from WordPress API
const wpEndpoint = 'https://darkblue-flamingo-706734.hostingersite.com/wp-json/wp/v2/proyecto';
let wpProjects = [];

try {
  const res = await fetch(wpEndpoint);
  wpProjects = await res.json();
} catch (e) {
  console.error("Error fetching projects from WP:", e);
}

// Format the projects
const projects = wpProjects.map(wpProj => {
  let rawText = wpProj.content?.rendered || "";
  let cleanDesc = rawText.replace(/(<([^>]+)>)/gi, "").trim();
  if (cleanDesc.length > 150) {
    cleanDesc = cleanDesc.slice(0, 150) + "...";
  }

  return {
    title: wpProj.title?.rendered || "Proyecto",
    description: cleanDesc,
    category: "Proyecto",
    image: wpProj.imagen_url || "https://images.unsplash.com/photo-1460925895917-afdab827c52f?q=80&w=2426&auto=format&fit=crop",
    link: `/proyectos/${wpProj.slug}`
  };
});

// Obtener SEO desde la página "proyectos" en WordPress
const seoEndpoint = 'https://darkblue-flamingo-706734.hostingersite.com/wp-json/wp/v2/pages?slug=proyectos';
let rankMathSEO = null;

try {
  const seoRes = await fetch(seoEndpoint);
  if (seoRes.ok) {
    const pages = await seoRes.json();
    if (pages && pages.length > 0) {
      rankMathSEO = pages[0].rank_math_head || null;
    }
  }
} catch (e) {
  console.error("Error fetching proyectos page SEO:", e);
}
---

<BaseLayout
  title="Proyectos | Croilab — Trabajos que convierten"
  description="Explora nuestros casos de éxito. Experiencias digitales diseñadas para captar, retener y convertir."
  rankMathSEO={rankMathSEO}
>
  <section class="relative min-h-[90vh] flex flex-col justify-end overflow-hidden border-t border-white/5 bg-[#050505] pb-12 pt-32 lg:pb-24">
    
    <!-- Imagen de fondo con textura y degradado -->
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img 
        src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=2564&auto=format&fit=crop" 
        alt="Abstract" 
        class="w-full h-full object-cover opacity-40 grayscale mix-blend-luminosity"
      />
      <!-- Degradado agresivo hacia el negro puro, oscureciendo más abajo -->
      <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-[#050505]/80 to-[#050505]/20"></div>
      
      <!-- Ruido (Grain) para textura premium -->
      <div class="absolute inset-0 opacity-[0.25] mix-blend-overlay" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E');"></div>
    </div>

    <!-- Efectos de iluminación vibrantes -->
    <div class="absolute top-1/4 left-0 w-[500px] h-[500px] bg-blue-600/30 rounded-full blur-[150px] pointer-events-none z-0"></div>
    <div class="absolute bottom-0 right-0 w-[600px] h-[600px] bg-cyan-600/20 rounded-full blur-[150px] pointer-events-none z-0"></div>

    <Container class="relative z-10 w-full">
      <div class="mb-10 lg:mb-16">
        <Breadcrumb items={[{ label: 'Proyectos' }]} />
      </div>
      
      <div class="w-full">
        <h1 class="gsap-title text-[clamp(4rem,10vw,11rem)] font-bold leading-[0.85] tracking-tighter text-white mb-10" data-custom-speed="0.8">
          Trabajos que <br />
          <span class="italic font-serif font-light text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">convierten.</span>
        </h1>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end">
          <p class="text-[17px] leading-relaxed text-white/50 md:text-[20px] max-w-lg">
            No diseñamos por simple estética, construimos sistemas por resultados. Explora los ecosistemas digitales que hemos diseñado para escalar negocios a su máximo potencial.
          </p>
          
          <div class="flex flex-col sm:flex-row items-center justify-start lg:justify-end gap-5 w-full">
            <a href="#proyectos-list" class="magnetic group relative flex items-center justify-center gap-4 rounded-full bg-white px-10 py-5 text-[14px] font-bold text-black transition-all duration-500 hover:scale-105 hover:shadow-[0_20px_40px_rgba(255,255,255,0.15)] w-full sm:w-auto">
              Ver proyectos
              <span class="inline-block transition-transform duration-300 group-hover:translate-y-1">↓</span>
            </a>
            <a href="/contacto" class="magnetic group flex items-center justify-center gap-4 rounded-full border border-white/20 bg-white/5 backdrop-blur-sm px-10 py-5 text-[14px] font-bold text-white transition-all duration-300 hover:bg-white/10 hover:border-white/40 w-full sm:w-auto">
              Cotizar proyecto
            </a>
          </div>
        </div>
      </div>
    </Container>

    <!-- Indicador de scroll -->
    <a href="#proyectos-list" class="absolute bottom-6 left-1/2 z-20 -translate-x-1/2 flex-col items-center gap-2 group hidden sm:flex">
      <span class="text-[10px] font-medium uppercase tracking-[.3em] text-white/40 transition group-hover:text-white/80">Scroll</span>
      <span class="relative flex h-9 w-5 items-start justify-center rounded-full border border-white/20 p-1.5">
        <span class="proj-scroll-dot h-2 w-1 rounded-full bg-white"></span>
      </span>
    </a>
  </section>

  <!-- ESTADÍSTICAS GLOBALES -->
  <ServiceStats />

  <!-- LISTADO DE PROYECTOS (LIGHT MODE) -->
  <section id="proyectos-list" class="relative bg-white pb-32 lg:pb-48 pt-10">
    <Container>
      <div class="flex flex-col gap-32 lg:gap-48 mt-10">
        {projects.length > 0 ? (
          projects.map((project, i) => {
            const isEven = i % 2 === 0;
            return (
              <article class={`project-card group relative flex flex-col ${isEven ? 'lg:flex-row' : 'lg:flex-row-reverse'} items-center gap-10 lg:gap-0`}>
                
                <!-- BLOQUE DE IMAGEN -->
                <div class="project-img-block w-full lg:w-7/12 relative z-10" data-spotlight>
                  <div class="spotlight-glow"></div>
                  <a href={project.link} class="project-img-link block relative w-full aspect-[4/3] overflow-hidden rounded-[2.5rem] bg-[#f8f9fa] border border-black/5 shadow-[0_20px_50px_rgba(0,0,0,0.05)]">
                    <div class="absolute inset-0 bg-white/10 z-10 transition-opacity duration-500 group-hover:opacity-0 pointer-events-none"></div>
                    <img
                      src={project.image}
                      alt={project.title}
                      loading="lazy"
                      class="project-img h-full w-full object-cover transition-transform duration-[3s] ease-out group-hover:scale-110"
                    />
                    <!-- Etiqueta Flotante -->
                    <div class="absolute top-6 left-6 z-20">
                      <span class="inline-flex items-center rounded-full bg-white/90 backdrop-blur-md px-4 py-2 text-[10px] font-bold uppercase tracking-widest text-black shadow-lg">
                        {project.category}
                      </span>
                    </div>
                    <!-- Overlay de hover con flecha -->
                    <div class="absolute inset-0 z-20 flex items-center justify-center bg-black/0 transition-all duration-500 group-hover:bg-black/30 opacity-0 group-hover:opacity-100">
                      <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white text-black shadow-2xl transition-transform duration-500 scale-75 group-hover:scale-100">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                      </span>
                    </div>
                  </a>
                </div>

                <!-- BLOQUE DE TEXTO (Superpuesto) -->
                <div class={`project-text-block w-full lg:w-6/12 relative z-20 ${isEven ? 'lg:-ml-20' : 'lg:-mr-20'}`}>
                  <div class="bg-white/95 backdrop-blur-xl rounded-[2.5rem] border border-black/10 p-8 sm:p-12 lg:p-16 shadow-[0_30px_60px_rgba(0,0,0,0.08)] transition-colors duration-500 group-hover:border-black/20">
                    <div class="flex items-center gap-4 mb-6">
                      <span class="h-px w-8 bg-black/20"></span>
                      <span class="text-[10px] font-bold uppercase tracking-[.2em] text-black/40">
                        Caso de Éxito <span class="case-counter inline-block tabular-nums">0{i + 1}</span>
                      </span>
                    </div>

                    <h3 class="text-[clamp(2rem,3vw,3.5rem)] font-bold tracking-tight text-black mb-6 leading-[1.1]">
                      {project.title}
                    </h3>
                    
                    <p class="text-[16px] leading-[1.8] text-black/60 mb-10">
                      {project.description}
                    </p>

                    <div class="border-t border-black/10 pt-8">
                      <a
                        href={project.link}
                        class="magnetic inline-flex items-center gap-4 rounded-full bg-black px-8 py-4 text-[13px] font-bold text-white transition-transform duration-300 hover:scale-105 shadow-[0_10px_20px_rgba(0,0,0,0.1)]"
                      >
                        Ver el resultado en vivo
                        <span class="flex h-7 w-7 items-center justify-center rounded-full bg-white/15 transition-all duration-300 group-hover:bg-white group-hover:text-black group-hover:rotate-45">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
                        </span>
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            );
          })
        ) : (
          <div class="py-20 text-center">
            <div class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-black/5 mb-6">
              <span class="text-2xl text-black/30">?</span>
            </div>
            <h3 class="text-2xl font-semibold text-black mb-2">Aún no hay proyectos</h3>
            <p class="text-black/50">Pronto subiremos nuestros casos de éxito.</p>
          </div>
        )}
      </div>
    </Container>
  </section>

  <!-- CTA FINAL (Específico para Proyectos) -->
  <section class="relative bg-white py-24 lg:py-40 overflow-hidden border-t border-black/5 z-20">
    <Container class="relative z-10">
      
      <div class="relative w-full rounded-[3rem] bg-[#f8f9fa] border border-black/5 p-10 py-16 lg:p-24 overflow-hidden text-center flex flex-col items-center shadow-[0_20px_60px_rgba(0,0,0,0.03)]">
        <!-- Luces internas -->
        <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-blue-500/10 rounded-full blur-[100px] translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-cyan-500/10 rounded-full blur-[100px] -translate-x-1/3 translate-y-1/3 pointer-events-none"></div>
        <div class="grid-bg absolute inset-0 opacity-[0.03] pointer-events-none invert"></div>

        <h2 class="relative z-10 text-[clamp(3rem,6vw,6rem)] font-bold leading-[0.95] tracking-tight mb-8 text-[#090909]">
          ¿Tienes un proyecto <br />
          <span class="italic font-serif font-light text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-cyan-500">en mente?</span>
        </h2>
        
        <p class="relative z-10 text-black/50 text-[16px] md:text-[18px] mb-12 max-w-2xl mx-auto leading-relaxed">
          Cuéntanos dónde estás hoy y hacia dónde quieres llegar. Analizaremos tu ecosistema digital y diseñaremos una estructura probada para multiplicar tus conversiones.
        </p>
        
        <div class="relative z-10 flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
          <a href="/contacto" class="magnetic group relative flex items-center justify-center gap-4 rounded-full bg-black px-10 py-5 text-[14px] font-bold text-white transition-all duration-500 hover:scale-105 hover:shadow-[0_20px_50px_rgba(0,0,0,0.2)] w-full sm:w-auto overflow-hidden">
            <div class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/20 to-transparent group-hover:animate-[shine_1.5s_ease-in-out]"></div>
            Cotizar mi proyecto
            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20 transition-transform duration-300 group-hover:rotate-45">↗</span>
          </a>
          <a href={waLink} target="_blank" rel="noopener noreferrer" class="magnetic group flex items-center justify-center gap-4 rounded-full border border-black/10 bg-white px-10 py-5 text-[14px] font-bold text-black transition-all duration-300 hover:bg-black/5 hover:border-black/20 w-full sm:w-auto">
            WhatsApp directo
          </a>
        </div>
      </div>
      
    </Container>
  </section>

</BaseLayout>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }
  @keyframes shine {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
</style>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Hero Title Parallax
  const titles = gsap.utils.toArray<HTMLElement>('.gsap-title');
  titles.forEach((title) => {
    const speed = parseFloat(title.getAttribute('data-custom-speed') || '1');
    const yOffset = (1 - speed) * 200;

    gsap.fromTo(title,
      { y: yOffset, opacity: 0.2 },
      {
        y: 0,
        opacity: 1,
        ease: "none",
        scrollTrigger: {
          trigger: title,
          start: "top 95%",
          end: "top 20%",
          scrub: 1,
        }
      }
    );
  });

  // Elementos Reveal Up
  const reveals = gsap.utils.toArray<HTMLElement>('.reveal-up');
  reveals.forEach((el) => {
    gsap.from(el, {
      y: 40,
      opacity: 0,
      duration: 1.2,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: el,
        start: 'top 85%',
      }
    });
  });

  // Project Cards asimétricos
  const projectCards = gsap.utils.toArray<HTMLElement>('.project-card');
  projectCards.forEach((card, i) => {
    const isEven = i % 2 === 0;
    const imageBlock = card.querySelector('.project-img-block');
    const textBlock = card.querySelector('.project-text-block');

    if (imageBlock) {
      gsap.from(imageBlock, {
        x: isEven ? -60 : 60,
        opacity: 0,
        duration: 1.2,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: card,
          start: 'top 80%',
        }
      });
    }

    if (textBlock) {
      gsap.from(textBlock, {
        y: 40,
        opacity: 0,
        duration: 1.2,
        delay: 0.2,
        ease: 'power3.out',
        scrollTrigger: {
          trigger: card,
          start: 'top 80%',
        }
      });
    }

    // Parallax sutil de la imagen dentro del card (scrub) sobre el wrapper
    const imgWrap = card.querySelector('.project-img-link');
    if (imgWrap) {
      gsap.fromTo(imgWrap,
        { y: -24 },
        {
          y: 24,
          ease: 'none',
          scrollTrigger: {
            trigger: card,
            start: 'top bottom',
            end: 'bottom top',
            scrub: true,
          }
        }
      );
    }
  });

  // Contador animado "Caso de Éxito 0X"
  const caseLabels = gsap.utils.toArray<HTMLElement>('.case-counter');
  caseLabels.forEach((el) => {
    const target = parseInt(el.textContent?.replace(/\D/g, '') || '0', 10);
    const obj = { val: 0 };
    el.textContent = '00';
    gsap.to(obj, {
      val: target,
      duration: 1,
      ease: 'power2.out',
      scrollTrigger: { trigger: el, start: 'top 90%', once: true },
      onUpdate: () => {
        el.textContent = String(obj.val).padStart(2, '0');
      },
    });
  });

  // Animación continua del indicador de scroll
  gsap.to('.proj-scroll-dot', {
    y: 10,
    opacity: 0,
    duration: 1.3,
    repeat: -1,
    ease: 'power2.inOut',
  });
</script>
