---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ClientsMarquee from '../components/ClientsMarquee.astro';
import AboutAgency from '../components/AboutAgency.astro';
import PartnerEstrategico from '../components/PartnerEstrategico.astro';
import Services from '../components/Services.astro';
import Differentiators from '../components/Differentiators.astro';
import AgencyComparison from '../components/AgencyComparison.astro';
import ClientPortal from '../components/ClientPortal.astro';
import Projects from '../components/Projects.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/ui/Cta.astro';

// Obtener SEO desde la página "inicio" en WordPress
const wpEndpoint = 'https://darkblue-flamingo-706734.hostingersite.com/wp-json/wp/v2/pages?slug=inicio';
let rankMathSEO = null;

try {
  const res = await fetch(wpEndpoint);
  if (res.ok) {
    const pages = await res.json();
    if (pages && pages.length > 0) {
      rankMathSEO = pages[0].rank_math_head || null;
    }
  }
} catch (e) {
  console.error("Error fetching home page SEO:", e);
}
---

<BaseLayout rankMathSEO={rankMathSEO}>
  <Hero />
  <Projects />
  <ClientsMarquee />
  <AboutAgency />
  <PartnerEstrategico />
  <Services />
  <Differentiators />
  <AgencyComparison />
  <ClientPortal />
  <Testimonials />
  <Faq />
  <Cta />
</BaseLayout>
