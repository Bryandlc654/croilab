# ============================================================
# Croilab — variables de entorno
# Copia este archivo a `.env` y completa los valores.
# ============================================================

# URL base de la REST API de WordPress (sin slash final)
WP_URL=https://wp.croilab.com

# Credenciales de aplicación (opcional).
# Solo necesarias para leer contenido privado (borradores/previews).
# Se generan en wp-admin → Usuarios → Perfil → "Contraseñas de aplicación".
WP_APP_USER=
WP_APP_PASSWORD=
